<opsproc code="00008929.0001001" revdate="2021-05-19T09:49:12"><title><abb>ADR</abb> 3</title><procitem layer="1" lid="N.00008929.0001001.004"><title>Flight preparation/limitations</title><procbody lid="N.00008929.0001001.005"><limit layer="1" lid="N.00008929.0001001.024"><lit-limit lid="N.00008929.0001001.025">For aircraft with the <abb>RNP</abb> <abb>AR</abb> capability, <abb>RNP</abb> <abb>AR</abb> operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00008929.0001001.006"><lit-limit lid="N.00008929.0001001.007">Maximum landing capability is CAT 3 SINGLE.</lit-limit></limit></procbody></procitem><procitem layer="1" lid="N.00008929.0001001.010"><title>During cockpit preparation</title><procbody lid="N.00008929.0001001.011"><action layer="1" lid="N.00008929.0001001.013" memory="false"><cr-action code="00008929.0001001.004"><challenge><tech-label type="pb-sw">ADR 3</tech-label></challenge><response>OFF</response></cr-action><comment code="00008929.0001001.009"><para layer="1" lid="N.00008929.0001001.023">The F/CTL <emph bold="false" italic="false" overline="false" sub="false" sup="false" underline="true">MAINTENANCE</emph> message is displayed on the <tech-label type="s-page">STATUS</tech-label>.</para></comment></action><condition at-any-time="false" code="00008929.0001001.013" direct="false" layer="1" lid="N.00008929.0001001.031" subtitle="false" type="cond"><intro>If the <tech-label type="pb"> ADR 3 </tech-label> <tech-label type="light">OFF</tech-label> does not come ON,
