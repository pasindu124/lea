011"><title>Before Engine Start</title><procbody lid="N.00024450.0018001.012"><action layer="1" lid="N.00024450.0018001.013" memory="false"><cr-action code="00024450.0018001.007"><challenge><tech-label type="sel">X BLEED</tech-label></challenge><response>OPEN</response></cr-action></action><action layer="1" lid="N.00024450.0018001.014" memory="false"><cr-action code="00024450.0018001.008"><challenge><tech-label type="pb-sw">APU BLEED</tech-label></challenge><response>AS RQRD</response></cr-action><comment code="00024450.0018001.009"><note code="00024450.0018001.010" layer="1" lid="N.00024450.0018001.015"><para layer="1" lid="N.00024450.0018001.016">The use of the <abb>APU</abb> bleed air supply system is permitted for Main Engine Start.</para></note></comment></action></procbody></procitem><procitem layer="1" lid="N.00024450.0018001.017"><title>After Engine Start</title><procbody lid="N.00024450.0018001.018"><action layer="1" lid="N.00024450.0018001.019" memory="false"><cr-action code="00024450.0018001.011"><challenge><tech-label type="sel">X BLEED</tech-label></challenge><response>SHUT</response></cr-action></action><action layer="1" lid="N.00024450.0018001.020" memory="false"><cr-action code="00024450.0018001.012"><challenge><tech-label type="pb-sw">APU BLEED</tech-label></challenge><response>Off</response></cr-action></action></procbody></procitem><procitem layer="1" lid="N.00024450.0018001.021"><title>In flight</title><procbody lid="N.00024450.0018001.022"><condition at-any-time="false" code="00024450.0018001.013" direct="false" layer="1" lid="N.00024450.0018001.023" subtitle="false" type="cond"><intro>In the case of failure of the remaining engine bleed air supply
