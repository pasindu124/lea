<opsproc code="00008852.0001001" revdate="2014-08-12T17:36:04"><title>Avionics Compartment Access Door Indication on the <tech-label type="s-page">DOOR/OXY</tech-label></title><procitem layer="1" lid="N.00008852.0001001.005"><title>After engine start</title><procbody lid="N.00008852.0001001.006"><condition at-any-time="false" code="00008852.0001001.002" direct="false" layer="1" lid="N.00008852.0001001.007" subtitle="false" type="cond"><intro>In the case of false door alert:</intro><procbody lid="N.00008852.0001001.008"><action layer="1" lid="N.00008852.0001001.009" memory="false"><cr-action code="00008852.0001001.003"><challenge><tech-label type="pb">EMER CANC</tech-label></challenge><response>Press</response></cr-action><comment code="00008852.0001001.009"><note code="00008852.0001001.011" layer="1" lid="N.00008852.0001001.022"><para layer="1" lid="N.00008852.0001001.023">the limitation <emph bold="false" color="Cyan" italic="false" overline="false" sub="false" sup="false" underline="false">MAX FL : 100/MEA-MORA</emph> remains displayed on
the <tech-label type="s-page">STATUS</tech-label>.</para></note></comment></action></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00008852.0001001.010"><title>Before takeoff</title><procbody lid="N.00008852.0001001.011"><inform layer="1" lid="N.00008852.0001001.024"><cautionproc code="00008852.0001001.012" layer="1" lid="N.00008852.0001001.025"><para layer="1" lid="N.00008852.0001001.019">The <tech-label type="pb">T.O CONFIG</tech-label> must be maintained pressed to check that there is no alert.</para></cautionproc></inform><action-block lid="N.00008852.0001001.012"><action layer="1" lid="N.00008852.0001001.013" memory="false"><cr-action code="00008852.0001001.004"><challenge><tech-label type="pb">T.O CONFIG</tech-label></challenge><response>Press</response></cr-action><comment code="00008852.0001001.005"><para layer="1" lid="N.00008852.0001001.020">In the T.O MEMO, the
"T.O CONFIG NORMAL" line will not replace the "T.O
CONFIG . . TEST" line.</para></comment></action><action layer="1" lid="N.00008852.0001001.015" memory="false"><command code="00008852.0001001.006"><para layer="1" lid="N.00008852.0001001.016">Consider normal configuration
for takeoff provided that no alert was displayed during the T.O CONFIG
TEST.</para></command></action></action-block></procbody></procitem></opsproc>