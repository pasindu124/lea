<opsproc code="00009123.0001001" revdate="2015-05-13T12:51:33"><title>System Pressure Indication on the <tech-label type="s-page">HYD</tech-label></title><procitem layer="1" lid="N.00009123.0001001.004"><title>During cockpit preparation</title><procdesc code="00009123.0001001.025" lid="N.00009123.0001001.047"><note code="00009123.0001001.026" layer="1" lid="N.00009123.0001001.048"><unlist bulltype="NDASH" code="00009123.0001001.027" layer="1" lid="N.00009123.0001001.049"><para layer="1" lid="N.00009123.0001001.050">If the Yellow Electric Pump
is not available:</para><item layer="1"><para layer="1" lid="N.00009123.0001001.052">Pressurize the
Yellow Hydraulic System with:</para><unlist bulltype="BULLET" code="00009123.0001001.028" layer="1" lid="N.00009123.0001001.051"><item layer="1"><para layer="1" lid="N.00009123.0001001.053">A Ground cart,
or with</para></item><item layer="1"><para layer="1" lid="N.00009123.0001001.054">The Yellow Engine
2 Pump with the Engine 2 running.</para></item></unlist></item><item layer="1"><para layer="1" lid="N.00009123.0001001.055">Replace any
action on the <tech-label type="pb-sw">YELLOW ELEC PUMP</tech-label> by a similar action
on the Ground Cart or on the <tech-label type="pb-sw">YELLOW ENG 2 PUMP</tech-label> in the
following procedure.</para></item></unlist></note></procdesc><procbody lid="N.00009123.0001001.005"><ex-conditions lid="N.00009123.0001001.007"><condition at-any-time="false" code="00009123.0001001.003" direct="false" layer="1" lid="N.00009123.0001001.008" subtitle="false" type="cond"><intro>If the blue system pressure indication is inoperative:</intro><procbody lid="N.00009123.0001001.009"><action-block lid="N.00009123.0001001.010"><title>Check of the system label:</title><action layer="1" lid="N.00009123.0001001.011" memory="false"><command code="00009123.0001001.004"><para layer="1" lid="N.00009123.0001001.012">On the <tech-label type="s-page">HYD</tech-label>, check that the <emph bold="false" color="Amber" italic="false" overline="false" sub="false" sup="false" underline="false">BLUE</emph> system label is amber.</para></command></action><action layer="1" lid="N.00009123.0001001.013" memory="false"><cr-action code="00009123.0001001.005"><challenge><tech-label type="pb-sw">BLUE ELEC PUMP</tech-label></challenge><response>AUTO</response></cr-action></action><action layer="1" lid="N.00009123.0001001.014" memory="false"><cr-action code="00009123.0001001.006"><challenge><tech-label type="pb-sw">BLUE PUMP OVRD</tech-label></challenge><response>ON</response></cr-action></action><action layer="1" lid="N.00009123.0001001.015" memory="false"><command code="00009123.0001001.007"><para layer="1" lid="N.00009123.0001001.016">On the <tech-label type="s-page">HYD</tech-label>, check that the BLUE system label is white and that the arrow is
green.</para></command></action><action layer="1" lid="N.00009123.0001001.017" memory="false"><cr-action code="00009123.0001001.008"><challenge><tech-label type="pb-sw">BLUE PUMP OVRD</tech-label></challenge><response>Off</response></cr-action></action></action-block></procbody></condition><condition at-any-time="false" code="00009123.0001001.009" direct="false" layer="1" lid="N.00009123.0001001.018" subtitle="false" type="cond"><intro>If the yellow system pressure indication is inoperative:</intro><procbody lid="N.00009123.0001001.019"><action-block lid="N.00009123.0001001.020"><title>Check of the system label:</title><action layer="1" lid="N.00009123.0001001.023" memory="false"><cr-action code="00009123.0001001.011"><challenge><tech-label type="pb-sw">YELLOW ELEC PUMP</tech-label></challenge><response>Off</response></cr-action></action><action layer="1" lid="N.00009123.0001001.025" memory="false"><command code="00009123.0001001.013"><para layer="1" lid="N.00009123.0001001.026">On the <tech-label type="s-page">HYD</tech-label>, check that the <emph bold="false" color="Amber" italic="false" overline="false" sub="false" sup="false" underline="false">YELLOW</emph> system label is amber.</para></command></action><action layer="1" lid="N.00009123.0001001.027" memory="false"><cr-action code="00009123.0001001.014"><challenge><tech-label type="pb-sw">YELLOW ELEC PUMP</tech-label></challenge><response>ON</response></cr-action></action><action layer="1" lid="N.00009123.0001001.031" memory="false"><command code="00009123.0001001.016"><para layer="1" lid="N.00009123.0001001.032">On the <tech-label type="s-page">HYD</tech-label>, check that the YELLOW system label is white and that the arrow
is green.</para></command></action><action layer="1" lid="N.00009123.0001001.033" memory="false"><cr-action code="00009123.0001001.017"><challenge><tech-label type="pb-sw">YELLOW ELEC PUMP</tech-label></challenge><response>Off</response></cr-action></action></action-block></procbody></condition><condition at-any-time="false" code="00009123.0001001.018" direct="false" layer="1" lid="N.00009123.0001001.034" subtitle="false" type="cond"><intro>If the green system pressure indication is inoperative:</intro><procbody lid="N.00009123.0001001.035"><action-block lid="N.00009123.0001001.036"><title>Check of the system label:</title><action layer="1" lid="N.00009123.0001001.037" memory="false"><command code="00009123.0001001.019"><para layer="1" lid="N.00009123.0001001.038">On the <tech-label type="s-page">HYD</tech-label>, check that the <emph bold="false" color="Amber" italic="false" overline="false" sub="false" sup="false" underline="false">GREEN</emph> system label is amber.</para></command></action><action layer="1" lid="N.00009123.0001001.039" memory="false"><cr-action code="00009123.0001001.020"><challenge><tech-label type="pb-sw">YELLOW ELEC PUMP</tech-label></challenge><response>ON</response></cr-action></action><action layer="1" lid="N.00009123.0001001.040" memory="false"><cr-action code="00009123.0001001.021"><challenge><tech-label type="pb-sw">PTU</tech-label></challenge><response>AUTO</response></cr-action></action><action layer="1" lid="N.00009123.0001001.041" memory="false"><command code="00009123.0001001.022"><para layer="1" lid="N.00009123.0001001.042">On the <tech-label type="s-page">HYD</tech-label>, check that the GREEN system label is white and that the arrow is
green.</para></command></action><action layer="1" lid="N.00009123.0001001.043" memory="false"><cr-action code="00009123.0001001.023"><challenge><tech-label type="pb-sw">YELLOW ELEC PUMP</tech-label></challenge><response>Off</response></cr-action></action></action-block></procbody></condition></ex-conditions></procbody></procitem><procitem layer="1" lid="N.00009123.0001001.159"><title>After Engines Start</title><procbody lid="N.00009123.0001001.164"><inform layer="1" lid="N.00009123.0001001.165"><noteproc code="00009123.0001001.082" layer="1" lid="N.00009123.0001001.167"><para layer="1" lid="N.00009123.0001001.168">The <ecam-data ecamimportance="A" type="alert"><ecamsys>HYD</ecamsys><ecamtitle>PTU FAULT</ecamtitle></ecam-data> ECAM alert may be triggered.</para></noteproc></inform></procbody></procitem></opsproc>