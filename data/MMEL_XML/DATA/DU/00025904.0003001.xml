<dispatchitem code="00025904.0003001" func-code="52-51-08" item-list-nbr="08" revdate="2022-08-17T00:00:00"><title>Cockpit Door Latch Mechanism (Mechanical Latches)</title><ditembody nb-installed="3"><dispcond code="00025904.0003001.008" dispcond-id="D12704" dispcond-label="A" lid="N.00025904.0003001.001"><title>One door latch inoperative in disengaged/unlocked position</title><normal-dispcond nb-required="2" rectification-interval="D"><remark><requirement lid="N.00025904.0003001.002" req-id="R12705"><para code="00025904.0003001.009" layer="1" lid="N.00025904.0003001.003">One may be inoperative in disengaged/unlocked position.</para></requirement><note code="00025904.0003001.010" layer="1" lid="N.00025904.0003001.004"><para layer="1" lid="N.00025904.0003001.005">If the center cockpit door latch
mechanism is inoperative in disengaged/unlocked position, the cockpit
door <tech-label type="light">OPEN</tech-label> is considered inoperative.</para><para layer="1" lid="N.00025904.0003001.017"><duref product="MMEL" ref="00008770"/></para></note></remark></normal-dispcond></dispcond><dispcond code="00025904.0003001.011" dispcond-id="D12706" dispcond-label="B" lid="N.00025904.0003001.006"><title>Two or more door latches inoperative in disengaged/unlocked
position</title><normal-dispcond nb-required="0" rectification-interval="B"><remark><requirement lid="N.00025904.0003001.007" req-id="R12707"><para code="00025904.0003001.012" layer="1" lid="N.00025904.0003001.008">Two or more may be inoperative in disengaged/unlocked position provided
that the <abb>CDLS</abb> Normal System and BK UP System are considered
inoperative. </para><para code="00025904.0003001.017" layer="1" lid="N.00025904.0003001.015"><duref product="MMEL" ref="00008750"/>, and</para><para code="00025904.0003001.018" layer="1" lid="N.00025904.0003001.019"><duref product="MMEL" ref="00008752"/></para></requirement></remark></normal-dispcond></dispcond><dispcond code="00025904.0003001.013" dispcond-id="D12708" dispcond-label="C" lid="N.00025904.0003001.009"><title>One or more door latches inoperative in engaged/locked position</title><normal-dispcond nb-required="0" rectification-interval="D"><remark><requirementblock><requirement lid="N.00025904.0003001.010" req-id="R12709"><opsproc-ref><duref product="MMEL" ref="00025905"/></opsproc-ref><qualifiers><qualifier value="NO_GO_IF_52-51-01"/><qualifier value="NO_GO_IF_52-53-04"/></qualifiers><para code="00025904.0003001.014" layer="1" lid="N.00025904.0003001.011">One or
more may be inoperative in engaged/locked position provided that: </para></requirement><addrequ lid="N.00025904.0003001.020"><requirement lid="N.00025904.0003001.021" req-id="R12750"><para code="00025904.0003001.019" layer="1" lid="N.00025904.0003001.022">The <abb>CDLS</abb> Normal System is operative, and</para></requirement></addrequ><addrequ lid="N.00025904.0003001.023"><requirement lid="N.00025904.0003001.024" req-id="R12751"><para code="00025904.0003001.020" layer="1" lid="N.00025904.0003001.025">The cockpit door <tech-label type="light">OPEN</tech-label> is not displayed, and</para></requirement></addrequ><addrequ lid="N.00025904.0003001.026"><requirement lid="N.00025904.0003001.027" req-id="R12752"><para code="00025904.0003001.021" layer="1" lid="N.00025904.0003001.028">The UNLOCK Function of the <tech-label type="sw">COCKPIT DOOR</tech-label> is operative.</para></requirement></addrequ></requirementblock></remark></normal-dispcond></dispcond><dispcond code="00025904.0003001.015" dispcond-id="D12710" dispcond-label="D" lid="N.00025904.0003001.012"><title>One or more door latches inoperative in engaged/locked position</title><normal-dispcond nb-required="0" rectification-interval="C"><remark><requirementblock><requirement lid="N.00025904.0003001.013" req-id="R12711"><opsproc-ref><duref product="MMEL" ref="00026050"/></opsproc-ref><qualifiers><qualifier value="NO_GO_IF_52-51-02"/></qualifiers><para code="00025904.0003001.016" layer="1" lid="N.00025904.0003001.014">One or
more may be inoperative in engaged/locked position provided that:</para></requirement><addrequ lid="N.00025904.0003001.029"><requirement lid="N.00025904.0003001.030" req-id="R12753"><para code="00025904.0003001.022" layer="1" lid="N.00025904.0003001.031">The <abb>CDLS</abb> BK UP System is operative, and</para></requirement></addrequ><addrequ lid="N.00025904.0003001.032"><requirement lid="N.00025904.0003001.033" req-id="R12754"><para code="00025904.0003001.023" layer="1" lid="N.00025904.0003001.034">The cockpit door <tech-label type="light">OPEN</tech-label> is not displayed, and</para></requirement></addrequ><addrequ lid="N.00025904.0003001.035"><requirement lid="N.00025904.0003001.036" req-id="R12755"><para code="00025904.0003001.024" layer="1" lid="N.00025904.0003001.037">The unlock function of the <tech-label type="pb">CTL</tech-label> is operative.</para></requirement></addrequ></requirementblock></remark></normal-dispcond></dispcond></ditembody></dispatchitem>