<opsproc code="00015757.0001001" revdate="2015-08-11T20:09:15"><title>Manual Control of the X Bleed Valve</title><procitem layer="1" lid="N.00015757.0001001.001"><title>DURING COCKPIT PREPARATION</title><procbody lid="N.00015757.0001001.002"><action layer="1" lid="N.00015757.0001001.015" memory="false"><cr-action code="00015757.0001001.006"><challenge><tech-label type="sel">X BLEED</tech-label></challenge><response>AUTO</response></cr-action></action><action-block lid="N.00015757.0001001.007"><title>Check of the automatic control of the X BLEED valve:</title><action layer="1" lid="N.00015757.0001001.008" memory="false"><command code="00015757.0001001.007"><para layer="1" lid="N.00015757.0001001.016">Check that the <abb>APU</abb> is started.</para></command></action><action layer="1" lid="N.00015757.0001001.017" memory="false"><cr-action code="00015757.0001001.008"><challenge><tech-label type="pb-sw">APU BLEED</tech-label></challenge><response>Off</response></cr-action></action><action layer="1" lid="N.00015757.0001001.009" memory="false"><command code="00015757.0001001.003"><para layer="1" lid="N.00015757.0001001.011">On the <tech-label type="s-page">BLEED</tech-label>, check that the cross bleed valve is indicated closed.</para></command></action><action layer="1" lid="N.00015757.0001001.012" memory="false"><cr-action code="00015757.0001001.004"><challenge><tech-label type="pb-sw">APU BLEED</tech-label></challenge><response>ON</response></cr-action></action><action layer="1" lid="N.00015757.0001001.013" memory="false"><command code="00015757.0001001.005"><para layer="1" lid="N.00015757.0001001.014">On the <tech-label type="s-page">BLEED</tech-label>, check that the cross bleed valve is indicated open.</para></command></action></action-block></procbody></procitem></opsproc>