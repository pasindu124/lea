<opsproc code="00009035.0001001" revdate="2020-05-13T11:32:35"><title>PFDU 2</title><procitem layer="1" lid="N.00009035.0001001.008"><title>Flight preparation/Limitations</title><procbody lid="N.00009035.0001001.009"><limit layer="1" lid="N.00009035.0001001.013"><lit-limit lid="N.00009035.0001001.014">For aircraft with the <abb>RNP</abb> <abb>AR</abb> capability, <abb>RNP</abb> <abb>AR</abb> operations are not permitted.</lit-limit></limit><condition at-any-time="false" code="00009035.0001001.014" direct="false" layer="1" lid="N.00009035.0001001.031" subtitle="false" type="cond"><intro>If the <abb>PM</abb> side is affected:</intro><procbody lid="N.00009035.0001001.032"><action layer="1" lid="N.00009035.0001001.047" memory="false"><command code="00009035.0001001.022"><para layer="1" lid="N.00009035.0001001.048">To perform <abb>RNP
APCH</abb>, <abb>RNAV</abb> 10, <abb>RNAV</abb> 5, <abb>RNAV</abb> 1 / <abb>RNAV</abb> 2, <abb>RNP</abb> 4, <abb>RNP</abb> 2 and <abb>RNP</abb> 1 operations, use the <tech-label type="pb">PFD/ND XFR</tech-label> to temporary
display <abb>ND</abb> information on the operative <abb>DU</abb>.</para></command></action></procbody></condition><condition at-any-time="false" code="00009035.0001001.006" direct="false" layer="1" lid="N.00009035.0001001.015" subtitle="false" type="cond"><intro>If the <abb>PF</abb> side is affected:</intro><procbody lid="N.00009035.0001001.016"><limit layer="1" lid="N.00009035.0001001.017"><lit-limit lid="N.00009035.0001001.018"><abb>RNP</abb> <abb>APCH</abb> operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00009035.0001001.019"><lit-limit lid="N.00009035.0001001.020"><abb>RNAV</abb> 10 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00009035.0001001.021"><lit-limit lid="N.00009035.0001001.022"><abb>RNAV</abb> 5 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00009035.0001001.023"><lit-limit lid="N.00009035.0001001.024"><abb>RNAV</abb> 1 / <abb>RNAV</abb> 2 operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00009035.0001001.025"><lit-limit lid="N.00009035.0001001.026"><abb>RNP</abb> 4 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00009035.0001001.027"><lit-limit lid="N.00009035.0001001.028"><abb>RNP</abb> 2 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00009035.0001001.029"><lit-limit lid="N.00009035.0001001.030"><abb>RNP</abb> 1 operations
are not permitted.</lit-limit></limit></procbody></condition><limit layer="1" lid="N.00009035.0001001.010"><lit-limit lid="N.00009035.0001001.011">Maximum landing capability is <abb>CAT</abb> 2.</lit-limit></limit></procbody></procitem><procitem layer="1" lid="N.00009035.0001001.004"><title>On ground or in flight</title><procbody lid="N.00009035.0001001.005"><action layer="1" lid="N.00009035.0001001.012" memory="false"><cr-action code="00009035.0001001.004"><challenge><tech-label type="knob">PFDU 2</tech-label></challenge><response>OFF</response></cr-action></action></procbody></procitem></opsproc>