<opsproc code="00008862.0001001" revdate="2025-11-19T15:52:04"><title>Avionics Equipment Ventilation Computer (<abb>AEVC</abb>)</title><procitem layer="1" lid="N.00008862.0001001.042"><title>Flight preparation/Limitations</title><procbody lid="N.00008862.0001001.043"><limit layer="1" lid="N.00008862.0001001.046"><lit-limit lid="N.00008862.0001001.047">One engine taxi is not permitted.</lit-limit></limit></procbody></procitem><procitem layer="1" lid="N.00008862.0001001.008"><title>During cockpit preparation</title><procbody lid="N.00008862.0001001.009"><action-block lid="N.00008862.0001001.012"><action layer="1" lid="N.00008862.0001001.038" memory="false"><command code="00008862.0001001.018"><para layer="1" lid="N.00008862.0001001.039">Supply the aircraft electrical
network.</para></command></action><action layer="1" lid="N.00008862.0001001.013" memory="false"><command code="00008862.0001001.005"><para layer="1" lid="N.00008862.0001001.014">Check that the air conditioning
is operating with both air conditioning packs set to on.</para></command></action><action layer="1" lid="N.00008862.0001001.015" memory="false"><cr-action code="00008862.0001001.006"><challenge><tech-label type="pb-sw">BLOWER</tech-label></challenge><response>OVRD</response></cr-action></action><action layer="1" lid="N.00008862.0001001.016" memory="false"><cr-action code="00008862.0001001.007"><challenge><tech-label type="pb-sw">EXTRACT</tech-label></challenge><response>OVRD</response></cr-action></action></action-block><inform layer="1" lid="N.00008862.0001001.017"><noteproc code="00008862.0001001.008" layer="1" lid="N.00008862.0001001.018"><inform layer="1" lid="N.00008862.0001001.019"><para code="00008862.0001001.009" layer="1" lid="N.00008862.0001001.020">If the ground horn sounds:</para></inform><action layer="1" lid="N.00008862.0001001.021" memory="false"><cr-action code="00008862.0001001.010"><challenge><tech-label type="cb">EIS/HORN/SPLY (121VU P09)</tech-label></challenge><response>Pull</response></cr-action><comment code="00008862.0001001.011"><para layer="1" lid="N.00008862.0001001.022">The <abb>C/B</abb> must be closed again after first engine start</para></comment></action><inform layer="1" lid="N.00008862.0001001.023"><para code="00008862.0001001.012" layer="1" lid="N.00008862.0001001.024">If the ground horn sounds after landing
when engines are off, it can be silenced again. In this case, the <abb>ADIRS</abb> must be set to OFF before leaving the aircraft.</para></inform></noteproc><noteproc code="00008862.0001001.013" layer="1" lid="N.00008862.0001001.025"><inform layer="1" lid="N.00008862.0001001.026"><para code="00008862.0001001.014" layer="1" lid="N.00008862.0001001.027">In the case of a low pressure
