<opsproc code="00008905.0003001" revdate="2020-11-12T14:37:15"><title><tech-label type="pb">Autothrust Instinctive Disconnect</tech-label></title><procdesc code="00008905.0003001.001" lid="N.00008905.0003001.001"><para code="00008905.0003001.002" layer="1" lid="N.00008905.0003001.002">The purpose of the procedure
is to check the <abb>A/THR</abb> disconnection via the remaining <tech-label type="pb">Instinctive Disconnect</tech-label> and via the <tech-label type="pb">A/THR</tech-label> on the <abb>FCU</abb>.</para></procdesc><procitem layer="1" lid="N.00008905.0003001.003"><title>After <abb>IRS</abb> alignment</title><procbody lid="N.00008905.0003001.004"><inform layer="1" lid="N.00008905.0003001.005"><noteproc code="00008905.0003001.003" layer="1" lid="N.00008905.0003001.006"><para layer="1" lid="N.00008905.0003001.007">Disregard alerts during the
test. Use the <tech-label type="pb">EMER CANCEL</tech-label> on the <abb>ECAM</abb> control
panel as necessary.</para></noteproc></inform><action-block lid="N.00008905.0003001.008"><title>Aircraft configuration for the check via the <abb>FMS</abb> 1:</title><action layer="1" lid="N.00008905.0003001.009" memory="false"><cr-action code="00008905.0003001.004"><challenge>ENG/FADEC GND PWR 1 and 2</challenge><response>ON</response></cr-action></action><action layer="1" lid="N.00008905.0003001.010" memory="false"><cr-action code="00008905.0003001.005"><challenge>Both thrust levers</challenge><response>MCT</response></cr-action></action><action layer="1" lid="N.00008905.0003001.011" memory="false"><cr-action code="00008905.0003001.006"><challenge>FD</challenge><response>Off</response></cr-action></action><action layer="1" lid="N.00008905.0003001.012" memory="false"><cr-action code="00008905.0003001.007"><challenge><tech-label type="cb">AUTO FLT/FMGC/2 (121 VU
M17)</tech-label></challenge><response>Pull</response></cr-action></action><action layer="1" lid="N.00008905.0003001.013" memory="false"><cr-action code="00008905.0003001.008"><challenge>A/THR</challenge><response>On</response></cr-action></action><action layer="1" lid="N.00008905.0003001.014" memory="false"><command code="00008905.0003001.009"><para layer="1" lid="N.00008905.0003001.015">Check that green SPEED and white
A/THR indications appear on the PFD.</para></command></action><action layer="1" lid="N.00008905.0003001.016" memory="false"><command code="00008905.0003001.010"><para layer="1" lid="N.00008905.0003001.017">Check that <tech-label type="pb">A/THR</tech-label> light
bars are ON.</para></command></action></action-block><action-block lid="N.00008905.0003001.018"><title>Check of the <abb>A/THR</abb> disconnection via the remaining <tech-label type="pb">Instinctive Disconnect</tech-label>:</title><action layer="1" lid="N.00008905.0003001.019" memory="false"><cr-action code="00008905.0003001.011"><challenge>A/THR instinctive disconnect
pb (non affected autothrust)</challenge><response>Push</response></cr-action></action><action layer="1" lid="N.00008905.0003001.020" memory="false"><command code="00008905.0003001.012"><para layer="1" lid="N.00008905.0003001.021">Check that the <tech-label type="pb">A/THR</tech-label> light bars are OFF.</para></command></action><action layer="1" lid="N.00008905.0003001.022" memory="false"><command code="00008905.0003001.013"><para layer="1" lid="N.00008905.0003001.023">Check that green SPEED and white
A/THR indications are no more displayed on the <abb>PFD</abb>.</para></command></action><action layer="1" lid="N.00008905.0003001.024" memory="false"><cr-action code="00008905.0003001.014"><challenge>A/THR</challenge><response>On</response></cr-action></action><action layer="1" lid="N.00008905.0003001.025" memory="false"><command code="00008905.0003001.015"><para layer="1" lid="N.00008905.0003001.026">Check that the <tech-label type="pb">A/THR</tech-label> light bars are ON.</para></command></action><action layer="1" lid="N.00008905.0003001.027" memory="false"><command code="00008905.0003001.016"><para layer="1" lid="N.00008905.0003001.028">Check that green SPEED and white
A/THR indications are displayed on the <abb>PFD</abb>.</para></command></action></action-block><action-block lid="N.00008905.0003001.029"><title>Check of the <abb>A/THR</abb> disconnection via the <tech-label type="pb">A/THR</tech-label> on the <abb>FCU</abb>:</title><action layer="1" lid="N.00008905.0003001.030" memory="false"><cr-action code="00008905.0003001.017"><challenge><tech-label type="pb">A/THR</tech-label> (on the <abb>FCU</abb>)</challenge><response>Off</response></cr-action></action><action layer="1" lid="N.00008905.0003001.031" memory="false"><command code="00008905.0003001.018"><para layer="1" lid="N.00008905.0003001.032">Check that the <tech-label type="pb">A/THR</tech-label> light bars are OFF.</para></command></action><action layer="1" lid="N.00008905.0003001.033" memory="false"><command code="00008905.0003001.019"><para layer="1" lid="N.00008905.0003001.034">Check that green SPEED and white
A/THR indications are no more displayed on the <abb>PFD</abb>.</para></command></action><action layer="1" lid="N.00008905.0003001.035" memory="false"><cr-action code="00008905.0003001.020"><challenge>A/THR</challenge><response>On</response></cr-action></action></action-block><action-block lid="N.00008905.0003001.036"><title>Aircraft configuration for the check via the <abb>FMS</abb> 2:</title><action layer="1" lid="N.00008905.0003001.037" memory="false"><cr-action code="00008905.0003001.021"><challenge><tech-label type="cb">AUTO FLT/FMGC/2 (121VU
M17)</tech-label></challenge><response>Push</response></cr-action></action><action layer="1" lid="N.00008905.0003001.067" memory="false"><command code="00008905.0003001.040"><para layer="1" lid="N.00008905.0003001.068">Wait <measure category="Time" show-unit="true" system="SI and derived" unit="min">2</measure>.</para></command></action><action layer="1" lid="N.00008905.0003001.038" memory="false"><cr-action code="00008905.0003001.022"><challenge><tech-label type="cb">AUTO FLT/FMGC/1 (49VU H08)</tech-label></challenge><response>Pull</response></cr-action></action></action-block><action-block lid="N.00008905.0003001.041"><title>Check of the <abb>A/THR</abb> disconnection via the remaining <tech-label type="pb">Instinctive Disconnect</tech-label>:</title><action layer="1" lid="N.00008905.0003001.042" memory="false"><cr-action code="00008905.0003001.024"><challenge>A/THR instinctive disconnect
pb (non affected autothrust)</challenge><response>Push</response></cr-action></action><action layer="1" lid="N.00008905.0003001.043" memory="false"><command code="00008905.0003001.025"><para layer="1" lid="N.00008905.0003001.044">Check that the <tech-label type="pb">A/THR</tech-label> light bars are OFF.</para></command></action><action layer="1" lid="N.00008905.0003001.045" memory="false"><command code="00008905.0003001.026"><para layer="1" lid="N.00008905.0003001.046">Check that green SPEED and white
A/THR indications are no more displayed on the <abb>PFD</abb>.</para></command></action><action layer="1" lid="N.00008905.0003001.047" memory="false"><cr-action code="00008905.0003001.027"><challenge>A/THR</challenge><response>On</response></cr-action></action><action layer="1" lid="N.00008905.0003001.048" memory="false"><command code="00008905.0003001.028"><para layer="1" lid="N.00008905.0003001.049">Check that the <tech-label type="pb">A/THR</tech-label> light bars are ON.</para></command></action><action layer="1" lid="N.00008905.0003001.050" memory="false"><command code="00008905.0003001.029"><para layer="1" lid="N.00008905.0003001.051">Check that green SPEED and white
A/THR indications are displayed on the <abb>PFD</abb>.</para></command></action></action-block><action-block lid="N.00008905.0003001.052"><title>Check of the <abb>A/THR</abb> disconnection via the <tech-label type="pb">A/THR</tech-label> on the <abb>FCU</abb>:</title><action layer="1" lid="N.00008905.0003001.053" memory="false"><cr-action code="00008905.0003001.030"><challenge><tech-label type="pb">A/THR</tech-label> (on the <abb>FCU</abb>)</challenge><response>Off</response></cr-action></action><action layer="1" lid="N.00008905.0003001.054" memory="false"><command code="00008905.0003001.031"><para layer="1" lid="N.00008905.0003001.055">Check that the <tech-label type="pb">A/THR</tech-label> light bars are OFF.</para></command></action><action layer="1" lid="N.00008905.0003001.056" memory="false"><command code="00008905.0003001.032"><para layer="1" lid="N.00008905.0003001.057">Check that green SPEED and white
A/THR indications are no more displayed on the <abb>PFD</abb>.</para></command></action><action layer="1" lid="N.00008905.0003001.058" memory="false"><cr-action code="00008905.0003001.033"><challenge>A/THR</challenge><response>On</response></cr-action></action></action-block><action-block lid="N.00008905.0003001.059"><title>Restore normal aircraft configuration:</title><action layer="1" lid="N.00008905.0003001.060" memory="false"><cr-action code="00008905.0003001.034"><challenge>A/THR</challenge><response>Off</response></cr-action></action><action layer="1" lid="N.00008905.0003001.061" memory="false"><cr-action code="00008905.0003001.035"><challenge><tech-label type="cb">AUTO FLT/FMGC/1 (49VU H08)</tech-label></challenge><response>Push</response></cr-action></action><action layer="1" lid="N.00008905.0003001.062" memory="false"><cr-action code="00008905.0003001.036"><challenge>ENG/FADEC GND PWR 1 and 2</challenge><response>Off</response></cr-action></action><action layer="1" lid="N.00008905.0003001.063" memory="false"><cr-action code="00008905.0003001.037"><challenge>Both thrust levers</challenge><response>IDLE</response></cr-action></action><action layer="1" lid="N.00008905.0003001.064" memory="false"><cr-action code="00008905.0003001.038"><challenge>RCL pb (on the <abb>ECAM</abb> control panel)</challenge><response>Push</response></cr-action></action><action layer="1" lid="N.00008905.0003001.065" memory="false"><command code="00008905.0003001.039"><para layer="1" lid="N.00008905.0003001.066">Wait <measure category="Time" show-unit="true" system="SI and derived" unit="min">2</measure> before
