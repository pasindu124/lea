<dispatchitem code="00016004.0001001" func-code="36-00-01" item-list-nbr="01" revdate="2016-11-22T00:00:00"><title>AIR BLEED MAINTENANCE Message</title><ditembody nb-installed="-"><dispcond code="00016004.0001001.001" dispcond-id="D07624" dispcond-label="A" lid="N.00016004.0001001.001"><title>No fault on a <abb>BMC</abb>, on a pylon leak detection loop
or on the <abb>APU</abb> leak detection loop</title><normal-dispcond nb-required="-" rectification-interval="C"><remark><requirement lid="N.00016004.0001001.002" req-id="R07625"><maintenance-ref><taskref chap-nbr="36" func="040" product="AMM Task" sect-nbr="11" seq="004" subj-nbr="00"/></maintenance-ref><para code="00016004.0001001.003" layer="1" lid="N.00016004.0001001.004">AIR BLEED <emph bold="false" italic="false" overline="false" sub="false" sup="false" underline="true">MAINTENANCE</emph> message may be displayed on the <tech-label type="s-page">STATUS</tech-label> provided
