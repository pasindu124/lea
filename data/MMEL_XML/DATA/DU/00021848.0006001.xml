<opsproc code="00021848.0006001" revdate="2021-02-24T10:39:03"><title>BKUP SPD/ALT pb-sw (One or both inoperative)</title><procbody lid="N.00021848.0006001.001"><condition at-any-time="false" code="00021848.0006001.001" direct="false" layer="1" lid="N.00021848.0006001.002" subtitle="false" type="cond"><intro>In case of <abb>ECAM</abb> procedure requesting to use the <abb>DBUS</abb>:</intro><procbody lid="N.00021848.0006001.003"><action layer="1" lid="N.00021848.0006001.004" memory="false"><cr-action code="00021848.0006001.002"><challenge><tech-label type="pb-sw">BKUP SPD/ALT</tech-label> </challenge><response>DO NOT USE</response></cr-action></action><ex-conditions lid="N.00021848.0006001.006"><condition at-any-time="false" code="00021848.0006001.004" direct="false" layer="1" lid="N.00021848.0006001.007" subtitle="false" type="cond"><intro>If at least one speed confirmed reliable:</intro><procbody lid="N.00021848.0006001.008"><action layer="1" lid="N.00021848.0006001.009" memory="false"><cr-action code="00021848.0006001.005"><challenge>RELIABLE SPEED DATA</challenge><response>USE</response></cr-action></action></procbody></condition><condition at-any-time="false" code="00021848.0006001.006" direct="false" layer="1" lid="N.00021848.0006001.012" subtitle="false" type="cond"><intro>If no speed confirmed reliable:</intro><procbody lid="N.00021848.0006001.013"><action layer="1" lid="N.00021848.0006001.014" memory="false"><cr-action code="00021848.0006001.007"><challenge>PITCH/THRUST TABLE</challenge><response>APPLY</response></cr-action></action><inform layer="1" lid="N.00021848.0006001.015"><para code="00021848.0006001.008" layer="1" lid="N.00021848.0006001.016"><duref product="QRH" ref="00017718"/>.</para></inform></procbody></condition></ex-conditions></procbody></condition></procbody></opsproc>