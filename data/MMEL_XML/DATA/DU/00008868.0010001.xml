<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE opsproc PUBLIC "-//AIRBUS OPS//DTD OPSPROC_EXCH-VER10.0//EN" "../DTD/opsproc-exch.dtd">
<opsproc code="00008868.0010001" revdate="2025-11-19T15:04:49"><title>Engine Bleed Air Supply System (non-ETOPS flights)</title><procitem layer="1" lid="N.00008868.0010001.001"><title>Flight preparation/limitations</title><procbody lid="N.00008868.0010001.002"><action layer="1" lid="N.00008868.0010001.003" memory="false"><command code="00008868.0010001.001"><para layer="1" lid="N.00008868.0010001.004">The flight crew should take
into account the severity of forecast icing conditions. The wing anti-ice
will be lost if the remaining engine bleed air supply system becomes
inoperative.</para></command></action><condition at-any-time="false" code="00008868.0010001.067" direct="false" layer="1" lid="N.00008868.0010001.126" subtitle="false" type="cond"><intro>If <abb>ENG</abb> 1 bleed is affected:</intro><procbody lid="N.00008868.0010001.127"><limit layer="1" lid="N.00008868.0010001.131"><lit-limit lid="N.00008868.0010001.132">One engine taxi is not permitted.</lit-limit></limit></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00008868.0010001.005"><title>After engine start</title><procbody lid="N.00008868.0010001.006"><ex-conditions lid="N.00008868.0010001.130"><condition at-any-time="false" code="00008868.0010001.029" direct="false" layer="1" lid="N.00008868.0010001.056" subtitle="false" type="cond"><intro>If two engine taxi at departure:</intro><procbody lid="N.00008868.0010001.057"><action-block lid="N.00008868.0010001.007"><action layer="1" lid="N.00008868.0010001.008" memory="false"><cr-action code="00008868.0010001.002"><challenge><tech-label type="pb-sw">ENG BLEED (affected side)</tech-label></challenge><response>OFF</response></cr-action></action><action layer="1" lid="N.00008868.0010001.009" memory="false"><cr-action code="00008868.0010001.003"><challenge><tech-label type="rotsel">X BLEED</tech-label></challenge><response>OPEN</response></cr-action></action></action-block><ex-conditions lid="N.00008868.0010001.010"><condition at-any-time="false" code="00008868.0010001.004" direct="false" layer="1" lid="N.00008868.0010001.011" subtitle="false" type="cond"><intro>If both PACKs are operative:</intro><procbody lid="N.00008868.0010001.012"><ex-conditions lid="N.00008868.0010001.013"><condition at-any-time="false" code="00008868.0010001.005" direct="false" layer="1" lid="N.00008868.0010001.014" subtitle="false" type="cond"><intro>If Wing Anti-Ice is not required:</intro><procbody lid="N.00008868.0010001.015"><action layer="1" lid="N.00008868.0010001.016" memory="false"><cr-action code="00008868.0010001.006"><challenge><tech-label type="sel">PACK FLOW</tech-label></challenge><response>LO</response></cr-action><comment code="00008868.0010001.007"><para layer="1" lid="N.00008868.0010001.017">The <tech-label type="sel">PACK FLOW</tech-label> must be set to LO due to precooler performance.</para></comment></action></procbody></condition><condition at-any-time="false" code="00008868.0010001.065" direct="false" layer="1" lid="N.00008868.0010001.124" subtitle="false" type="cond"><intro>If Wing Anti-Ice is required:</intro><procbody lid="N.00008868.0010001.019"><action layer="1" lid="N.00008868.0010001.020" memory="false"><cr-action code="00008868.0010001.009"><challenge><tech-label type="pb-sw">PACK (affected side)</tech-label></challenge><response>OFF</response></cr-action></action></procbody></condition></ex-conditions></procbody></condition><condition at-any-time="false" code="00008868.0010001.010" direct="false" layer="1" lid="N.00008868.0010001.021" subtitle="false" type="cond"><intro>If one PACK is inoperative:</intro><procbody lid="N.00008868.0010001.022"><action layer="1" lid="N.00008868.0010001.023" memory="false"><cr-action code="00008868.0010001.011"><challenge><tech-label type="sel">PACK FLOW</tech-label></challenge><response>HI</response></cr-action></action></procbody></condition></ex-conditions></procbody></condition><condition at-any-time="false" code="00008868.0010001.030" direct="false" layer="1" lid="N.00008868.0010001.058" subtitle="false" type="cond"><intro>If one engine taxi at departure:</intro><procbody lid="N.00008868.0010001.059"><condition at-any-time="false" code="00008868.0010001.047" direct="false" layer="1" lid="N.00008868.0010001.089" subtitle="false" type="cond"><intro> If <abb>ENG</abb> 2 bleed is affected:</intro><procbody lid="N.00008868.0010001.090"><condition at-any-time="false" code="00008868.0010001.048" direct="false" layer="1" lid="N.00008868.0010001.091" subtitle="false" type="cond"><intro>After engine 2 start:</intro><procbody lid="N.00008868.0010001.092"><action layer="1" lid="N.00008868.0010001.093" memory="false"><cr-action code="00008868.0010001.049"><challenge><tech-label type="pb-sw">ENG BLEED 2</tech-label></challenge><response>OFF</response></cr-action></action><action layer="1" lid="N.00008868.0010001.094" memory="false"><cr-action code="00008868.0010001.050"><challenge><tech-label type="rotsel">X BLEED</tech-label></challenge><response>OPEN</response></cr-action></action><ex-conditions lid="N.00008868.0010001.095"><condition at-any-time="false" code="00008868.0010001.051" direct="false" layer="1" lid="N.00008868.0010001.096" subtitle="false" type="cond"><intro>If both PACKs are operative:</intro><procbody lid="N.00008868.0010001.097"><ex-conditions lid="N.00008868.0010001.098"><condition at-any-time="false" code="00008868.0010001.052" direct="false" layer="1" lid="N.00008868.0010001.099" subtitle="false" type="cond"><intro>If Wing Anti-Ice is not required:</intro><procbody lid="N.00008868.0010001.100"><action layer="1" lid="N.00008868.0010001.101" memory="false"><cr-action code="00008868.0010001.053"><challenge><tech-label type="sel">PACK FLOW</tech-label></challenge><response>LO</response></cr-action><comment code="00008868.0010001.054"><para layer="1" lid="N.00008868.0010001.102">The PACK FLOW selector
must be set to <abb>LO</abb> due to precooler performance.</para></comment></action></procbody></condition><condition at-any-time="false" code="00008868.0010001.055" direct="false" layer="1" lid="N.00008868.0010001.104" subtitle="false" type="cond"><intro>If Wing Anti-Ice is required:</intro><procbody lid="N.00008868.0010001.105"><action layer="1" lid="N.00008868.0010001.106" memory="false"><cr-action code="00008868.0010001.056"><challenge><tech-label type="pb-sw">PACK 2</tech-label></challenge><response>OFF</response></cr-action></action></procbody></condition></ex-conditions></procbody></condition><condition at-any-time="false" code="00008868.0010001.057" direct="false" layer="1" lid="N.00008868.0010001.108" subtitle="false" type="cond"><intro>If one PACK is inoperative:</intro><procbody lid="N.00008868.0010001.109"><action layer="1" lid="N.00008868.0010001.110" memory="false"><cr-action code="00008868.0010001.058"><challenge><tech-label type="sel">PACK FLOW</tech-label></challenge><response>HI</response></cr-action></action></procbody></condition></ex-conditions></procbody></condition></procbody></condition></procbody></condition></ex-conditions></procbody></procitem><procitem layer="1" lid="N.00008868.0010001.024"><title>For takeoff</title><procbody lid="N.00008868.0010001.025"><inform layer="1" lid="N.00008868.0010001.026"><para code="00008868.0010001.012" layer="1" lid="N.00008868.0010001.027">Set at least one air conditioning
pack to off, or use the <abb>APU</abb> bleed air supply system.</para></inform></procbody></procitem><procitem layer="1" lid="N.00008868.0010001.028"><title>After takeoff</title><procbody lid="N.00008868.0010001.029"><condition at-any-time="false" code="00008868.0010001.013" direct="false" layer="1" lid="N.00008868.0010001.030" subtitle="false" type="cond"><intro>If the APU has been used to supply the air conditioning during
the takeoff:</intro><procbody lid="N.00008868.0010001.031"><action layer="1" lid="N.00008868.0010001.032" memory="false"><cr-action code="00008868.0010001.014"><challenge><tech-label type="pb-sw">APU BLEED</tech-label></challenge><response>Off</response></cr-action></action></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00008868.0010001.033"><title>In flight</title><procbody lid="N.00008868.0010001.034"><condition at-any-time="false" code="00008868.0010001.015" direct="false" layer="1" lid="N.00008868.0010001.035" subtitle="false" type="cond"><intro>If Wing Anti-Ice is required and both PACKs are operative:</intro><procbody lid="N.00008868.0010001.036"><action layer="1" lid="N.00008868.0010001.037" memory="false"><cr-action code="00008868.0010001.016"><challenge><tech-label type="pb-sw">PACK (affected
side)</tech-label></challenge><response>OFF</response></cr-action></action></procbody></condition><condition at-any-time="false" code="00008868.0010001.017" direct="false" layer="1" lid="N.00008868.0010001.038" subtitle="false" type="cond"><intro>In the case of failure of the remaining engine bleed air supply
system, or in the case of failure of the associated engine:</intro><procbody lid="N.00008868.0010001.039"><action layer="1" lid="N.00008868.0010001.045" memory="false"><command code="00008868.0010001.020"><para layer="1" lid="N.00008868.0010001.046">Apply the <ecam-data ecamimportance="A" type="alert"><ecamsys>AIR</ecamsys><ecamtitle> ENG 1+2 BLEED FAULT</ecamtitle></ecam-data> <abb>ECAM</abb> procedure.</para><caution code="00008868.0010001.023" layer="1" lid="N.00008868.0010001.050"><para layer="1" lid="N.00008868.0010001.049">Reset <tech-label type="pb-sw">ENG BLEED</tech-label> as requested by <abb>ECAM</abb> procedure even if the <tech-label type="pb-sw">ENG
BLEED</tech-label> is placarded inoperative as per <abb>MMEL</abb> 36-11-01.</para></caution></command></action></procbody></condition></procbody></procitem></opsproc>