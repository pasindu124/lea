<opsproc code="00008905.0002001" revdate="2020-11-12T14:37:14"><title><tech-label type="pb">Autothrust Instinctive Disconnect</tech-label></title><procdesc code="00008905.0002001.002" lid="N.00008905.0002001.006"><para code="00008905.0002001.004" layer="1" lid="N.00008905.0002001.008">The purpose of the procedure is to check
the <abb>A/THR</abb> disconnection via the remaining <tech-label type="pb">Instinctive
Disconnect</tech-label> and via the <tech-label type="pb">A/THR</tech-label> on the <abb>FCU</abb>.</para></procdesc><procitem layer="1" lid="N.00008905.0002001.009"><title>After <abb>IRS</abb> alignment</title><procbody lid="N.00008905.0002001.010"><inform layer="1" lid="N.00008905.0002001.081"><noteproc code="00008905.0002001.047" layer="1" lid="N.00008905.0002001.082"><para layer="1" lid="N.00008905.0002001.083">Disregard alerts during the
test. Use the <tech-label type="pb">EMER CANCEL</tech-label> on the <abb>ECAM</abb> control panel as necessary.</para></noteproc></inform><action-block lid="N.00008905.0002001.014"><title>Aircraft configuration for the check via the <abb>FMS</abb> 1:</title><action layer="1" lid="N.00008905.0002001.015" memory="false"><cr-action code="00008905.0002001.007"><challenge>ENG/FADEC GND PWR 1 and 2</challenge><response>ON</response></cr-action></action><action layer="1" lid="N.00008905.0002001.016" memory="false"><cr-action code="00008905.0002001.008"><challenge>Both
thrust levers</challenge><response>MCT</response></cr-action></action><action layer="1" lid="N.00008905.0002001.017" memory="false"><cr-action code="00008905.0002001.009"><challenge>FD</challenge><response>Off</response></cr-action></action><action layer="1" lid="N.00008905.0002001.018" memory="false"><cr-action code="00008905.0002001.010"><challenge><tech-label type="cb">AUTO FLT/FMGC/2 (121 VU
M17)</tech-label></challenge><response>Pull</response></cr-action></action><action layer="1" lid="N.00008905.0002001.019" memory="false"><cr-action code="00008905.0002001.011"><challenge>A/THR</challenge><response>On</response></cr-action></action><action layer="1" lid="N.00008905.0002001.020" memory="false"><command code="00008905.0002001.012"><para layer="1" lid="N.00008905.0002001.021">Check that green SPEED and white
A/THR indications appear on the PFD.</para></command></action><action layer="1" lid="N.00008905.0002001.022" memory="false"><command code="00008905.0002001.013"><para layer="1" lid="N.00008905.0002001.023">Check that <tech-label type="pb">A/THR</tech-label> light
