allenge><tech-label type="sel">PACK FLOW</tech-label></challenge><response>LO</response></cr-action><comment code="00008869.0008001.009"><para layer="1" lid="N.00008869.0008001.030">The <tech-label type="sel">PACK FLOW</tech-label> must be set to LO due to precooler performance.</para></comment></action></procbody></condition><condition at-any-time="false" code="00008869.0008001.010" direct="false" layer="1" lid="N.00008869.0008001.031" subtitle="false" type="cond"><intro>If Wing Anti-Ice is required:</intro><procbody lid="N.00008869.0008001.032"><action layer="1" lid="N.00008869.0008001.033" memory="false"><cr-action code="00008869.0008001.011"><challenge><tech-label type="pb-sw">PACK (affected side)</tech-label></challenge><response>OFF</response></cr-action></action></procbody></condition></ex-conditions></procbody></condition><condition at-any-time="false" code="00008869.0008001.012" direct="false" layer="1" lid="N.00008869.0008001.034" subtitle="false" type="cond"><intro>If one PACK is inoperative:</intro><procbody lid="N.00008869.0008001.035"><action layer="1" lid="N.00008869.0008001.036" memory="false"><cr-action code="00008869.0008001.013"><challenge><tech-label type="sel">PACK FLOW</tech-label></challenge><response>HI</response></cr-action></action></procbody></condition></ex-conditions></procbody></condition><condition at-any-time="false" code="00008869.0008001.031" direct="false" layer="1" lid="N.00008869.0008001.076" subtitle="false" type="cond"><intro>If one engine taxi at departure:</intro><procbody lid="N.00008869.0008001.077"><condition at-any-time="false" code="00008869.0008001.032" direct="false" layer="1" lid="N.00008869.0008001.079" subtitle="false" type="cond"><intro> If <abb>ENG</abb> 2 bleed is affected:</intro><procbody lid="N.00008869.0008001.080"><condition at-any-time="false" code="00008869.0008001.033" direct="false" layer="1" lid="N.00008869.0008001.081" subtitle="false" type="cond"><intro>After engine 2 start:</intro><procbody lid="N.00008869.0008001.082"><action layer="1" lid="N.00008869.0008001.083" memory="false"><cr-action code="00008869.0008001.034"><challenge><tech-label type="pb-sw">ENG BLEED 2</tech-label></challenge><response>OFF</response></cr-action></action><action layer="1" lid="N.00008869.0008001.084" memory="false"><cr-action code="00008869.0008001.035"><challenge><tech-label type="rotsel">X BLEED</tech-label></challenge><response>OPEN</response></cr-action></action><ex-conditions lid="N.00008869.0008001.085"><condition at-any-time="false" code="00008869.0008001.036" direct="false" layer="1" lid="N.00008869.0008001.086" subtitle="false" type="cond"><intro>If both PACKs are operative:</intro><procbody lid="N.00008869.0008001.087"><ex-conditions lid="N.00008869.0008001.088"><condition at-any-time="false" code="00008869.0008001.037" direct="false" layer="1" lid="N.00008869.0008001.089" subtitle="false" type="cond"><intro>If Wing Anti-Ice is not required:</intro><procbody lid="N.00008869.0008001.090"><action layer="1" lid="N.00008869.0008001.091" memory="false"><cr-action code="00008869.0008001.038"><challenge><tech-label type="sel">PACK FLOW</tech-label></challenge><response>LO</response></cr-action><comment code="00008869.0008001.039"><para layer="1" lid="N.00008869.0008001.092">The PACK FLOW selector
