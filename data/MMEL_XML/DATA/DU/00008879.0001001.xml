<opsproc code="00008879.0001001" revdate="2015-05-13T14:40:16"><title>Automatic control of the X Bleed Valve</title><procitem layer="1" lid="N.00008879.0001001.014"><title>GENERAL INFORMATION</title><procbody lid="N.00008879.0001001.015"><action-block lid="N.00008879.0001001.016"><title>When the <tech-label type="pb-sw">APU BLEED</tech-label> is ON, or for engine start:</title><action layer="1" lid="N.00008879.0001001.017" memory="false"><cr-action code="00008879.0001001.007"><challenge><tech-label type="sel">X BLEED</tech-label></challenge><response>OPEN</response></cr-action></action><action layer="1" lid="N.00008879.0001001.018" memory="false"><command code="00008879.0001001.008"><para layer="1" lid="N.00008879.0001001.019">Select SHUT in all other cases.</para></command></action></action-block></procbody></procitem><procitem layer="1" lid="N.00008879.0001001.004"><title>During cockpit preparation</title><procbody lid="N.00008879.0001001.005"><action-block lid="N.00008879.0001001.006"><title>Check of the manual control of the X BLEED valve:</title><action layer="1" lid="N.00008879.0001001.007" memory="false"><cr-action code="00008879.0001001.002"><challenge><tech-label type="sel">X BLEED</tech-label></challenge><response>OPEN</response></cr-action></action><action layer="1" lid="N.00008879.0001001.008" memory="false"><command code="00008879.0001001.003"><para layer="1" lid="N.00008879.0001001.009">On the <tech-label type="ecamsys">BLEED</tech-label> SD page, check that the cross bleed valve is indicated open.</para></command></action><action layer="1" lid="N.00008879.0001001.010" memory="false"><cr-action code="00008879.0001001.004"><challenge><tech-label type="sel">X BLEED</tech-label></challenge><response>SHUT</response></cr-action></action><action layer="1" lid="N.00008879.0001001.011" memory="false"><command code="00008879.0001001.005"><para layer="1" lid="N.00008879.0001001.012">On the <tech-label type="ecamsys">BLEED</tech-label> SD page, check that the cross bleed valve is indicated closed.</para></command></action><action layer="1" lid="N.00008879.0001001.013" memory="false"><cr-action code="00008879.0001001.006"><challenge><tech-label type="sel">X BLEED</tech-label></challenge><response>AS RQRD</response></cr-action></action></action-block></procbody></procitem></opsproc>