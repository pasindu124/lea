<opsproc code="00012592.0001001" revdate="2017-05-03T18:47:03"><title><abb>NWS</abb> Electrical Deactivation Box (<abb>NWS</abb> Electrical
Deactivation Box deactivated)</title><procitem layer="1" lid="N.00012592.0001001.012"><title>During Cockpit Preparation</title><procbody lid="N.00012592.0001001.016"><condition at-any-time="false" code="00012592.0001001.006" direct="false" layer="1" lid="N.00012592.0001001.017" subtitle="false" type="cond"><intro>After application of the maintenance procedure:</intro><procbody lid="N.00012592.0001001.018"><action layer="1" lid="N.00012592.0001001.019" memory="false"><command code="00012592.0001001.007"><para layer="1" lid="N.00012592.0001001.020">Check that the <ecam-data ecamimportance="A" type="alert"><ecamsys>WHEEL</ecamsys><ecamtitle>N/W STRG FAULT</ecamtitle></ecam-data> or <ecam-data ecamimportance="A" type="alert"><ecamsys>WHEEL</ecamsys><ecamtitle>N.W STEER
FAULT</ecamtitle></ecam-data> alert is not displayed anymore on the <abb>EWD</abb>.</para><para layer="1" lid="N.00012592.0001001.021">If the <abb>ECAM</abb> alert is still displayed, consider the nosewheel steering inoperative. <duref product="MMEL" ref="00007755"/>.</para></command></action></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00012592.0001001.002"><title>Before pushback</title><procbody lid="N.00012592.0001001.003"><action layer="1" lid="N.00012592.0001001.004" memory="false"><cr-action code="00012592.0001001.001"><challenge><tech-label type="sel">A/SKID &amp; N/W STRG</tech-label></challenge><response>OFF</response></cr-action></action><inform layer="1" lid="N.00012592.0001001.008"><para code="00012592.0001001.003" layer="1" lid="N.00012592.0001001.009">As a result of the <abb>NWS</abb> electrical box deactivation, the
parking brake light on that box will not be available.</para></inform><action layer="1" lid="N.00012592.0001001.010" memory="false"><command code="00012592.0001001.004"><para layer="1" lid="N.00012592.0001001.011">The parking brake setting must
be verbally confirmed between the flight crew and the ground personnel
before pushback.</para></command></action></procbody></procitem><procitem layer="1" lid="N.00012592.0001001.005"><title>After pushback</title><procbody lid="N.00012592.0001001.006"><action layer="1" lid="N.00012592.0001001.007" memory="false"><cr-action code="00012592.0001001.002"><challenge><tech-label type="sel">A/SKID &amp; N/W STRG</tech-label></challenge><response>ON</response></cr-action></action></procbody></procitem></opsproc>