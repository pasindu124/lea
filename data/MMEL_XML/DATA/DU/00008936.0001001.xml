<opsproc code="00008936.0001001" revdate="2016-11-22T18:35:40"><title><abb>IR</abb> 3 (for aircraft with Honeywell 10 MCU <abb>ADIRU</abb> with only NAV mode of <abb>IR</abb> 3 inoperative)</title><procitem layer="1" lid="N.00008936.0001001.004"><title>Flight preparation/limitations</title><procbody lid="N.00008936.0001001.005"><limit layer="1" lid="N.00008936.0001001.015"><lit-limit lid="N.00008936.0001001.016">For aircraft with the <abb>RNP</abb> <abb>AR</abb> capability, <abb>RNP</abb> <abb>AR</abb> operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00008936.0001001.006"><lit-limit lid="N.00008936.0001001.007">Maximum landing capability is CAT 3 SINGLE.</lit-limit></limit></procbody></procitem><procitem layer="1" lid="N.00008936.0001001.008"><title>During cockpit preparation</title><procbody lid="N.00008936.0001001.009"><action-block lid="N.00008936.0001001.010"><action layer="1" lid="N.00008936.0001001.011" memory="false"><cr-action code="00008936.0001001.003"><challenge><tech-label type="sel">IR 3 mode</tech-label></challenge><response>ATT</response></cr-action><comment code="00008936.0001001.005"><para layer="1" lid="N.00008936.0001001.014">The F/CTL <emph bold="false" italic="false" overline="false" sub="false" sup="false" underline="true">MAINTENANCE</emph> is displayed on the <tech-label type="s-page">STATUS</tech-label>.</para></comment></action><action layer="1" lid="N.00008936.0001001.012" memory="false"><command code="00008936.0001001.004"><para layer="1" lid="N.00008936.0001001.013">The heading must be entered
through the <abb>CDU</abb> keyboard for the <abb>IR</abb> 3 and has
to be frequently reset (<duref product="FCOM" ref="00012425"/>).</para></command></action></action-block></procbody></procitem></opsproc>