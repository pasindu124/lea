<opsproc code="00008919.0002001" revdate="2018-02-15T11:15:38"><title>Flight Management and Guidance Computer (FMGC)</title><procitem layer="1" lid="N.00008919.0002001.001"><title>Flight preparation/Limitations</title><procbody lid="N.00008919.0002001.022"><limit layer="1" lid="N.00008919.0002001.025"><lit-limit lid="N.00008919.0002001.026">Maximum landing capability is CAT 3 SINGLE.</lit-limit></limit><limit layer="1" lid="N.00008919.0002001.023"><lit-limit lid="N.00008919.0002001.024">For aircraft with the <abb>RNP</abb> <abb>AR</abb> capability, <abb>RNP</abb> <abb>AR</abb> operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00008919.0002001.029"><lit-limit lid="N.00008919.0002001.030"><abb>RNAV</abb> 10 operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00008919.0002001.031"><lit-limit lid="N.00008919.0002001.032"><abb>RNP</abb> 4 operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00008919.0002001.033"><lit-limit lid="N.00008919.0002001.034"><abb>RNP</abb> 2 operations in oceanic and remote continental area
are not permitted.</lit-limit></limit></procbody></procitem><procitem layer="1" lid="N.00008919.0002001.003"><title>During cockpit preparation</title><procbody lid="N.00008919.0002001.004"><ex-conditions lid="N.00008919.0002001.005"><condition at-any-time="false" code="00008919.0002001.001" direct="false" layer="1" lid="N.00008919.0002001.006" subtitle="false" type="cond"><intro>If <abb>FMGC</abb> 1 is affected:</intro><procbody lid="N.00008919.0002001.007"><action layer="1" lid="N.00008919.0002001.008" memory="false"><cr-action code="00008919.0002001.002"><challenge> <tech-label type="cb">AUTO FLT/FMGC/1
(49VU B02 or 121VU M16)</tech-label></challenge><response>Pull</response></cr-action></action><condition at-any-time="false" code="00008919.0002001.003" direct="false" layer="1" lid="N.00008919.0002001.009" subtitle="false" type="cond"><intro>If <if-installed>ADS-B</if-installed> or <if-installed>EHS</if-installed>is required for the intended flight:</intro><procbody lid="N.00008919.0002001.010"><action layer="1" lid="N.00008919.0002001.011" memory="false"><cr-action code="00008919.0002001.004"><challenge><tech-label type="sel">ATC</tech-label></challenge><response>2</response></cr-action></action></procbody></condition></procbody></condition><condition at-any-time="false" code="00008919.0002001.005" direct="false" layer="1" lid="N.00008919.0002001.012" subtitle="false" type="cond"><intro>If <abb>FMGC</abb> 2 is affected: </intro><procbody lid="N.00008919.0002001.013"><action layer="1" lid="N.00008919.0002001.014" memory="false"><cr-action code="00008919.0002001.006"><challenge> <tech-label type="cb">AUTO FLT/FMGC/2
