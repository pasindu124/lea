<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE opsproc PUBLIC "-//AIRBUS OPS//DTD OPSPROC_EXCH-VER10.0//EN" "../DTD/opsproc-exch.dtd">
<opsproc code="00008868.0009001" revdate="2025-11-19T15:05:19"><title>Engine Bleed Air Supply System (non-<abb>ETOPS</abb> flights)</title><procitem layer="1" lid="N.00008868.0009001.001"><title>Flight preparation/limitations</title><procbody lid="N.00008868.0009001.002"><action layer="1" lid="N.00008868.0009001.003" memory="false"><command code="00008868.0009001.001"><para layer="1" lid="N.00008868.0009001.004">The flight crew should take
into account the severity of forecast icing conditions. The wing anti-ice
will be lost if the remaining engine bleed air supply system becomes
inoperative.</para></command></action><condition at-any-time="false" code="00008868.0009001.002" direct="false" layer="1" lid="N.00008868.0009001.005" subtitle="false" type="cond"><intro>If the <if-installed>cargo heating</if-installed> is switched
off:</intro><procbody lid="N.00008868.0009001.006"><action layer="1" lid="N.00008868.0009001.007" memory="false"><command code="00008868.0009001.003"><para layer="1" lid="N.00008868.0009001.008">For live animal transportation,
use the Live Animal Transportation Calculation Tool.</para></command></action></procbody></condition><inform layer="1" lid="N.00008868.0009001.048"><para code="00008868.0009001.022" layer="1" lid="N.00008868.0009001.049">Due to a limitation of the bleed design, the remaining engine bleed
air supply system can supply only one pack, regardless of the wing
anti-ice status.</para></inform><condition at-any-time="false" code="00008868.0009001.054" direct="false" layer="1" lid="N.00008868.0009001.103" subtitle="false" type="cond"><intro>If <abb>ENG</abb> 1 bleed is affected:</intro><procbody lid="N.00008868.0009001.104"><limit layer="1" lid="N.00008868.0009001.120"><lit-limit lid="N.00008868.0009001.121">One engine taxi is not permitted.</lit-limit></limit></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00008868.0009001.009"><title>After engine start</title><procbody lid="N.00008868.0009001.010"><ex-conditions lid="N.00008868.0009001.115"><condition at-any-time="false" code="00008868.0009001.056" direct="false" layer="1" lid="N.00008868.0009001.107" subtitle="false" type="cond"><intro>If two engine taxi at departure:</intro><procbody lid="N.00008868.0009001.108"><action layer="1" lid="N.00008868.0009001.109" memory="false"><cr-action code="00008868.0009001.057"><challenge><tech-label type="pb-sw">ENG BLEED (affected side)</tech-label></challenge><response>OFF</response></cr-action></action><action layer="1" lid="N.00008868.0009001.114" memory="false"><cr-action code="00008868.0009001.061"><challenge><tech-label type="pb-sw">AFT CARGO HOT AIR<if-installed/></tech-label></challenge><response>OFF</response></cr-action></action><condition at-any-time="false" code="00008868.0009001.058" direct="false" layer="1" lid="N.00008868.0009001.110" subtitle="false" type="cond"><intro>If both PACKs are operative:</intro><procbody lid="N.00008868.0009001.111"><action layer="1" lid="N.00008868.0009001.112" memory="false"><cr-action code="00008868.0009001.059"><challenge><tech-label type="pb-sw">PACK (affected side)</tech-label></challenge><response>OFF</response></cr-action></action></procbody></condition><action layer="1" lid="N.00008868.0009001.113" memory="false"><cr-action code="00008868.0009001.060"><challenge><tech-label type="rotsel">X BLEED</tech-label></challenge><response>OPEN</response></cr-action></action></procbody></condition><condition at-any-time="false" code="00008868.0009001.030" direct="false" layer="1" lid="N.00008868.0009001.060" subtitle="false" type="cond"><intro>If one engine taxi at departure:</intro><procbody lid="N.00008868.0009001.061"><condition at-any-time="false" code="00008868.0009001.041" direct="false" layer="1" lid="N.00008868.0009001.079" subtitle="false" type="cond"><intro> If <abb>ENG</abb> 2 bleed is affected:</intro><procbody lid="N.00008868.0009001.080"><condition at-any-time="false" code="00008868.0009001.042" direct="false" layer="1" lid="N.00008868.0009001.081" subtitle="false" type="cond"><intro>After engine 2 start:</intro><procbody lid="N.00008868.0009001.082"><action layer="1" lid="N.00008868.0009001.083" memory="false"><cr-action code="00008868.0009001.043"><challenge><tech-label type="pb-sw">ENG BLEED 2</tech-label></challenge><response>OFF</response></cr-action></action><action layer="1" lid="N.00008868.0009001.116" memory="false"><cr-action code="00008868.0009001.062"><challenge><tech-label type="pb-sw">AFT CARGO
HOT AIR<if-installed/></tech-label></challenge><response>OFF</response></cr-action></action><condition at-any-time="false" code="00008868.0009001.044" direct="false" layer="1" lid="N.00008868.0009001.085" subtitle="false" type="cond"><intro>If both PACKs are operative:</intro><procbody lid="N.00008868.0009001.086"><action layer="1" lid="N.00008868.0009001.087" memory="false"><cr-action code="00008868.0009001.045"><challenge><tech-label type="pb-sw">PACK 2</tech-label></challenge><response>OFF</response></cr-action></action></procbody></condition><action layer="1" lid="N.00008868.0009001.088" memory="false"><cr-action code="00008868.0009001.046"><challenge><tech-label type="rotsel">X BLEED</tech-label></challenge><response>OPEN</response></cr-action></action></procbody></condition></procbody></condition></procbody></condition></ex-conditions></procbody></procitem><procitem layer="1" lid="N.00008868.0009001.020"><title>After takeoff</title><procbody lid="N.00008868.0009001.021"><condition at-any-time="false" code="00008868.0009001.009" direct="false" layer="1" lid="N.00008868.0009001.022" subtitle="false" type="cond"><intro>If the APU has been used to supply the air conditioning during
the takeoff:</intro><procbody lid="N.00008868.0009001.023"><action layer="1" lid="N.00008868.0009001.024" memory="false"><cr-action code="00008868.0009001.010"><challenge><tech-label type="pb-sw">APU BLEED</tech-label></challenge><response>Off</response></cr-action></action></procbody></condition><condition at-any-time="false" code="00008868.0009001.023" direct="false" layer="1" lid="N.00008868.0009001.050" subtitle="false" type="cond"><intro> If takeoff was performed with PACKs OFF and both packs operative:</intro><procbody lid="N.00008868.0009001.051"><action layer="1" lid="N.00008868.0009001.052" memory="false"><cr-action code="00008868.0009001.024"><challenge><tech-label type="pb-sw">PACK (non-affected side)</tech-label></challenge><response>On</response></cr-action></action><action layer="1" lid="N.00008868.0009001.053" memory="false"><command code="00008868.0009001.025"><para layer="1" lid="N.00008868.0009001.054">Disregard <ecam-data ecamimportance="A" type="alert"><ecamsys>AIR</ecamsys><ecamtitle>PACK 1(2) OFF </ecamtitle></ecam-data> alert for the PACK intentionally
kept off.</para></command></action></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00008868.0009001.025"><title>In flight</title><procbody lid="N.00008868.0009001.026"><condition at-any-time="false" code="00008868.0009001.013" direct="false" layer="1" lid="N.00008868.0009001.030" subtitle="false" type="cond"><intro>In the case of failure of the remaining engine bleed air supply
system, or in the case of failure of the associated engine:</intro><procbody lid="N.00008868.0009001.031"><action layer="1" lid="N.00008868.0009001.033" memory="false"><command code="00008868.0009001.014"><para layer="1" lid="N.00008868.0009001.040">Apply the <ecam-data ecamimportance="A" type="alert"><ecamsys>AIR</ecamsys><ecamtitle> ENG 1+2 BLEED FAULT</ecamtitle></ecam-data> <abb>ECAM</abb> procedure.</para><caution code="00008868.0009001.021" layer="1" lid="N.00008868.0009001.047"><para layer="1" lid="N.00008868.0009001.046">Reset <tech-label type="pb-sw">ENG BLEED</tech-label> as requested by <abb>ECAM</abb> procedure even if the <tech-label type="pb-sw">ENG
BLEED</tech-label> is placarded inoperative as per <abb>MMEL</abb> 36-11-01.</para></caution></command></action></procbody></condition><condition at-any-time="false" code="00008868.0009001.018" direct="false" layer="1" lid="N.00008868.0009001.041" subtitle="false" type="cond"><intro>In the case of failure of the opposite PACK:</intro><procbody lid="N.00008868.0009001.042"><action layer="1" lid="N.00008868.0009001.043" memory="false"><cr-action code="00008868.0009001.019"><challenge><tech-label type="pb-sw">PACK (affected side)</tech-label></challenge><response>On</response></cr-action></action></procbody></condition></procbody></procitem></opsproc>