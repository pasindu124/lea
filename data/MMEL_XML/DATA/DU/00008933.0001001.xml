<opsproc code="00008933.0001001" revdate="2016-11-22T18:36:06"><title><abb>IR</abb> 3 (for aircraft without Honeywell 10 MCU <abb>ADIRU</abb> with <abb>IR</abb> 3 totally inoperative)</title><procitem layer="1" lid="N.00008933.0001001.008"><title>Flight preparation/limitations</title><procbody lid="N.00008933.0001001.009"><limit layer="1" lid="N.00008933.0001001.026"><lit-limit lid="N.00008933.0001001.027">For aircraft with the <abb>RNP</abb> <abb>AR</abb> capability, <abb>RNP</abb> <abb>AR</abb> operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00008933.0001001.010"><lit-limit lid="N.00008933.0001001.011">Maximum landing capability is CAT 3 SINGLE.</lit-limit></limit></procbody></procitem><procitem layer="1" lid="N.00008933.0001001.004"><title>During cockpit preparation</title><procbody lid="N.00008933.0001001.005"><action layer="1" lid="N.00008933.0001001.006" memory="false"><cr-action code="00008933.0001001.002"><challenge><tech-label type="sel">IR 3 mode</tech-label></challenge><response>OFF</response></cr-action><comment code="00008933.0001001.003"><note code="00008933.0001001.006" layer="1" lid="N.00008933.0001001.017"><numlist code="00008933.0001001.009" format="NNP" layer="1" lid="N.00008933.0001001.024"><item layer="1"><para layer="1" lid="N.00008933.0001001.021">The <abb>ADR</abb> 3 is consequently set to OFF.</para></item><item layer="1"><para layer="1" lid="N.00008933.0001001.022">The
