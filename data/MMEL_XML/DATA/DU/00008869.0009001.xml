anti-ice status.</para></inform><condition at-any-time="false" code="00008869.0009001.034" direct="false" layer="1" lid="N.00008869.0009001.078" subtitle="false" type="cond"><intro>If <abb>ENG</abb> 1 bleed is affected:</intro><procbody lid="N.00008869.0009001.079"><limit layer="1" lid="N.00008869.0009001.105"><lit-limit lid="N.00008869.0009001.106">One engine taxi is not permitted.</lit-limit></limit></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00008869.0009001.022"><title>After engine start</title><procbody lid="N.00008869.0009001.082"><ex-conditions lid="N.00008869.0009001.102"><condition at-any-time="false" code="00008869.0009001.036" direct="false" layer="1" lid="N.00008869.0009001.083" subtitle="false" type="cond"><intro>If two engine taxi at departure:</intro><procbody lid="N.00008869.0009001.084"><action layer="1" lid="N.00008869.0009001.085" memory="false"><cr-action code="00008869.0009001.037"><challenge><tech-label type="pb-sw">ENG BLEED (affected side)</tech-label></challenge><response>OFF</response></cr-action></action><action layer="1" lid="N.00008869.0009001.086" memory="false"><cr-action code="00008869.0009001.038"><challenge><tech-label type="pb-sw">AFT CARGO HOT AIR<if-installed/></tech-label></challenge><response>OFF</response></cr-action></action><condition at-any-time="false" code="00008869.0009001.039" direct="false" layer="1" lid="N.00008869.0009001.087" subtitle="false" type="cond"><intro>If both PACKs are operative:</intro><procbody lid="N.00008869.0009001.088"><action layer="1" lid="N.00008869.0009001.089" memory="false"><cr-action code="00008869.0009001.040"><challenge><tech-label type="pb-sw">PACK (affected side)</tech-label></challenge><response>OFF</response></cr-action></action></procbody></condition><action layer="1" lid="N.00008869.0009001.090" memory="false"><cr-action code="00008869.0009001.041"><challenge><tech-label type="rotsel">X BLEED</tech-label></challenge><response>OPEN</response></cr-action></action></procbody></condition><condition at-any-time="false" code="00008869.0009001.042" direct="false" layer="1" lid="N.00008869.0009001.091" subtitle="false" type="cond"><intro>If one engine taxi at departure:</intro><procbody lid="N.00008869.0009001.092"><condition at-any-time="false" code="00008869.0009001.043" direct="false" layer="1" lid="N.00008869.0009001.093" subtitle="false" type="cond"><intro> If <abb>ENG</abb> 2 bleed is affected:</intro><procbody lid="N.00008869.0009001.094"><condition at-any-time="false" code="00008869.0009001.044" direct="false" layer="1" lid="N.00008869.0009001.095" subtitle="false" type="cond"><intro>After engine 2 start:</intro><procbody lid="N.00008869.0009001.096"><action layer="1" lid="N.00008869.0009001.097" memory="false"><cr-action code="00008869.0009001.045"><challenge><tech-label type="pb-sw">ENG BLEED 2</tech-label></challenge><response>OFF</response></cr-action></action><action layer="1" lid="N.00008869.0009001.103" memory="false"><cr-action code="00008869.0009001.049"><challenge><tech-label type="pb-sw">AFT CARGO
HOT AIR<if-installed/></tech-label></challenge><response>OFF</response></cr-action></action><condition at-any-time="false" code="00008869.0009001.046" direct="false" layer="1" lid="N.00008869.0009001.098" subtitle="false" type="cond"><intro>If both PACKs are operative:</intro><procbody lid="N.00008869.0009001.099"><action layer="1" lid="N.00008869.0009001.100" memory="false"><cr-action code="00008869.0009001.047"><challenge><tech-label type="pb-sw">PACK 2</tech-label></challenge><response>OFF</response></cr-action></action></procbody></condition><action layer="1" lid="N.00008869.0009001.101" memory="false"><cr-action code="00008869.0009001.048"><challenge><tech-label type="rotsel">X BLEED</tech-label></challenge><response>OPEN</response></cr-action></action></procbody></condition></procbody></condition></procbody></condition></ex-conditions></procbody></procitem><procitem layer="1" lid="N.00008869.0009001.029"><title>Before takeoff</title><procbody lid="N.00008869.0009001.030"><action layer="1" lid="N.00008869.0009001.068" memory="false"><cr-action code="00008869.0009001.010"><challenge><tech-label type="pb-sw">APU MASTER SW</tech-label></challenge><response>ON</response></cr-action></action><action layer="1" lid="N.00008869.0009001.069" memory="false"><cr-action code="00008869.0009001.027"><challenge><tech-label type="pb-sw">APU START</tech-label></challenge><response>ON</response></cr-action></action></procbody></procitem><procitem layer="1" lid="N.00008869.0009001.036"><title>After takeoff</title><procbody lid="N.00008869.0009001.037"><condition at-any-time="false" code="00008869.0009001.033" direct="false" layer="1" lid="N.00008869.0009001.077" subtitle="false" type="cond"><intro>If the APU has been used to supply the air conditioning during
the takeoff:</intro><procbody lid="N.00008869.0009001.039"><action layer="1" lid="N.00008869.0009001.040" memory="false"><cr-action code="00008869.0009001.032"><challenge><tech-label type="pb-sw">APU BLEED</tech-label></challenge><response>Off</response></cr-action></action></procbody></condition><condition at-any-time="false" code="00008869.0009001.029" direct="false" layer="1" lid="N.00008869.0009001.072" subtitle="false" type="cond"><intro> If takeoff was performed with PACKs OFF and both packs operative:</intro><procbody lid="N.00008869.0009001.073"><action layer="1" lid="N.00008869.0009001.074" memory="false"><cr-action code="00008869.0009001.030"><challenge><tech-label type="pb-sw">PACK (non-affected side)</tech-label></challenge><response>On</response></cr-action></action><action layer="1" lid="N.00008869.0009001.075" memory="false"><command code="00008869.0009001.031"><para layer="1" lid="N.00008869.0009001.076">Disregard <ecam-data ecamimportance="A" type="alert"><ecamsys>AIR</ecamsys><ecamtitle>PACK 1(2) OFF </ecamtitle></ecam-data> alert for the PACK intentionally
kept off.</para></command></action></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00008869.0009001.053"><title>In flight</title><procbody lid="N.00008869.0009001.054"><condition at-any-time="false" code="00008869.0009001.019" direct="false" layer="1" lid="N.00008869.0009001.055" subtitle="false" type="cond"><intro>In the case of failure of the remaining engine bleed air supply
system, or in the case of failure of the associated engine:</intro><procbody lid="N.00008869.0009001.056"><action layer="1" lid="N.00008869.0009001.058" memory="false"><command code="00008869.0009001.020"><para layer="1" lid="N.00008869.0009001.059">Apply the <ecam-data ecamimportance="A" type="alert"><ecamsys>AIR</ecamsys><ecamtitle> ENG 1+2 BLEED FAULT</ecamtitle></ecam-data> <abb>ECAM</abb> procedure.</para><caution code="00008869.0009001.025" layer="1" lid="N.00008869.0009001.066"><para layer="1" lid="N.00008869.0009001.067">Reset <tech-label type="pb-sw">ENG BLEED</tech-label> as requested by <abb>ECAM</abb> procedure even if the <tech-label type="pb-sw">ENG
BLEED</tech-label> is placarded inoperative as per <abb>MMEL</abb> 36-11-01.</para></caution></command></action></procbody></condition><condition at-any-time="false" code="00008869.0009001.051" direct="false" layer="1" lid="N.00008869.0009001.104" subtitle="false" type="cond"><intro>In the case of failure of the opposite PACK:</intro><procbody lid="N.00008869.0009001.061"><action layer="1" lid="N.00008869.0009001.062" memory="false"><cr-action code="00008869.0009001.050"><challenge><tech-label type="pb-sw">PACK (affected side)</tech-label></challenge><response>On</response></cr-action></action></procbody></condition></procbody></procitem></opsproc>