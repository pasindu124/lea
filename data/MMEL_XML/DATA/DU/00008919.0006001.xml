<opsproc code="00008919.0006001" revdate="2024-07-22T17:03:38"><title>Flight Management and Guidance Computer (FMGC)</title><procitem layer="1" lid="N.00008919.0006001.001"><title>Flight preparation/Limitations</title><procbody lid="N.00008919.0006001.002"><limit layer="1" lid="N.00008919.0006001.003"><lit-limit lid="N.00008919.0006001.004">Maximum landing capability is CAT 3 SINGLE.</lit-limit></limit><limit layer="1" lid="N.00008919.0006001.005"><lit-limit lid="N.00008919.0006001.006">For aircraft with the <abb>RNP</abb> <abb>AR</abb> capability, <abb>RNP</abb> <abb>AR</abb> operations are not permitted.</lit-limit></limit><condition at-any-time="false" code="00008919.0006001.003" direct="false" layer="1" lid="N.00008919.0006001.007" subtitle="false" type="cond"><intro>If the BACK/UP <abb>NAV</abb> function is inoperative:</intro><procbody lid="N.00008919.0006001.008"><limit layer="1" lid="N.00008919.0006001.009"><lit-limit lid="N.00008919.0006001.010"><abb>RNAV</abb> 10 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00008919.0006001.011"><lit-limit lid="N.00008919.0006001.012"><abb>RNP</abb> 4 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00008919.0006001.013"><lit-limit lid="N.00008919.0006001.014"><abb>RNP</abb> 2 operations
in oceanic and remote continental area are not permitted.</lit-limit></limit></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00008919.0006001.015"><title>During cockpit preparation</title><procbody lid="N.00008919.0006001.016"><action layer="1" lid="N.00008919.0006001.040" memory="false"><cr-action code="00008919.0006001.023"><challenge> <tech-label type="cb">AUTO FLT/FMGC/2 (121VU
