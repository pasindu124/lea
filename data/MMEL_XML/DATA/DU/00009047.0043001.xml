e" system="SI and derived" unit="kg">400</measure> (<measure category="Weight" show-unit="true" system="US" unit="lb">890</measure>) when <abb>OAT</abb> ≤ <abb>ISA</abb> + <measure category="Temperature" show-unit="true" system="SI and derived" unit="°C">5</measure></lit-limit></limit><limit layer="1" lid="N.00009047.0043001.109"><lit-limit lid="N.00009047.0043001.110"><measure category="Weight" show-unit="true" system="SI and derived" unit="kg">3100</measure> (<measure category="Weight" show-unit="true" system="US" unit="lb">6840</measure>) when <abb>OAT</abb> &gt; <abb>ISA</abb> + <measure category="Temperature" show-unit="true" system="SI and derived" unit="°C">5</measure></lit-limit></limit></procbody></condition></ex-conditions></relevant-sub-proc></procbody></procitem><procitem layer="1" lid="N.00009047.0043001.111"><title>During cockpit preparation</title><procbody lid="N.00009047.0043001.112"><condition at-any-time="false" code="00009047.0043001.043" direct="false" layer="1" lid="N.00009047.0043001.113" subtitle="false" type="cond"><intro>After application of the maintenance procedure:</intro><procbody lid="N.00009047.0043001.114"><action layer="1" lid="N.00009047.0043001.115" memory="false"><command code="00009047.0043001.044"><para layer="1" lid="N.00009047.0043001.116">On the <tech-label type="s-page">BLEED</tech-label>, check that the anti-ice arrow symbol is displayed.</para></command><comment code="00009047.0043001.045"><para layer="1" lid="N.00009047.0043001.117">The anti-ice arrow
symbol may be displayed amber or green.</para></comment></action><inform layer="1" lid="N.00009047.0043001.118"><para code="00009047.0043001.046" layer="1" lid="N.00009047.0043001.119">The <ecam-data ecamimportance="A" type="alert"><ecamsys>WING A.ICE</ecamsys><ecamtitle>L(R) HI PR</ecamtitle></ecam-data> alert must not be displayed on the <abb>EWD</abb>.</para></inform></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00009047.0043001.120"><title>Before engine start</title><procbody lid="N.00009047.0043001.121"><action-block lid="N.00009047.0043001.122"><action layer="1" lid="N.00009047.0043001.123" memory="false"><command code="00009047.0043001.047"><para layer="1" lid="N.00009047.0043001.124">Maintain the <tech-label type="sel">X BLEED</tech-label> at SHUT before engine start when the <abb>APU</abb> bleed is used.</para></command></action><action layer="1" lid="N.00009047.0043001.125" memory="false"><command code="00009047.0043001.048"><para layer="1" lid="N.00009047.0043001.126">Start the engine 1.</para></command><comment code="00009047.0043001.049"><para layer="1" lid="N.00009047.0043001.127">Maintain the X BLEED
selector at SHUT during the start of engine 1.</para></comment></action><action layer="1" lid="N.00009047.0043001.128" memory="false"><command code="00009047.0043001.050"><para layer="1" lid="N.00009047.0043001.129">Use the CROSS BLEED ENGINE START
(<duref product="FCOM" ref="00020860"/>) procedure to start
the engine 2.</para></command></action><action layer="1" lid="N.00009047.0043001.130" memory="false"><command code="00009047.0043001.051"><para layer="1" lid="N.00009047.0043001.131">Apply the procedure associated
with the <ecam-data ecamimportance="A" type="alert"><ecamsys>WING
A.ICE</ecamsys><ecamtitle>R VALVE OPEN</ecamtitle></ecam-data> alert displayed on the <abb>EWD</abb>.</para></command></action></action-block></procbody></procitem><procitem layer="1" lid="N.00009047.0043001.132"><title>After takeoff</title><procbody lid="N.00009047.0043001.133"><condition at-any-time="false" code="00009047.0043001.052" direct="false" layer="1" lid="N.00009047.0043001.134" subtitle="false" type="cond"><intro>When above <measure category="Length" show-unit="true" system="US" unit="ft">1500</measure>:</intro><procbody lid="N.00009047.0043001.135"><action layer="1" lid="N.00009047.0043001.136" memory="false"><command code="00009047.0043001.053"><para layer="1" lid="N.00009047.0043001.137">Apply the automatic
recall of the <ecam-data ecamimportance="A" type="alert"><ecamsys>WING A.ICE</ecamsys><ecamtitle>R VALVE OPEN</ecamtitle></ecam-data> procedure displayed on the <abb>EWD</abb>.</para></command></action></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00009047.0043001.138"><title>In Flight</title><procbody lid="N.00009047.0043001.139"><inform layer="1" lid="N.00009047.0043001.140"><para code="00009047.0043001.054" layer="1" lid="N.00009047.0043001.141">If the
wing anti ice is operated in flight, <ecam-data ecamimportance="A" type="alert"><ecamsys>WING A.ICE</ecamsys><ecamtitle>R HI
PR</ecamtitle></ecam-data> alert may be displayed on the <abb>EWD</abb>.</para></inform><condition at-any-time="false" code="00009047.0043001.058" direct="false" layer="1" lid="N.00009047.0043001.149" subtitle="false" type="cond"><intro>In the case of failure of a Bleed Air Supply System:</intro><procbody lid="N.00009047.0043001.150"><condition at-any-time="false" code="00009047.0043001.059" direct="false" layer="1" lid="N.00009047.0043001.151" subtitle="false" type="cond"><intro>If both PACKs are operative:</intro><procbody lid="N.00009047.0043001.152"><action layer="1" lid="N.00009047.0043001.153" memory="false"><cr-action code="00009047.0043001.060"><challenge><tech-label type="pb-sw">PACK (affected
side)</tech-label></challenge><response>OFF</response></cr-action></action></procbody></condition></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00009047.0043001.145"><title>After landing</title><procbody lid="N.00009047.0043001.146"><action layer="1" lid="N.00009047.0043001.147" memory="false"><command code="00009047.0043001.057"><para layer="1" lid="N.00009047.0043001.148">Apply the automatic recall of
the <ecam-data ecamimportance="A" type="alert"><ecamsys>WING A.ICE</ecamsys><ecamtitle>R VALVE OPEN</ecamtitle></ecam-data> procedure displayed
on the <abb>EWD</abb>.</para></command></action></procbody></procitem></opsproc>