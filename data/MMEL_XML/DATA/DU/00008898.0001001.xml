<opsproc code="00008898.0001001" revdate="2018-02-15T09:21:21"><title>Flight Director (<abb>FD</abb>)</title><procitem layer="1" lid="N.00008898.0001001.010"><title>FLIGHT PREPARATION/LIMITATIONS</title><procbody lid="N.00008898.0001001.011"><limit layer="1" lid="N.00008898.0001001.012"><lit-limit lid="N.00008898.0001001.013">For aircraft with the <abb>RNP</abb> <abb>AR</abb> capability, <abb>RNP</abb> <abb>AR</abb> operations are not permitted.</lit-limit></limit><condition at-any-time="false" code="00008898.0001001.005" direct="false" layer="1" lid="N.00008898.0001001.014" subtitle="false" type="cond"><intro>If both sides are affected:</intro><procbody lid="N.00008898.0001001.015"><limit layer="1" lid="N.00008898.0001001.028"><lit-limit lid="N.00008898.0001001.029"><abb>RNAV</abb> 1 / <abb>RNAV</abb> 2 operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00008898.0001001.026"><lit-limit lid="N.00008898.0001001.027"><abb>RNP</abb> 1 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00008898.0001001.020"><lit-limit lid="N.00008898.0001001.021"><abb>RNP</abb> <abb>APCH</abb> operations are not permitted.</lit-limit></limit></procbody></condition><condition at-any-time="false" code="00008898.0001001.009" direct="false" layer="1" lid="N.00008898.0001001.022" subtitle="false" type="cond"><intro>If the <abb>PF</abb> side is affected:</intro><procbody lid="N.00008898.0001001.023"><limit layer="1" lid="N.00008898.0001001.024"><lit-limit lid="N.00008898.0001001.025"><abb>RNP</abb> <abb>APCH</abb> operations are not permitted.</lit-limit></limit></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00008898.0001001.009"><title>For takeoff</title><procbody lid="N.00008898.0001001.001"><condition at-any-time="false" code="00008898.0001001.002" direct="false" layer="1" lid="N.00008898.0001001.005" subtitle="false" type="cond"><intro>For a takeoff without <abb>FD</abb>s: </intro><procbody lid="N.00008898.0001001.006"><action layer="1" lid="N.00008898.0001001.007" memory="false"><command code="00008898.0001001.003"><para layer="1" lid="N.00008898.0001001.008"><duref product="FCOM" ref="00003986"/>.</para></command></action></procbody></condition></procbody></procitem></opsproc>