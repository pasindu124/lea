<opsproc code="00023760.0002001" revdate="2020-02-18T15:12:19"><title><if-installed>Global Positioning System (GPS)</if-installed> (Aircraft with ADS-B OUT capability)</title><procitem layer="1" lid="N.00023760.0002001.019"><title>FLIGHT PREPARATION/LIMITATIONS</title><procbody lid="N.00023760.0002001.020"><condition at-any-time="false" code="00023760.0002001.009" direct="false" layer="1" lid="N.00023760.0002001.021" subtitle="false" type="cond"><intro>If one <abb>GPS</abb> is inoperative:</intro><procbody lid="N.00023760.0002001.022"><limit layer="1" lid="N.00023760.0002001.023"><lit-limit lid="N.00023760.0002001.024">For aircraft with <abb>RNP</abb> <abb>AR</abb> capability, <abb>RNP</abb> <abb>AR</abb> operations
are not permitted.</lit-limit></limit></procbody></condition><condition at-any-time="false" code="00023760.0002001.011" direct="false" layer="1" lid="N.00023760.0002001.025" subtitle="false" type="cond"><intro>If both <abb>GPS</abb> are inoperative and both <abb>ILS</abb> operative:</intro><procbody lid="N.00023760.0002001.026"><limit layer="1" lid="N.00023760.0002001.027"><lit-limit lid="N.00023760.0002001.028"><abb>RNAV</abb> 10 operations
requiring one <abb>GPS</abb> are not permitted.</lit-limit></limit><inform layer="1" lid="N.00023760.0002001.029"><para code="00023760.0002001.013" layer="1" lid="N.00023760.0002001.030"><abb>RNAV</abb> 5 operations are permitted provided that one <abb>DME</abb> receiver is operative.</para></inform><inform layer="1" lid="N.00023760.0002001.031"><para code="00023760.0002001.014" layer="1" lid="N.00023760.0002001.032"><abb>RNAV</abb> 1/<abb> RNAV</abb> 2 operations are permitted provided
that one <abb>DME</abb> receiver is operative.</para></inform><limit layer="1" lid="N.00023760.0002001.033"><lit-limit lid="N.00023760.0002001.034"><abb>RNP</abb> 4 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00023760.0002001.035"><lit-limit lid="N.00023760.0002001.036"><abb>RNP</abb> 2 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00023760.0002001.037"><lit-limit lid="N.00023760.0002001.038"><abb>RNP</abb> 1 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00023760.0002001.039"><lit-limit lid="N.00023760.0002001.040"><abb>RNP</abb> <abb>APCH</abb> operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00023760.0002001.041"><lit-limit lid="N.00023760.0002001.042">For aircraft with <abb>RNP</abb> <abb>AR</abb> capability, <abb>RNP</abb> <abb>AR</abb> operations
are not permitted.</lit-limit></limit></procbody></condition><condition at-any-time="false" code="00023760.0002001.020" direct="false" layer="1" lid="N.00023760.0002001.043" subtitle="false" type="cond"><intro>If both <abb>GPS</abb> are inoperative and one or both <abb>ILS</abb> inoperative:</intro><procbody lid="N.00023760.0002001.044"><inform layer="1" lid="N.00023760.0002001.045"><para code="00023760.0002001.021" layer="1" lid="N.00023760.0002001.046">Forecast weather conditions at the destination or alternate must
allow an approach with visual references to be conducted from the
relevant safety altitude.</para></inform><limit layer="1" lid="N.00023760.0002001.047"><lit-limit lid="N.00023760.0002001.048"><abb>RNAV</abb> 10 operations
requiring one <abb>GPS</abb> are not permitted.</lit-limit></limit><inform layer="1" lid="N.00023760.0002001.049"><para code="00023760.0002001.023" layer="1" lid="N.00023760.0002001.050"><abb>RNAV</abb> 5 operations are permitted provided that one <abb>DME</abb> receiver is operative.</para></inform><inform layer="1" lid="N.00023760.0002001.051"><para code="00023760.0002001.024" layer="1" lid="N.00023760.0002001.052"><abb>RNAV</abb> 1/<abb> RNAV</abb> 2 operations are permitted provided
that one <abb>DME</abb> receiver is operative.</para></inform><limit layer="1" lid="N.00023760.0002001.053"><lit-limit lid="N.00023760.0002001.054"><abb>RNP</abb> 4 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00023760.0002001.055"><lit-limit lid="N.00023760.0002001.056"><abb>RNP</abb> 2 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00023760.0002001.057"><lit-limit lid="N.00023760.0002001.058"><abb>RNP</abb> 1 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00023760.0002001.059"><lit-limit lid="N.00023760.0002001.060"><abb>RNP</abb> <abb>APCH</abb> operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00023760.0002001.061"><lit-limit lid="N.00023760.0002001.062">For aircraft with <abb>RNP</abb> <abb>AR</abb> capability, <abb>RNP</abb> <abb>AR</abb> operations
are not permitted.</lit-limit></limit></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00023760.0002001.063"><title>During Cockpit Preparation</title><procbody lid="N.00023760.0002001.064"><condition at-any-time="false" code="00023760.0002001.034" direct="false" layer="1" lid="N.00023760.0002001.073" subtitle="false" type="cond"><intro>If one <abb>GPS</abb> is inoperative: </intro><procbody lid="N.00023760.0002001.074"><condition at-any-time="false" code="00023760.0002001.039" direct="false" layer="1" lid="N.00023760.0002001.082" subtitle="false" type="cond"><intro>If <abb>ADS-B</abb> OUT is required for the intended route:</intro><procbody lid="N.00023760.0002001.083"><ex-conditions lid="N.00023760.0002001.089"><condition at-any-time="false" code="00023760.0002001.040" direct="false" layer="1" lid="N.00023760.0002001.086" subtitle="false" type="cond"><intro>When <if-installed><abb>GPS</abb> 1</if-installed> is inoperative:</intro><procbody lid="N.00023760.0002001.087"><action layer="1" lid="N.00023760.0002001.078" memory="false"><cr-action code="00023760.0002001.036"><challenge><tech-label type="sel">ATC</tech-label></challenge><response>2</response></cr-action></action></procbody></condition><condition at-any-time="false" code="00023760.0002001.041" direct="false" layer="1" lid="N.00023760.0002001.088" subtitle="false" type="cond"><intro>When <if-installed><abb>GPS</abb> 2</if-installed> is inoperative:</intro><procbody lid="N.00023760.0002001.080"><action layer="1" lid="N.00023760.0002001.081" memory="false"><cr-action code="00023760.0002001.038"><challenge><tech-label type="sel">ATC</tech-label></challenge><response>1</response></cr-action></action></procbody></condition></ex-conditions></procbody></condition></procbody></condition><condition at-any-time="false" code="00023760.0002001.030" direct="false" layer="1" lid="N.00023760.0002001.065" subtitle="false" type="cond"><intro>If both <abb>GPS</abb> are inoperative and one or both <abb>ILS</abb> inoperative:</intro><procbody lid="N.00023760.0002001.066"><inform layer="1" lid="N.00023760.0002001.067"><para code="00023760.0002001.031" layer="1" lid="N.00023760.0002001.068">Tune manually <abb>VOR</abb> 1 and <abb>VOR</abb> 2 (less than <measure category="Length" show-unit="true" system="Other" unit="NM">200</measure> from current position) on the <abb>MCDU</abb> RAD NAV page.</para><para code="00023760.0002001.042" layer="1" lid="N.00023760.0002001.091">Check the <abb>ND</abb> for <emph bold="false" color="Red" italic="false" overline="false" sub="false" sup="false" underline="false">VOR 1</emph> and <emph bold="false" color="Red" italic="false" overline="false" sub="false" sup="false" underline="false">VOR 2</emph> flags:</para></inform><condition at-any-time="false" code="00023760.0002001.032" direct="false" layer="1" lid="N.00023760.0002001.069" subtitle="false" type="cond"><intro>If both <emph bold="false" color="Red" italic="false" overline="false" sub="false" sup="false" underline="false">VOR 1</emph> and <emph bold="false" color="Red" italic="false" overline="false" sub="false" sup="false" underline="false">VOR 2</emph> flags are displayed
on the <abb>ND</abb>:</intro><procbody lid="N.00023760.0002001.070"><limit layer="1" lid="N.00023760.0002001.071"><lit-limit lid="N.00023760.0002001.072">The aircraft dispatch is not
permitted.</lit-limit></limit></procbody></condition></procbody></condition></procbody></procitem></opsproc>