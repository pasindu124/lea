<opsproc code="00009074.0001001" revdate="2010-09-17T10:25:21"><title>Elevator Position Indication on the <tech-label type="s-page">F/CTL</tech-label></title><procitem layer="1" lid="N.00009074.0001001.004"><title>During cockpit preparation</title><procdesc code="00009074.0001001.030" lid="N.00009074.0001001.063"><note code="00009074.0001001.031" layer="1" lid="N.00009074.0001001.064"><unlist bulltype="NDASH" code="00009074.0001001.032" layer="1" lid="N.00009074.0001001.065"><para layer="1" lid="N.00009074.0001001.066">If the Yellow Electric
Pump is not available:</para><item layer="1"><unlist bulltype="BULLET" code="00009074.0001001.033" layer="1" lid="N.00009074.0001001.067"><para layer="1" lid="N.00009074.0001001.068">Pressurize the Yellow Hydraulic
System with:</para><item layer="1"><para layer="1" lid="N.00009074.0001001.069">A Ground cart,
or with</para></item><item layer="1"><para layer="1" lid="N.00009074.0001001.070">The Yellow Engine
2 Pump with the Engine 2 running.</para></item></unlist></item><item layer="1"><para layer="1" lid="N.00009074.0001001.071">Replace any
action on the <tech-label type="pb-sw">YELLOW ELEC PUMP</tech-label> by a similar action
on the Ground Cart or on the <tech-label type="pb-sw">YELLOW ENG 2 PUMP</tech-label> in the
following procedure.</para></item></unlist></note></procdesc><procbody lid="N.00009074.0001001.005"><action-block lid="N.00009074.0001001.012"><title><emph bold="false" italic="false" overline="false" sub="false" sup="false" underline="true">Check of the elevator control</emph>:</title><action layer="1" lid="N.00009074.0001001.013" memory="false"><cr-action code="00009074.0001001.004"><challenge><tech-label type="pb-sw">YELLOW ELEC PUMP</tech-label></challenge><response>ON</response></cr-action></action><action layer="1" lid="N.00009074.0001001.014" memory="false"><cr-action code="00009074.0001001.005"><challenge><tech-label type="pb-sw">PTU</tech-label></challenge><response>AUTO</response></cr-action></action><action layer="1" lid="N.00009074.0001001.015" memory="false"><cr-action code="00009074.0001001.006"><challenge><tech-label type="pb-sw">BLUE ELEC PUMP</tech-label></challenge><response>AUTO</response></cr-action></action><action layer="1" lid="N.00009074.0001001.016" memory="false"><cr-action code="00009074.0001001.007"><challenge><tech-label type="pb">BLUE PUMP OVRD</tech-label></challenge><response>ON</response></cr-action></action><action layer="1" lid="N.00009074.0001001.051" memory="false"><command code="00009074.0001001.023"><para layer="1" lid="N.00009074.0001001.052">Establish communication with
the ground crew.</para></command></action><action layer="1" lid="N.00009074.0001001.023" memory="false"><command code="00009074.0001001.011"><para layer="1" lid="N.00009074.0001001.024">Move the <abb>CAPT</abb> or
the <abb>F/O</abb> stick to the maximum nose down position.</para></command></action><action layer="1" lid="N.00009074.0001001.025" memory="false"><command code="00009074.0001001.012"><para layer="1" lid="N.00009074.0001001.026">Visually check that both elevators
move down.</para></command></action><action layer="1" lid="N.00009074.0001001.053" memory="false"><command code="00009074.0001001.024"><para layer="1" lid="N.00009074.0001001.054">Move the <abb>CAPT</abb> or
the <abb>F/O</abb> stick to the maximum nose up position.</para></command></action><action layer="1" lid="N.00009074.0001001.055" memory="false"><command code="00009074.0001001.025"><para layer="1" lid="N.00009074.0001001.056">Visually check that both elevators
move up.</para></command></action><action layer="1" lid="N.00009074.0001001.057" memory="false"><command code="00009074.0001001.026"><para layer="1" lid="N.00009074.0001001.058">Move the <abb>CAPT</abb> or
the <abb>F/O</abb> stick to the neutral position.</para></command></action><action layer="1" lid="N.00009074.0001001.059" memory="false"><command code="00009074.0001001.027"><para layer="1" lid="N.00009074.0001001.060">Visually check
that both elevators go back to the neutral position.</para></command></action><action layer="1" lid="N.00009074.0001001.048" memory="false"><cr-action code="00009074.0001001.020"><challenge><tech-label type="pb-sw">YELLOW ELEC PUMP</tech-label></challenge><response>Off</response></cr-action></action><action layer="1" lid="N.00009074.0001001.049" memory="false"><cr-action code="00009074.0001001.021"><challenge><tech-label type="pb-sw">BLUE PUMP OVRD</tech-label></challenge><response>Off</response></cr-action></action></action-block></procbody></procitem></opsproc>