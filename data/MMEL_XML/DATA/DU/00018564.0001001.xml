<opsproc code="00018564.0001001" revdate="2025-11-19T15:03:39"><title><abb>APU</abb> Bleed Valve (Inoperative in the open position)</title><procitem layer="1" lid="N.00018564.0001001.001"><title>GENERAL INFORMATION</title><procbody lid="N.00018564.0001001.002"><inform layer="1" lid="N.00018564.0001001.003"><para code="00018564.0001001.002" layer="1" lid="N.00018564.0001001.005"><abb>APU</abb> bleed air will be available for Main Engine Start (<abb>MES</abb>) or air conditioning only on GROUND.</para></inform></procbody></procitem><procitem layer="1" lid="N.00018564.0001001.007"><title>ON GROUND</title><procbody lid="N.00018564.0001001.008"><inform layer="1" lid="N.00018564.0001001.020"><para code="00018564.0001001.011" layer="1" lid="N.00018564.0001001.021">To prevent the <abb>ECAM</abb> alert <ecam-data ecamimportance="A" type="alert"><ecamsys>AIR</ecamsys><ecamtitle>APU BLEED FAULT</ecamtitle></ecam-data> from triggering,
the <tech-label type="pb-sw">APU BLEED</tech-label> must be selected in accordance with the <abb>APU</abb> state:</para></inform><condition at-any-time="false" code="00018564.0001001.003" direct="false" layer="1" lid="N.00018564.0001001.009" subtitle="false" type="cond"><intro>When the <abb>APU</abb> runs:</intro><procbody lid="N.00018564.0001001.010"><action layer="1" lid="N.00018564.0001001.011" memory="false"><cr-action code="00018564.0001001.004"><challenge><tech-label type="pb-sw">APU BLEED</tech-label></challenge><response>ON</response></cr-action></action></procbody></condition><condition at-any-time="false" code="00018564.0001001.006" direct="false" layer="1" lid="N.00018564.0001001.013" subtitle="false" type="cond"><intro>When the <abb>APU</abb> shuts down:</intro><procbody lid="N.00018564.0001001.014"><action layer="1" lid="N.00018564.0001001.015" memory="false"><cr-action code="00018564.0001001.007"><challenge><tech-label type="pb-sw">APU BLEED</tech-label></challenge><response>Off</response></cr-action></action></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00018564.0001001.016"><title>BEFORE TAKEOFF</title><procbody lid="N.00018564.0001001.017"><action layer="1" lid="N.00018564.0001001.018" memory="false"><cr-action code="00018564.0001001.009"><challenge><tech-label type="pb-sw">APU BLEED</tech-label></challenge><response>Off</response></cr-action></action><action layer="1" lid="N.00018564.0001001.019" memory="false"><cr-action code="00018564.0001001.010"><challenge><tech-label type="pb-sw">APU MASTER</tech-label></challenge><response>Off</response></cr-action></action></procbody></procitem></opsproc>