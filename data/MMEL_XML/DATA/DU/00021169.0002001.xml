<opsproc code="00021169.0002001" revdate="2018-04-05T16:28:12"><title>Angle of Attack (<abb>AOA</abb>) Probes Heating (CAPT inoperative)</title><procitem layer="1" lid="N.00021169.0002001.001"><title>DURING COCKPIT PREPARATION</title><procbody lid="N.00021169.0002001.002"><inform layer="1" lid="N.00021169.0002001.003"><para code="00021169.0002001.001" layer="1" lid="N.00021169.0002001.004">Disregard and clear the <tech-label type="ecamsys">ANTI ICE</tech-label> CAPT <abb>AOA </abb> alert associated with the
CAPT <abb>AOA</abb> probes heating inoperative for dispatch.</para></inform></procbody></procitem><procitem layer="1" lid="N.00021169.0002001.005"><title>IN FLIGHT</title><procbody lid="N.00021169.0002001.006"><ex-conditions lid="N.00021169.0002001.022"><condition at-any-time="false" code="00021169.0002001.006" direct="false" layer="1" lid="N.00021169.0002001.014" subtitle="false" type="cond"><intro>In the case of failure of the <abb>F/O</abb> alpha probe heater:</intro><procbody lid="N.00021169.0002001.015"><action layer="1" lid="N.00021169.0002001.016" memory="false"><command code="00021169.0002001.007"><para layer="1" lid="N.00021169.0002001.017">Apply <ecam-data ecamimportance="A" type="alert"><ecamsys>ANTI ICE</ecamsys><ecamtitle>CAPT+F/O AOA</ecamtitle></ecam-data> <abb>ECAM</abb> procedure.</para></command></action></procbody></condition><condition at-any-time="false" code="00021169.0002001.008" direct="false" layer="1" lid="N.00021169.0002001.018" subtitle="false" type="cond"><intro>In the case of failure of the <abb>STBY</abb> alpha probe heater:</intro><procbody lid="N.00021169.0002001.019"><action layer="1" lid="N.00021169.0002001.020" memory="false"><command code="00021169.0002001.009"><para layer="1" lid="N.00021169.0002001.021">Apply <ecam-data ecamimportance="A" type="alert"><ecamsys>ANTI ICE</ecamsys><ecamtitle>CAPT+STBY AOA</ecamtitle></ecam-data> <abb>ECAM</abb> procedure.</para></command></action></procbody></condition></ex-conditions></procbody></procitem></opsproc>