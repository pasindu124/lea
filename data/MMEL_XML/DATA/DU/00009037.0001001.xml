<opsproc code="00009037.0001001" revdate="2020-05-13T11:32:37"><title>NDU 2</title><procitem layer="1" lid="N.00009037.0001001.013"><title>Flight preparation/Limitations</title><procbody lid="N.00009037.0001001.014"><limit layer="1" lid="N.00009037.0001001.017"><lit-limit lid="N.00009037.0001001.018">For aircraft with the <abb>RNP</abb> <abb>AR</abb> capability, <abb>RNP</abb> <abb>AR</abb> operations are not permitted.</lit-limit></limit><condition at-any-time="false" code="00009037.0001001.017" direct="false" layer="1" lid="N.00009037.0001001.035" subtitle="false" type="cond"><intro>If the <abb>PM</abb> side is affected:</intro><procbody lid="N.00009037.0001001.036"><action layer="1" lid="N.00009037.0001001.037" memory="false"><command code="00009037.0001001.018"><para layer="1" lid="N.00009037.0001001.038">To perform <abb>RNP
APCH</abb>, <abb>RNAV</abb> 10, <abb>RNAV</abb> 5, <abb>RNAV</abb> 1 / <abb>RNAV</abb> 2, <abb>RNP</abb> 4, <abb>RNP</abb> 2 and <abb>RNP</abb> 1 operations, use the <tech-label type="pb">PFD/ND XFR</tech-label> to temporary
display <abb>ND</abb> information on the operative <abb>DU</abb>.</para></command></action></procbody></condition><condition at-any-time="false" code="00009037.0001001.006" direct="false" layer="1" lid="N.00009037.0001001.019" subtitle="false" type="cond"><intro>If the <abb>PF</abb> side is affected:</intro><procbody lid="N.00009037.0001001.020"><limit layer="1" lid="N.00009037.0001001.021"><lit-limit lid="N.00009037.0001001.022"><abb>RNP</abb> <abb>APCH</abb> operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00009037.0001001.023"><lit-limit lid="N.00009037.0001001.024"><abb>RNAV</abb> 10 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00009037.0001001.025"><lit-limit lid="N.00009037.0001001.026"><abb>RNAV</abb> 5 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00009037.0001001.027"><lit-limit lid="N.00009037.0001001.028"><abb>RNAV</abb> 1 / <abb>RNAV</abb> 2 operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00009037.0001001.029"><lit-limit lid="N.00009037.0001001.030"><abb>RNP</abb> 4 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00009037.0001001.033"><lit-limit lid="N.00009037.0001001.034"><abb>RNP</abb> 2 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00009037.0001001.031"><lit-limit lid="N.00009037.0001001.032"><abb>RNP</abb> 1 operations
are not permitted.</lit-limit></limit></procbody></condition><limit layer="1" lid="N.00009037.0001001.015"><lit-limit lid="N.00009037.0001001.016">Maximum landing capability is <abb>CAT</abb> 2.</lit-limit></limit></procbody></procitem><procitem layer="1" lid="N.00009037.0001001.010"><title>On ground or in flight</title><procbody lid="N.00009037.0001001.011"><action layer="1" lid="N.00009037.0001001.012" memory="false"><cr-action code="00009037.0001001.003"><challenge><tech-label type="knob">NDU 2</tech-label></challenge><response>OFF</response></cr-action></action></procbody></procitem></opsproc>