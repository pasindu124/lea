<opsproc code="00009077.0001001" revdate="2010-09-17T10:37:13"><title>Spoilers/Speedbrakes Indication on the <tech-label type="s-page">F/CTL</tech-label></title><procitem layer="1" lid="N.00009077.0001001.004"><title>During cockpit preparation</title><procdesc code="00009077.0001001.028" lid="N.00009077.0001001.042"><note code="00009077.0001001.029" layer="1" lid="N.00009077.0001001.043"><unlist bulltype="NDASH" code="00009077.0001001.030" layer="1" lid="N.00009077.0001001.044"><para layer="1" lid="N.00009077.0001001.045">If the Yellow Electric
Pump is not available:</para><item layer="1"><unlist bulltype="BULLET" code="00009077.0001001.031" layer="1" lid="N.00009077.0001001.046"><para layer="1" lid="N.00009077.0001001.047">Pressurize the Yellow Hydraulic
System with:</para><item layer="1"><para layer="1" lid="N.00009077.0001001.048">A Ground cart,
or with</para></item><item layer="1"><para layer="1" lid="N.00009077.0001001.049">The Yellow Engine
2 Pump with the Engine 2 running.</para></item></unlist></item><item layer="1"><para layer="1" lid="N.00009077.0001001.050">Replace any
action on the <tech-label type="pb-sw">YELLOW ELEC PUMP</tech-label> by a similar action
on the Ground Cart or on the <tech-label type="pb-sw">YELLOW ENG 2 PUMP</tech-label> in the
following procedure.</para></item></unlist></note></procdesc><procbody lid="N.00009077.0001001.005"><condition at-any-time="false" code="00009077.0001001.004" direct="false" layer="1" lid="N.00009077.0001001.010" subtitle="false" type="cond"><intro>If surface 1 indication is inoperative:</intro><procbody lid="N.00009077.0001001.011"><inform layer="1" lid="N.00009077.0001001.006"><cautionproc code="00009077.0001001.002" layer="1" lid="N.00009077.0001001.007"><inform layer="1" lid="N.00009077.0001001.008"><para code="00009077.0001001.003" layer="1" lid="N.00009077.0001001.009">The aircraft must be stopped during the check.</para></inform></cautionproc></inform><action-block lid="N.00009077.0001001.012"><action layer="1" lid="N.00009077.0001001.013" memory="false"><cr-action code="00009077.0001001.005"><challenge><tech-label type="pb-sw">YELLOW ELEC PUMP</tech-label></challenge><response>ON</response></cr-action></action><action layer="1" lid="N.00009077.0001001.014" memory="false"><cr-action code="00009077.0001001.006"><challenge><tech-label type="pb-sw">PTU</tech-label></challenge><response>AUTO</response></cr-action></action><action layer="1" lid="N.00009077.0001001.015" memory="false"><cr-action code="00009077.0001001.007"><challenge><tech-label type="lever">SPEEDBRAKES</tech-label></challenge><response>FULL</response></cr-action></action><action layer="1" lid="N.00009077.0001001.016" memory="false"><command code="00009077.0001001.008"><para layer="1" lid="N.00009077.0001001.017">Visually check that
surface 1 slightly extends (approximately 6°).</para></command></action><action layer="1" lid="N.00009077.0001001.018" memory="false"><cr-action code="00009077.0001001.009"><challenge><tech-label type="pb-sw">YELLOW ELEC PUMP</tech-label></challenge><response>Off</response></cr-action></action></action-block></procbody></condition><condition at-any-time="false" code="00009077.0001001.010" direct="false" layer="1" lid="N.00009077.0001001.019" subtitle="false" type="cond"><intro>If surface 3 indication is inoperative:</intro><procbody lid="N.00009077.0001001.020"><action-block lid="N.00009077.0001001.021"><action layer="1" lid="N.00009077.0001001.022" memory="false"><cr-action code="00009077.0001001.011"><challenge><tech-label type="pb-sw">BLUE ELEC PUMP</tech-label></challenge><response>AUTO</response></cr-action></action><action layer="1" lid="N.00009077.0001001.023" memory="false"><cr-action code="00009077.0001001.012"><challenge><tech-label type="pb-sw">BLUE PUMP OVRD</tech-label></challenge><response>ON</response></cr-action></action><action layer="1" lid="N.00009077.0001001.024" memory="false"><command code="00009077.0001001.013"><para layer="1" lid="N.00009077.0001001.025">Move the stick from
left stop to right stop. </para></command></action><action layer="1" lid="N.00009077.0001001.026" memory="false"><command code="00009077.0001001.014"><para layer="1" lid="N.00009077.0001001.027">Visually check the
correct movement of surface 3.</para></command></action><action layer="1" lid="N.00009077.0001001.028" memory="false"><cr-action code="00009077.0001001.015"><challenge><tech-label type="pb-sw">BLUE PUMP OVRD</tech-label></challenge><response>Off</response></cr-action></action></action-block></procbody></condition><condition at-any-time="false" code="00009077.0001001.016" direct="false" layer="1" lid="N.00009077.0001001.029" subtitle="false" type="cond"><intro>If surface 2, 4, or 5 indication is inoperative:</intro><procbody lid="N.00009077.0001001.030"><action-block lid="N.00009077.0001001.031"><action layer="1" lid="N.00009077.0001001.032" memory="false"><cr-action code="00009077.0001001.017"><challenge><tech-label type="pb-sw">YELLOW ELEC PUMP</tech-label></challenge><response>ON</response></cr-action></action><action layer="1" lid="N.00009077.0001001.033" memory="false"><cr-action code="00009077.0001001.018"><challenge><tech-label type="pb-sw">PTU</tech-label></challenge><response>AUTO</response></cr-action></action><action layer="1" lid="N.00009077.0001001.035" memory="false"><command code="00009077.0001001.020"><para layer="1" lid="N.00009077.0001001.036">Move the stick from
left stop to right stop and visually check the correct
movement of surfaces 2, 4 and 5.</para></command></action><action layer="1" lid="N.00009077.0001001.037" memory="false"><cr-action code="00009077.0001001.021"><challenge><tech-label type="pb-sw">YELLOW ELEC PUMP</tech-label></challenge><response>Off</response></cr-action></action></action-block></procbody></condition></procbody></procitem></opsproc>