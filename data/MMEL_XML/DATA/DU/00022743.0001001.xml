<opsproc code="00022743.0001001" revdate="2021-11-18T11:39:14"><title>Main Wheel Brake (One Brake Inop)</title><procitem layer="1" lid="N.00022743.0001001.001"><title>Flight Preparation/Limitations</title><procbody lid="N.00022743.0001001.002"><limit layer="1" lid="N.00022743.0001001.007"><lit-limit lid="N.00022743.0001001.008">Maximum landing capability is CAT 3 Single.</lit-limit></limit><action layer="1" lid="N.00022743.0001001.009" memory="false"><command code="00022743.0001001.004"><para layer="1" lid="N.00022743.0001001.010">Determine the associated Flight
Manual performance penalties with the OCTOPUS program.</para><note code="00022743.0001001.005" layer="1" lid="N.00022743.0001001.011"><para layer="1" lid="N.00022743.0001001.012">In the Airbus <abb>EFB</abb> <abb>PERF</abb> applications, this corresponds to the <abb>MEL</abb> item “BRAKES CONFIGURATION 1 BRAKE INOPERATIVE”.</para></note></command></action></procbody></procitem><procitem layer="1" lid="N.00022743.0001001.013"><title>For takeoff</title><procbody lid="N.00022743.0001001.014"><limit layer="1" lid="N.00022743.0001001.015"><lit-limit lid="N.00022743.0001001.016">The autobrake function, even if available, must not be used.</lit-limit></limit><condition at-any-time="false" code="00022743.0001001.010" direct="false" layer="1" lid="N.00022743.0001001.024" subtitle="false" type="cond"><intro>In the case of engine failure at takeoff:</intro><procbody lid="N.00022743.0001001.025"><action layer="1" lid="N.00022743.0001001.026" memory="false"><command code="00022743.0001001.011"><para layer="1" lid="N.00022743.0001001.027">Retract the landing
gear when positive climb.</para></command><comment code="00022743.0001001.012"><para layer="1" lid="N.00022743.0001001.028">Vibrations may occur
during <measure category="Time" show-unit="false" system="SI and derived" unit="min">1</measure> or <measure category="Time" show-unit="true" system="SI and derived" unit="min">2</measure> after the retraction of the landing gear.</para></comment></action></procbody></condition><condition at-any-time="false" code="00022743.0001001.013" direct="false" layer="1" lid="N.00022743.0001001.029" subtitle="false" type="cond"><intro>If both engines are operative:</intro><procbody lid="N.00022743.0001001.030"><action layer="1" lid="N.00022743.0001001.031" memory="false"><command code="00022743.0001001.014"><para layer="1" lid="N.00022743.0001001.032"> Keep the landing
gear down for <measure category="Time" show-unit="true" system="SI and derived" unit="min">1</measure>.</para></command></action></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00022743.0001001.033"><title>For landing</title><procbody lid="N.00022743.0001001.034"><limit layer="1" lid="N.00022743.0001001.035"><lit-limit lid="N.00022743.0001001.036">The autobrake function, even if available, must not be used.</lit-limit></limit></procbody></procitem></opsproc>