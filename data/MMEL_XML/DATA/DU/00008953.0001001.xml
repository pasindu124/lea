<opsproc code="00008953.0001001" revdate="2016-11-22T18:36:25"><title>Attitude Indication on the <abb>PFD</abb></title><procitem layer="1" lid="N.00008953.0001001.004"><title>Flight preparation/limitations</title><procbody lid="N.00008953.0001001.005"><limit layer="1" lid="N.00008953.0001001.008"><lit-limit lid="N.00008953.0001001.009">For aircraft with the <abb>RNP</abb> <abb>AR</abb> capability, <abb>RNP</abb> <abb>AR</abb> operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00008953.0001001.023"><lit-limit lid="N.00008953.0001001.024">Maximum landing capability is CAT 1.</lit-limit></limit><condition at-any-time="false" code="00008953.0001001.008" direct="false" layer="1" lid="N.00008953.0001001.019" subtitle="false" type="cond"><intro>If the <abb>PF</abb> side is affected:</intro><procbody lid="N.00008953.0001001.020"><limit layer="1" lid="N.00008953.0001001.021"><lit-limit lid="N.00008953.0001001.022"><abb>RNP</abb> <abb>APCH</abb> operations are not permitted.</lit-limit></limit></procbody></condition></procbody></procitem></opsproc>