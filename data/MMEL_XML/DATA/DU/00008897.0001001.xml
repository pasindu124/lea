<opsproc code="00008897.0001001" revdate="2020-05-13T11:34:14"><title>Autopilot (AP)</title><procitem layer="1" lid="N.00008897.0001001.004"><title>Flight preparation/Limitations</title><procbody lid="N.00008897.0001001.005"><ex-conditions lid="N.00008897.0001001.018"><condition at-any-time="false" code="00008897.0001001.007" direct="false" layer="1" lid="N.00008897.0001001.019" subtitle="false" type="cond"><intro>When one <abb>AP</abb> is inoperative:</intro><procbody lid="N.00008897.0001001.020"><limit layer="1" lid="N.00008897.0001001.032"><lit-limit lid="N.00008897.0001001.034">For aircraft
with the <abb>RNP</abb> <abb>AR</abb> capability, the following <abb>RNP</abb> <abb>AR</abb> operations are not permitted:</lit-limit></limit><inform layer="1" lid="N.00008897.0001001.037"><unlist bulltype="BULLET" code="00008897.0001001.017" layer="1" lid="N.00008897.0001001.039"><item layer="1"><para layer="1" lid="N.00008897.0001001.040"><abb>RNP</abb> <abb>AR</abb> operations strictly below <measure category="Length" show-unit="true" system="Other" unit="NM">0.3</measure></para></item><item layer="1"><para layer="1" lid="N.00008897.0001001.041"><abb>RNP</abb> <abb>AR</abb> operations with a missed approach with an <abb>RNP</abb> value below <measure category="Length" show-unit="true" system="Other" unit="NM">1</measure>.</para></item></unlist></inform><limit layer="1" lid="N.00008897.0001001.021"><lit-limit lid="N.00008897.0001001.022">Maximum landing capability is
CAT 3 SINGLE.</lit-limit></limit></procbody></condition><condition at-any-time="false" code="00008897.0001001.009" direct="false" layer="1" lid="N.00008897.0001001.023" subtitle="false" type="cond"><intro>When both <abb>AP</abb>s are inoperative:</intro><procbody lid="N.00008897.0001001.024"><limit layer="1" lid="N.00008897.0001001.035"><lit-limit lid="N.00008897.0001001.036">For aircraft
with the <abb>RNP</abb> <abb>AR</abb> capability, <abb>RNP</abb> <abb>AR</abb> operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00008897.0001001.025"><lit-limit lid="N.00008897.0001001.026"><abb>RVSM</abb> operations are
not permitted.</lit-limit></limit><limit layer="1" lid="N.00008897.0001001.027"><lit-limit lid="N.00008897.0001001.028">Maximum landing capability is
CAT 1.</lit-limit></limit></procbody></condition></ex-conditions></procbody></procitem></opsproc>