<opsproc code="00029404.0002001" revdate="2026-05-20T16:57:03"><title>APU Air Intake Flap</title><procitem layer="1" lid="N.00029404.0002001.001"><title>General Information</title><procbody lid="N.00029404.0002001.002"><inform layer="1" lid="N.00029404.0002001.003"><para code="00029404.0002001.001" layer="1" lid="N.00029404.0002001.004">The <emph bold="false" color="Green" italic="false" overline="false" sub="false" sup="false" underline="false">FLAP OPEN</emph> indication is permanently displayed
on the <tech-label type="s-page">APU</tech-label>, except on the ground, if the <abb>APU</abb> is OFF.</para></inform></procbody></procitem><procitem layer="1" lid="N.00029404.0002001.005"><title>Flight Preparation/Limitations</title><procbody lid="N.00029404.0002001.006"><inform layer="1" lid="N.00029404.0002001.007"><para code="00029404.0002001.002" layer="1" lid="N.00029404.0002001.008">Increase
the fuel consumption by <measure category="Percent" show-unit="true" system="Other" unit="%">1.3</measure> due to <abb>APU</abb> flap deactivated
in the open position.</para></inform><action layer="1" lid="N.00029404.0002001.011" memory="false"><command code="00029404.0002001.004"><para layer="1" lid="N.00029404.0002001.012">Reduce the <abb>OEI</abb> en-route
performance limiting weight by <measure category="Weight" show-unit="true" system="SI and derived" unit="kg">750</measure> (<measure category="Weight" show-unit="true" system="US" unit="lb">1654</measure>).</para><note code="00029404.0002001.005" layer="1" lid="N.00029404.0002001.013"><para layer="1" lid="N.00029404.0002001.014">This weight decrement penalty
corresponds to a <measure category="Length" show-unit="true" system="US" unit="ft">750</measure> (<measure category="Length" show-unit="true" system="SI and derived" unit="m">229</measure>) net ceiling penalty.</para></note></command></action></procbody></procitem><procitem layer="1" lid="N.00029404.0002001.019"><title>Deicing/Anti-Icing on Ground</title><procbody lid="N.00029404.0002001.020"><action layer="1" lid="N.00029404.0002001.021" memory="false"><cr-action code="00029404.0002001.008"><challenge><abb>APU</abb> BLEED</challenge><response>CHECK OFF</response></cr-action></action><inform layer="1" lid="N.00029404.0002001.022"><cautionproc code="00029404.0002001.009" layer="1" lid="N.00029404.0002001.023"><para layer="1" lid="N.00029404.0002001.024">If possible, avoid <abb>APU</abb> operation during aircraft deicing/anti-icing. <abb>APU</abb> operation during aircraft deicing/anti-icing may result in deicing/anti-icing
fluid ingestion and cause damage to the <abb>APU</abb>.</para></cautionproc></inform><action layer="1" lid="N.00029404.0002001.025" memory="false"><cr-action code="00029404.0002001.010"><challenge><abb>APU</abb></challenge><response>AS RQRD</response></cr-action></action><inform layer="1" lid="N.00029404.0002001.026"><para code="00029404.0002001.011" layer="1" lid="N.00029404.0002001.027">For more information on AIRFRAME DEICING/ANTI-ICING PROCEDURE ON
GROUND, <duref product="FCOM" ref="00020694"><linktext>Procedures/Normal
Procedures/Supplementary Procedures/Adverse Weather/Airframe Deicing/Anti-icing
Procedure on Ground.</linktext></duref></para></inform></procbody></procitem><procitem layer="1" lid="N.00029404.0002001.028"><title>AFTER DEICING/ANTI-ICING OPERATION ON GROUND</title><procbody lid="N.00029404.0002001.029"><action layer="1" lid="N.00029404.0002001.030" memory="false"><cr-action code="00029404.0002001.012"><challenge><abb>APU</abb></challenge><response>START</response></cr-action></action><action layer="1" lid="N.00029404.0002001.031" memory="false"><cr-action code="00029404.0002001.013"><challenge><abb>APU</abb> BLEED</challenge><response>KEEP OFF</response></cr-action></action><inform layer="1" lid="N.00029404.0002001.032"><para code="00029404.0002001.014" layer="1" lid="N.00029404.0002001.033"><abb>APU</abb> running with the <abb>APU</abb> bleed OFF ensures
that any ingested fluid is vaporized and eliminated or melted and
poured through the drains.</para></inform></procbody></procitem><procitem layer="1" lid="N.00029404.0002001.034"><title>FIVE MINUTES AFTER <abb>APU</abb> START</title><procbody lid="N.00029404.0002001.035"><action layer="1" lid="N.00029404.0002001.036" memory="false"><cr-action code="00029404.0002001.015"><challenge><abb>APU</abb> BLEED</challenge><response>AS RQRD</response></cr-action></action></procbody></procitem></opsproc>