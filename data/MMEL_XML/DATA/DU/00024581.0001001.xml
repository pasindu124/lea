<opsproc code="00024581.0001001" revdate="2021-02-24T10:38:58"><title>Digital Backup Speed (DBUS)</title><procbody lid="N.00024581.0001001.001"><condition at-any-time="false" code="00024581.0001001.001" direct="false" layer="1" lid="N.00024581.0001001.002" subtitle="false" type="cond"><intro>In case of <abb>ECAM</abb> procedure requesting to use the <abb>DBUS</abb>:</intro><procbody lid="N.00024581.0001001.003"><action layer="1" lid="N.00024581.0001001.004" memory="false"><cr-action code="00024581.0001001.002"><challenge><tech-label type="pb-sw">BKUP SPD/ALT</tech-label> </challenge><response>DO NOT USE</response></cr-action></action><ex-conditions lid="N.00024581.0001001.005"><condition at-any-time="false" code="00024581.0001001.003" direct="false" layer="1" lid="N.00024581.0001001.006" subtitle="false" type="cond"><intro>If at least one speed confirmed reliable:</intro><procbody lid="N.00024581.0001001.007"><action layer="1" lid="N.00024581.0001001.008" memory="false"><cr-action code="00024581.0001001.004"><challenge>RELIABLE SPEED DATA</challenge><response>USE</response></cr-action></action></procbody></condition><condition at-any-time="false" code="00024581.0001001.005" direct="false" layer="1" lid="N.00024581.0001001.009" subtitle="false" type="cond"><intro>If no speed confirmed reliable:</intro><procbody lid="N.00024581.0001001.010"><action layer="1" lid="N.00024581.0001001.011" memory="false"><cr-action code="00024581.0001001.006"><challenge>UNREL SPD PROC</challenge><response>APPLY</response></cr-action></action><inform layer="1" lid="N.00024581.0001001.012"><para code="00024581.0001001.007" layer="1" lid="N.00024581.0001001.013"><duref product="QRH" ref="00017710"/>.</para></inform></procbody></condition></ex-conditions></procbody></condition></procbody></opsproc>