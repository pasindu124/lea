<opsproc code="00008872.0007001" revdate="2026-02-18T16:37:05"><title>Engine Bleed <abb>HP</abb> Valve</title><procdesc code="00008872.0007001.020" lid="N.00008872.0007001.039"><para code="00008872.0007001.025" layer="1" lid="N.00008872.0007001.049"><emph bold="true" italic="false" overline="false" sub="false" sup="false" underline="true">GENERAL INFORMATION</emph></para><note code="00008872.0007001.021" layer="1" lid="N.00008872.0007001.040"><para layer="1" lid="N.00008872.0007001.041">If the bleed of the affected
engine is used while the thrust is reduced (i.e. <tech-label type="pb-sw">ENG 1(2) BLEED</tech-label> is set to OFF too late, or set to ON too early), the following alerts
may trigger:</para><unlist bulltype="NDASH" code="00008872.0007001.022" layer="1" lid="N.00008872.0007001.042"><item layer="1"><para layer="1" lid="N.00008872.0007001.043"><ecam-data ecamimportance="A" type="alert"><ecamsys>AIR</ecamsys><ecamtitle>ENG 1(2) BLEED ABNORM PR</ecamtitle></ecam-data></para></item><item layer="1"><para layer="1" lid="N.00008872.0007001.044"><ecam-data ecamimportance="A" type="alert"><ecamsys>AIR</ecamsys><ecamtitle>ENG 1(2) HP VALVE FAULT</ecamtitle></ecam-data></para></item><item layer="1"><para layer="1" lid="N.00008872.0007001.045"><ecam-data ecamimportance="A" type="alert"><ecamsys>AIR</ecamsys><ecamtitle>PACK 1(2) REGUL FAULT</ecamtitle></ecam-data></para></item></unlist></note></procdesc><procitem layer="1" lid="N.00008872.0007001.001"><title>Flight preparation/Limitations</title><procbody lid="N.00008872.0007001.002"><inform layer="1" lid="N.00008872.0007001.003"><para code="00008872.0007001.001" layer="1" lid="N.00008872.0007001.004">The flight crew should take
into account the severity of forecast icing conditions. At low power
settings, the wing anti-ice will be lost if the opposite engine bleed
air supply system becomes inoperative.</para></inform><condition at-any-time="false" code="00008872.0007001.002" direct="false" layer="1" lid="N.00008872.0007001.005" subtitle="false" type="cond"><intro>If ENG 1 bleed <abb>HP</abb> Valve is affected:</intro><procbody lid="N.00008872.0007001.006"><limit layer="1" lid="N.00008872.0007001.037"><lit-limit lid="N.00008872.0007001.038">One engine taxi is not permitted.</lit-limit></limit></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00008872.0007001.009"><title>AFTER START</title><procbody lid="N.00008872.0007001.010"><inform layer="1" lid="N.00008872.0007001.047"><para code="00008872.0007001.024" layer="1" lid="N.00008872.0007001.048"><emph bold="false" italic="false" overline="false" sub="false" sup="false" underline="true">Shortly
after engines start and when the affected engine operates at idle
thrust</emph></para></inform><ex-conditions lid="N.00008872.0007001.011"><condition at-any-time="false" code="00008872.0007001.004" direct="false" layer="1" lid="N.00008872.0007001.012" subtitle="false" type="cond"><intro>If two engine taxi at departure:</intro><procbody lid="N.00008872.0007001.013"><action layer="1" lid="N.00008872.0007001.015" memory="false"><cr-action code="00008872.0007001.005"><challenge><tech-label type="pb-sw">ENG (affected side) BLEED</tech-label></challenge><response>OFF</response></cr-action></action></procbody></condition><condition at-any-time="false" code="00008872.0007001.008" direct="false" layer="1" lid="N.00008872.0007001.018" subtitle="false" type="cond"><intro>If one engine taxi at departure:</intro><procbody lid="N.00008872.0007001.019"><action layer="1" lid="N.00008872.0007001.021" memory="false"><cr-action code="00008872.0007001.009"><challenge><tech-label type="pb-sw">ENG 2 BLEED</tech-label></challenge><response>OFF</response></cr-action></action></procbody></condition></ex-conditions><action layer="1" lid="N.00008872.0007001.022" memory="false"><cr-action code="00008872.0007001.010"><challenge><tech-label type="sel">X BLEED</tech-label></challenge><response>OPEN</response></cr-action></action><action layer="1" lid="N.00008872.0007001.023" memory="false"><cr-action code="00008872.0007001.011"><challenge><tech-label type="pb-sw">One PACK</tech-label></challenge><response>OFF</response></cr-action></action></procbody></procitem><procitem layer="1" lid="N.00008872.0007001.024"><title>Before takeoff</title><procbody lid="N.00008872.0007001.025"><action-block lid="N.00008872.0007001.026"><title>Just before applying takeoff thrust</title><action layer="1" lid="N.00008872.0007001.027" memory="false"><cr-action code="00008872.0007001.012"><challenge><tech-label type="pb-sw">ENG (affected side)
BLEED</tech-label></challenge><response>On</response></cr-action><comment code="00008872.0007001.023"><para layer="1" lid="N.00008872.0007001.046">In order to prevent the triggering
of <abb>ECAM</abb> alerts, the flight crew must be careful not to
set <tech-label type="pb-sw">ENG 1(2) BLEED</tech-label> to On too early before the takeoff
power is set.</para></comment></action><action layer="1" lid="N.00008872.0007001.028" memory="false"><cr-action code="00008872.0007001.013"><challenge><tech-label type="sel">X BLEED</tech-label></challenge><response>AUTO</response></cr-action></action><action layer="1" lid="N.00008872.0007001.029" memory="false"><cr-action code="00008872.0007001.014"><challenge><tech-label type="pb-sw">PACK</tech-label></challenge><response>On</response></cr-action></action></action-block></procbody></procitem><procitem layer="1" lid="N.00008872.0007001.031"><title>BEFORE DESCENT</title><procbody lid="N.00008872.0007001.032"><action-block lid="N.00008872.0007001.033"><title>Shortly before descent and until engines shutdown</title><action layer="1" lid="N.00008872.0007001.034" memory="false"><cr-action code="00008872.0007001.016"><challenge><tech-label type="pb-sw">ENG (affected side)
BLEED</tech-label></challenge><response>OFF</response></cr-action></action><action layer="1" lid="N.00008872.0007001.035" memory="false"><cr-action code="00008872.0007001.017"><challenge><tech-label type="sel">X BLEED</tech-label></challenge><response>OPEN</response></cr-action></action><action layer="1" lid="N.00008872.0007001.036" memory="false"><cr-action code="00008872.0007001.018"><challenge><tech-label type="pb-sw">One PACK</tech-label></challenge><response>OFF</response></cr-action></action></action-block></procbody></procitem></opsproc>