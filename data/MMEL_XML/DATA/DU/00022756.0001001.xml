<opsproc code="00022756.0001001" revdate="2021-11-18T11:39:27"><title>Spoilers 3 and 4</title><procitem layer="1" lid="N.00022756.0001001.001"><title>Flight Preparation/Limitations</title><procbody lid="N.00022756.0001001.002"><action layer="1" lid="N.00022756.0001001.003" memory="false"><command code="00022756.0001001.001"><para layer="1" lid="N.00022756.0001001.004">Determine the associated Flight
Manual performance penalties with the OCTOPUS program.</para><note code="00022756.0001001.002" layer="1" lid="N.00022756.0001001.005"><para layer="1" lid="N.00022756.0001001.006">In the Airbus <abb>EFB</abb> <abb>PERF</abb> applications, this corresponds to the <abb>MEL</abb> item "GROUND SPOILERS 2 PAIRS INOPERATIVE".</para></note></command></action></procbody></procitem><procitem layer="1" lid="N.00022756.0001001.009"><title>During cockpit preparation</title><procbody lid="N.00022756.0001001.010"><action-block lid="N.00022756.0001001.011"><title>Check that the <abb>DC</abb> TIE contactor 1 is closed:</title><action layer="1" lid="N.00022756.0001001.012" memory="false"><command code="00022756.0001001.004"><para layer="1" lid="N.00022756.0001001.013">Supply the electrical network
from the <abb>APU</abb> or the external power.</para></command></action><action layer="1" lid="N.00022756.0001001.014" memory="false"><command code="00022756.0001001.005"><para layer="1" lid="N.00022756.0001001.015">On the <tech-label type="s-page">ELEC</tech-label>, check the link between the <abb>DC</abb> BUS 1 and the <abb>DC</abb> <abb>BAT</abb> BUS.</para></command></action></action-block></procbody></procitem><procitem layer="1" lid="N.00022756.0001001.016"><title>In flight</title><procbody lid="N.00022756.0001001.017"><action layer="1" lid="N.00022756.0001001.018" memory="false"><command code="00022756.0001001.006"><para layer="1" lid="N.00022756.0001001.019">Do not use the speedbrakes.</para></command></action></procbody></procitem></opsproc>