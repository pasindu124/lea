e="false" code="00008869.0013001.043" direct="false" layer="1" lid="N.00008869.0013001.097" subtitle="false" type="cond"><intro>If Wing Anti-Ice is required:</intro><procbody lid="N.00008869.0013001.098"><action layer="1" lid="N.00008869.0013001.099" memory="false"><cr-action code="00008869.0013001.044"><challenge><tech-label type="pb-sw">PACK 2</tech-label></challenge><response>OFF</response></cr-action></action></procbody></condition></ex-conditions></procbody></condition><condition at-any-time="false" code="00008869.0013001.045" direct="false" layer="1" lid="N.00008869.0013001.101" subtitle="false" type="cond"><intro>If one PACK is inoperative:</intro><procbody lid="N.00008869.0013001.102"><action layer="1" lid="N.00008869.0013001.103" memory="false"><cr-action code="00008869.0013001.046"><challenge><tech-label type="pb-sw">ECON FLOW</tech-label></challenge><response>Off</response></cr-action></action></procbody></condition></ex-conditions></procbody></condition></procbody></condition></procbody></condition></ex-conditions></procbody></procitem><procitem layer="1" lid="N.00008869.0013001.037"><title>Before takeoff</title><procbody lid="N.00008869.0013001.038"><action layer="1" lid="N.00008869.0013001.039" memory="false"><cr-action code="00008869.0013001.014"><challenge><tech-label type="pb-sw">APU MASTER SW</tech-label></challenge><response>ON</response></cr-action></action><action layer="1" lid="N.00008869.0013001.040" memory="false"><cr-action code="00008869.0013001.015"><challenge><tech-label type="pb-sw">APU START</tech-label></challenge><response>ON</response></cr-action></action></procbody></procitem><procitem layer="1" lid="N.00008869.0013001.041"><title>For takeoff</title><procbody lid="N.00008869.0013001.042"><inform layer="1" lid="N.00008869.0013001.043"><para code="00008869.0013001.016" layer="1" lid="N.00008869.0013001.044">Set at least one air conditioning
