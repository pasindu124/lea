<opsproc code="00020727.0001001" revdate="2019-05-22T11:46:35"><title><abb>ND</abb> Mode Selector</title><procitem layer="1" lid="N.00020727.0001001.023"><title>FLIGHT PREPARATION/LIMITATIONS</title><procbody lid="N.00020727.0001001.024"><limit layer="1" lid="N.00020727.0001001.025"><lit-limit lid="N.00020727.0001001.026">For aircraft with the <abb>RNP</abb> <abb>AR</abb> capability, <abb>RNP</abb> <abb>AR</abb> operations are not permitted.</lit-limit></limit><condition at-any-time="false" code="00020727.0001001.012" direct="false" layer="1" lid="N.00020727.0001001.027" subtitle="false" type="cond"><intro>If ROSE NAV and ARC modes are not available on one side:</intro><procbody lid="N.00020727.0001001.028"><limit layer="1" lid="N.00020727.0001001.029"><lit-limit lid="N.00020727.0001001.030"><abb>RNP</abb> <abb>APCH</abb> operations are not permitted.</lit-limit></limit></procbody></condition><condition at-any-time="false" code="00020727.0001001.014" direct="false" layer="1" lid="N.00020727.0001001.031" subtitle="false" type="cond"><intro>If the <abb>PF</abb> side is affected:</intro><procbody lid="N.00020727.0001001.032"><limit layer="1" lid="N.00020727.0001001.033"><lit-limit lid="N.00020727.0001001.034"><abb>RNAV</abb> 10 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00020727.0001001.035"><lit-limit lid="N.00020727.0001001.036"><abb>RNAV</abb> 5 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00020727.0001001.037"><lit-limit lid="N.00020727.0001001.038"><abb>RNAV</abb> 1 / <abb>RNAV</abb> 2 operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00020727.0001001.039"><lit-limit lid="N.00020727.0001001.040"><abb>RNP</abb> 4 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00020727.0001001.041"><lit-limit lid="N.00020727.0001001.042"><abb>RNP</abb> 2 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00020727.0001001.043"><lit-limit lid="N.00020727.0001001.044"><abb>RNP</abb> 1 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00020727.0001001.045"><lit-limit lid="N.00020727.0001001.046"><abb>RNP</abb> <abb>APCH</abb> operations are not permitted.</lit-limit></limit></procbody></condition></procbody></procitem></opsproc>