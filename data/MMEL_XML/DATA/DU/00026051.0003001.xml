<dispatchitem code="00026051.0003001" func-code="52-51-09" item-list-nbr="09" revdate="2022-08-17T00:00:00"><title>Cockpit Door Handle (including Bellcranks Linkage) </title><ditembody nb-installed="1"><dispcond code="00026051.0003001.001" dispcond-id="D12723" dispcond-label="A" lid="N.00026051.0003001.001"><title>Cockpit Door is considered inoperative in the open/unlocked
position</title><normal-dispcond nb-required="0" rectification-interval="B"><remark><requirement lid="N.00026051.0003001.002" req-id="R12724"><para code="00026051.0003001.002" layer="1" lid="N.00026051.0003001.003">May be inoperative in the open/unlocked
position provided that the <abb>CDLS</abb> Normal System, BK UP System
and the cockpit door <tech-label type="light">OPEN</tech-label> are considered inoperative. </para><para code="00026051.0003001.013" layer="1" lid="N.00026051.0003001.028"><duref product="MMEL" ref="00008750"/></para><para code="00026051.0003001.014" layer="1" lid="N.00026051.0003001.029"><duref product="MMEL" ref="00008770"/></para><para code="00026051.0003001.015" layer="1" lid="N.00026051.0003001.030"><duref product="MMEL" ref="00008752"/></para></requirement></remark></normal-dispcond></dispcond><dispcond code="00026051.0003001.003" dispcond-id="D12725" dispcond-label="B" lid="N.00026051.0003001.004"><title>CDLS Normal system operative</title><normal-dispcond nb-required="0" rectification-interval="D"><remark><requirementblock><requirement lid="N.00026051.0003001.005" req-id="R12726"><opsproc-ref><duref product="MMEL" ref="00026052"/></opsproc-ref><qualifiers><qualifier value="NO_GO_IF_52-51-01"/><qualifier value="NO_GO_IF_52-53-04"/></qualifiers><para code="00026051.0003001.004" layer="1" lid="N.00026051.0003001.006">May be inoperative in the closed/locked
position provided that:</para></requirement><addrequ lid="N.00026051.0003001.007"><requirement lid="N.00026051.0003001.008" req-id="R12727"><para code="00026051.0003001.005" layer="1" lid="N.00026051.0003001.009">The <abb>CDLS</abb> Normal System is operative, and</para></requirement></addrequ><addrequ lid="N.00026051.0003001.010"><requirement lid="N.00026051.0003001.011" req-id="R12728"><para code="00026051.0003001.006" layer="1" lid="N.00026051.0003001.012">The cockpit door <tech-label type="light">OPEN</tech-label> is not displayed, and</para></requirement></addrequ><addrequ lid="N.00026051.0003001.013"><requirement lid="N.00026051.0003001.014" req-id="R12729"><para code="00026051.0003001.007" layer="1" lid="N.00026051.0003001.015">The UNLOCK Function of the <tech-label type="sw">COCKPIT DOOR</tech-label> is operative.</para></requirement></addrequ></requirementblock></remark></normal-dispcond></dispcond><dispcond code="00026051.0003001.008" dispcond-id="D12730" dispcond-label="C" lid="N.00026051.0003001.016"><title>CDLS Normal system inoperative</title><normal-dispcond nb-required="0" rectification-interval="C"><remark><requirementblock><requirement lid="N.00026051.0003001.017" req-id="R12731"><opsproc-ref><duref product="MMEL" ref="00026053"/></opsproc-ref><qualifiers><qualifier value="NO_GO_IF_52-51-02"/></qualifiers><para code="00026051.0003001.009" layer="1" lid="N.00026051.0003001.018">May be inoperative in the closed/locked
position provided that:</para></requirement><addrequ lid="N.00026051.0003001.019"><requirement lid="N.00026051.0003001.020" req-id="R12732"><para code="00026051.0003001.010" layer="1" lid="N.00026051.0003001.021">The <abb>CDLS</abb> BK UP System is operative, and</para></requirement></addrequ><addrequ lid="N.00026051.0003001.022"><requirement lid="N.00026051.0003001.023" req-id="R12733"><para code="00026051.0003001.011" layer="1" lid="N.00026051.0003001.024">The cockpit door <tech-label type="light">OPEN</tech-label> is not displayed, and</para></requirement></addrequ><addrequ lid="N.00026051.0003001.025"><requirement lid="N.00026051.0003001.026" req-id="R12734"><para code="00026051.0003001.012" layer="1" lid="N.00026051.0003001.027">The unlock function of the <tech-label type="pb">CTL</tech-label> is operative.</para></requirement></addrequ></requirementblock></remark></normal-dispcond></dispcond></ditembody></dispatchitem>