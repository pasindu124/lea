<dispatchitem code="00025316.0001001" func-code="25-24-03" item-list-nbr="03" revdate="2022-11-16T00:00:00"><title><if-installed>Coat Stowage/Stowage</if-installed></title><ditembody nb-installed="-"><dispcond code="00025316.0001001.001" dispcond-id="D12520" dispcond-label="A" lid="N.00025316.0001001.001"><title>Door Secured Closed</title><normal-dispcond nb-required="0" rectification-interval="D"><placard/><remark><requirementblock><requirement lid="N.00025316.0001001.002" req-id="R12521"><maintenance-ref><taskref chap-nbr="25" func="040" product="AMM Task" sect-nbr="27" seq="804" subj-nbr="00"/></maintenance-ref><qualifiers><qualifier value="CREW_OPS"/></qualifiers><para code="00025316.0001001.002" layer="1" lid="N.00025316.0001001.003">May be inoperative provided that:</para></requirement><addrequ lid="N.00025316.0001001.004"><requirement lid="N.00025316.0001001.005" req-id="R12522"><para code="00025316.0001001.003" layer="1" lid="N.00025316.0001001.006">The affected stowage compartment is secured in the closed position,
and</para></requirement></addrequ><addrequ lid="N.00025316.0001001.007"><requirement lid="N.00025316.0001001.008" req-id="R12523"><para code="00025316.0001001.004" layer="1" lid="N.00025316.0001001.009">The affected stowage compartment is placarded "DO NOT USE",
and</para></requirement></addrequ><addrequ lid="N.00025316.0001001.010"><requirement lid="N.00025316.0001001.011" req-id="R12524"><para code="00025316.0001001.005" layer="1" lid="N.00025316.0001001.012">The affected stowage compartment is not used for stowage of any items
except for those permanently affixed, and</para></requirement></addrequ><addrequ lid="N.00025316.0001001.013"><requirement lid="N.00025316.0001001.014" req-id="R12525"><para code="00025316.0001001.006" layer="1" lid="N.00025316.0001001.015">Any emergency equipment located in the
affected stowage compartment is considered inoperative unless moved
to a different stowage compartment with a placard on the outside indicating
the relocated emergency equipment.</para><note code="00025316.0001001.007" layer="1" lid="N.00025316.0001001.016"><para layer="1" lid="N.00025316.0001001.017">If associated emergency
equipment cannot be relocated, refer to associated <abb>MMEL</abb> item.</para></note></requirement></addrequ></requirementblock></remark></normal-dispcond></dispcond><dispcond code="00025316.0001001.008" dispcond-id="D12526" dispcond-label="B" lid="N.00025316.0001001.018"><title>Door Removed</title><normal-dispcond nb-required="0" rectification-interval="D"><placard/><remark><requirementblock><requirement lid="N.00025316.0001001.019" req-id="R12527"><opsproc-ref><duref product="MMEL" ref="00025317"/></opsproc-ref><maintenance-ref><taskref chap-nbr="25" func="040" product="AMM Task" sect-nbr="27" seq="803" subj-nbr="00"/></maintenance-ref><qualifiers><qualifier value="CREW_OPS"/></qualifiers><para code="00025316.0001001.009" layer="1" lid="N.00025316.0001001.020">May be inoperative provided that:</para></requirement><addrequ lid="N.00025316.0001001.021"><requirement lid="N.00025316.0001001.022" req-id="R12528"><para code="00025316.0001001.010" layer="1" lid="N.00025316.0001001.023">The affected stowage compartment is placarded "DO NOT USE",
and</para></requirement></addrequ><addrequ lid="N.00025316.0001001.024"><requirement lid="N.00025316.0001001.025" req-id="R12529"><para code="00025316.0001001.011" layer="1" lid="N.00025316.0001001.026">The affected stowage compartment door is removed, and</para></requirement></addrequ><addrequ lid="N.00025316.0001001.027"><requirement lid="N.00025316.0001001.028" req-id="R12530"><para code="00025316.0001001.012" layer="1" lid="N.00025316.0001001.029">The affected stowage compartment is not used for stowage of any items,
except for those permanently affixed, and</para></requirement></addrequ><addrequ lid="N.00025316.0001001.030"><requirement lid="N.00025316.0001001.031" req-id="R12531"><para code="00025316.0001001.013" layer="1" lid="N.00025316.0001001.032">The crew members and passengers are briefed that the affected stowage
compartment is not to be used, and</para></requirement></addrequ><addrequ lid="N.00025316.0001001.033"><requirement lid="N.00025316.0001001.034" req-id="R12532"><para code="00025316.0001001.014" layer="1" lid="N.00025316.0001001.035">Any crow bars and/or crash axes stowed
in the affected compartment must be relocated in a different stowage
compartment compliant with security requirements, or removed and considered
inoperative, and</para><note code="00025316.0001001.015" layer="1" lid="N.00025316.0001001.036"><para layer="1" lid="N.00025316.0001001.037">If associated crow
bar or crash axe cannot be relocated, <duref product="MMEL" ref="00008577"/>.</para></note></requirement></addrequ><addrequ lid="N.00025316.0001001.039"><requirement lid="N.00025316.0001001.040" req-id="R12585"><para code="00025316.0001001.016" layer="1" lid="N.00025316.0001001.041">Any emergency equipment not affixed located in the affected stowage
compartment is considered inoperative and removed, unless relocated
to a different stowage compartment with a placard indicating the relocated
emergency equipment.</para><note code="00025316.0001001.017" layer="1" lid="N.00025316.0001001.042"><para layer="1" lid="N.00025316.0001001.043">If associated emergency equipment
cannot be relocated, refer to associated <abb>MMEL</abb> item.</para></note></requirement></addrequ></requirementblock></remark></normal-dispcond></dispcond></ditembody></dispatchitem>