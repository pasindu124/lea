<opsproc code="00008870.0001001" revdate="2026-02-18T16:37:00"><title>Engine Bleed <abb>IP</abb> Check Valve</title><procdesc code="00008870.0001001.037" lid="N.00008870.0001001.078"><para code="00008870.0001001.050" layer="1" lid="N.00008870.0001001.102"><emph bold="true" italic="false" overline="false" sub="false" sup="false" underline="true">GENERAL INFORMATION</emph></para><note code="00008870.0001001.038" layer="1" lid="N.00008870.0001001.079"><para layer="1" lid="N.00008870.0001001.080">If the bleed of the affected
engine is used while the thrust is reduced (i.e. <tech-label type="pb-sw">ENG 1(2) BLEED</tech-label> is set to OFF too late, or set to ON too early), the following alerts
may trigger:</para><unlist bulltype="NDASH" code="00008870.0001001.039" layer="1" lid="N.00008870.0001001.081"><item layer="1"><para layer="1" lid="N.00008870.0001001.082"><ecam-data ecamimportance="A" type="alert"><ecamsys>AIR</ecamsys><ecamtitle>ENG 1(2) BLEED ABNORM PR</ecamtitle></ecam-data></para></item><item layer="1"><para layer="1" lid="N.00008870.0001001.083"><ecam-data ecamimportance="A" type="alert"><ecamsys>AIR</ecamsys><ecamtitle>ENG 1(2) HP VALVE FAULT</ecamtitle></ecam-data></para></item><item layer="1"><para layer="1" lid="N.00008870.0001001.084"><ecam-data ecamimportance="A" type="alert"><ecamsys>AIR</ecamsys><ecamtitle>PACK 1(2) REGUL FAULT</ecamtitle></ecam-data></para></item></unlist></note></procdesc><procitem layer="1" lid="N.00008870.0001001.039"><title>Flight preparation/Limitations</title><procbody lid="N.00008870.0001001.040"><inform layer="1" lid="N.00008870.0001001.047"><para code="00008870.0001001.023" layer="1" lid="N.00008870.0001001.048">The flight crew should take
into account the severity of forecast icing conditions. At low power
settings, the wing anti-ice will be lost if the opposite engine bleed
air supply system becomes inoperative.</para></inform><condition at-any-time="false" code="00008870.0001001.027" direct="false" layer="1" lid="N.00008870.0001001.054" subtitle="false" type="cond"><intro>If ENG 1 bleed <abb>IP</abb> Check Valve is affected:</intro><procbody lid="N.00008870.0001001.055"><limit layer="1" lid="N.00008870.0001001.070"><lit-limit lid="N.00008870.0001001.071">One engine taxi is not permitted.</lit-limit></limit></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00008870.0001001.004"><title>After start</title><procbody lid="N.00008870.0001001.085"><inform layer="1" lid="N.00008870.0001001.097"><para code="00008870.0001001.047" layer="1" lid="N.00008870.0001001.098"><emph bold="false" italic="false" overline="false" sub="false" sup="false" underline="true">Shortly
after engines start and when the affected engine operates at idle
thrust</emph></para></inform><ex-conditions lid="N.00008870.0001001.086"><condition at-any-time="false" code="00008870.0001001.040" direct="false" layer="1" lid="N.00008870.0001001.087" subtitle="false" type="cond"><intro>If two engine taxi at departure:</intro><procbody lid="N.00008870.0001001.088"><action layer="1" lid="N.00008870.0001001.089" memory="false"><cr-action code="00008870.0001001.041"><challenge><tech-label type="pb-sw">ENG (affected
side) BLEED</tech-label></challenge><response>OFF</response></cr-action></action></procbody></condition><condition at-any-time="false" code="00008870.0001001.042" direct="false" layer="1" lid="N.00008870.0001001.090" subtitle="false" type="cond"><intro>If one engine taxi at departure:</intro><procbody lid="N.00008870.0001001.091"><action layer="1" lid="N.00008870.0001001.092" memory="false"><cr-action code="00008870.0001001.043"><challenge><tech-label type="pb-sw">ENG 2 BLEED</tech-label></challenge><response>OFF</response></cr-action></action></procbody></condition></ex-conditions><action layer="1" lid="N.00008870.0001001.093" memory="false"><cr-action code="00008870.0001001.044"><challenge><tech-label type="sel">X BLEED</tech-label></challenge><response>OPEN</response></cr-action></action><condition at-any-time="false" code="00008870.0001001.045" direct="false" layer="1" lid="N.00008870.0001001.094" subtitle="false" type="cond"><intro>If wing anti-ice is required:</intro><procbody lid="N.00008870.0001001.095"><action layer="1" lid="N.00008870.0001001.096" memory="false"><cr-action code="00008870.0001001.046"><challenge><tech-label type="pb-sw">One PACK</tech-label></challenge><response>OFF</response></cr-action></action></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00008870.0001001.006"><title>Before takeoff</title><procbody lid="N.00008870.0001001.017"><action-block lid="N.00008870.0001001.038"><title>Just before applying takeoff thrust</title><action layer="1" lid="N.00008870.0001001.019" memory="false"><cr-action code="00008870.0001001.006"><challenge><tech-label type="pb-sw">ENG (affected side) BLEED</tech-label></challenge><response>On</response></cr-action><comment code="00008870.0001001.035"><para layer="1" lid="N.00008870.0001001.069">In order to prevent the triggering
of <abb>ECAM</abb> alerts, the flight crew must be careful not to
set <tech-label type="pb-sw">ENG 1(2) BLEED</tech-label> to On too early before the takeoff
power is set.</para></comment></action><action layer="1" lid="N.00008870.0001001.020" memory="false"><cr-action code="00008870.0001001.007"><challenge><tech-label type="sel">X BLEED</tech-label></challenge><response>AUTO</response></cr-action></action></action-block><condition at-any-time="false" code="00008870.0001001.024" direct="false" layer="1" lid="N.00008870.0001001.050" subtitle="false" type="cond"><intro>If one PACK has been selected OFF after engines start:</intro><procbody lid="N.00008870.0001001.051"><action layer="1" lid="N.00008870.0001001.052" memory="false"><cr-action code="00008870.0001001.025"><challenge><tech-label type="pb-sw">PACK</tech-label></challenge><response>On</response></cr-action></action></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00008870.0001001.005"><title>BEFORE DESCENT</title><procbody lid="N.00008870.0001001.028"><action-block lid="N.00008870.0001001.029"><title>Shortly before descent and until engines shutdown</title><action layer="1" lid="N.00008870.0001001.030" memory="false"><cr-action code="00008870.0001001.012"><challenge><tech-label type="pb-sw">ENG (affected side) BLEED</tech-label></challenge><response>OFF</response></cr-action></action><action layer="1" lid="N.00008870.0001001.031" memory="false"><cr-action code="00008870.0001001.013"><challenge><tech-label type="sel">X BLEED</tech-label></challenge><response>OPEN</response></cr-action></action></action-block><condition at-any-time="false" code="00008870.0001001.014" direct="false" layer="1" lid="N.00008870.0001001.032" subtitle="false" type="cond"><intro>If wing anti-ice is required:</intro><procbody lid="N.00008870.0001001.033"><action layer="1" lid="N.00008870.0001001.034" memory="false"><cr-action code="00008870.0001001.015"><challenge><tech-label type="pb-sw">One PACK</tech-label></challenge><response>OFF</response></cr-action></action></procbody></condition></procbody></procitem></opsproc>