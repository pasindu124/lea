<opsproc code="00022755.0001001" revdate="2021-11-18T11:39:26"><title>Spoilers 1 and 2</title><procitem layer="1" lid="N.00022755.0001001.001"><title>Flight Preparation/Limitations</title><procbody lid="N.00022755.0001001.002"><action layer="1" lid="N.00022755.0001001.003" memory="false"><command code="00022755.0001001.001"><para layer="1" lid="N.00022755.0001001.004">Determine the associated Flight
Manual performance penalties with the OCTOPUS program.</para><note code="00022755.0001001.002" layer="1" lid="N.00022755.0001001.005"><para layer="1" lid="N.00022755.0001001.006">In the Airbus <abb>EFB</abb> <abb>PERF</abb> applications, this corresponds to the <abb>MEL</abb> item "GROUND SPOILERS 2 PAIRS INOPERATIVE".</para></note></command></action></procbody></procitem><procitem layer="1" lid="N.00022755.0001001.007"><title>During cockpit preparation</title><procbody lid="N.00022755.0001001.008"><action-block lid="N.00022755.0001001.009"><action layer="1" lid="N.00022755.0001001.010" memory="false"><cr-action code="00022755.0001001.003"><challenge><tech-label type="pb-sw">SEC 3</tech-label></challenge><response>OFF</response></cr-action></action><action layer="1" lid="N.00022755.0001001.011" memory="false"><cr-action code="00022755.0001001.004"><challenge><tech-label type="cb">FLIGHT CONTROLS/SEC3/SPLY
(121VU Q19)</tech-label></challenge><response>Pull</response></cr-action></action></action-block></procbody></procitem><procitem layer="1" lid="N.00022755.0001001.012"><title>In flight</title><procbody lid="N.00022755.0001001.013"><condition at-any-time="false" code="00022755.0001001.005" direct="false" layer="1" lid="N.00022755.0001001.014" subtitle="false" type="cond"><intro>In the case of further failure of <abb>SEC</abb> 1 and <abb>SEC</abb> 2:</intro><procbody lid="N.00022755.0001001.015"><inform layer="1" lid="N.00022755.0001001.016"><unlist bulltype="NDASH" code="00022755.0001001.006" layer="1" lid="N.00022755.0001001.017"><item layer="1"><para layer="1" lid="N.00022755.0001001.018">Autoland is
not permitted.</para></item><item layer="1"><para layer="1" lid="N.00022755.0001001.019">Disengage the <abb>AP</abb> at <measure category="Length" show-unit="true" system="US" unit="ft">500</measure> <abb>RA</abb> before landing in direct law.
As soon as the <abb>AP</abb> is disengaged when the three <abb>SEC</abb>s are failed, it cannot be engaged again.</para></item><item layer="1"><para layer="1" lid="N.00022755.0001001.020">Maximum landing
capability is CAT 1</para></item></unlist></inform></procbody></condition></procbody></procitem></opsproc>