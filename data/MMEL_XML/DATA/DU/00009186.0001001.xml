<opsproc code="00009186.0001001" revdate="2025-11-19T14:56:20"><title>Avionics Skin Air Inlet Valve (Air conditioning inlet valve
open on the ground)</title><procitem layer="1" lid="N.00009186.0001001.004"><title>During cockpit preparation</title><procbody lid="N.00009186.0001001.005"><action-block lid="N.00009186.0001001.008"><action layer="1" lid="N.00009186.0001001.027" memory="false"><command code="00009186.0001001.011"><para layer="1" lid="N.00009186.0001001.028">Supply the aircraft electrical
network.</para></command></action><action layer="1" lid="N.00009186.0001001.009" memory="false"><command code="00009186.0001001.003"><para layer="1" lid="N.00009186.0001001.010">Check that the air conditioning
is operating with one or two air conditioning packs set to on.</para></command></action><action layer="1" lid="N.00009186.0001001.011" memory="false"><cr-action code="00009186.0001001.004"><challenge><tech-label type="pb-sw">EXTRACT</tech-label></challenge><response>OVRD</response></cr-action></action><action layer="1" lid="N.00009186.0001001.014" memory="false"><command code="00009186.0001001.006"><para layer="1" lid="N.00009186.0001001.015">Clear the <ecam-data ecamimportance="A" type="alert"><ecamsys>VENT</ecamsys><ecamtitle>AVNCS SYS FAULT</ecamtitle></ecam-data> alert displayed on the <abb>EWD</abb> using the <tech-label type="pb">CLR</tech-label>.</para></command></action></action-block><inform layer="1" lid="N.00009186.0001001.022"><noteproc code="00009186.0001001.009" layer="1" lid="N.00009186.0001001.023"><limit layer="1" lid="N.00009186.0001001.025"><lit-limit lid="N.00009186.0001001.026">With only one air conditioning pack operative,
operating time on ground is limited to <measure category="Time" show-unit="true" system="SI and derived" unit="h">1</measure>.</lit-limit></limit></noteproc></inform></procbody></procitem><procitem layer="1" lid="N.00009186.0001001.016"><title>After takeoff</title><procbody lid="N.00009186.0001001.017"><action layer="1" lid="N.00009186.0001001.018" memory="false"><cr-action code="00009186.0001001.007"><challenge><tech-label type="pb-sw">EXTRACT</tech-label></challenge><response>AUTO</response></cr-action></action></procbody></procitem><procitem layer="1" lid="N.00009186.0001001.019"><title>After landing</title><procdesc code="00009186.0001001.014" lid="N.00009186.0001001.033"><note code="00009186.0001001.015" layer="1" lid="N.00009186.0001001.034"><para layer="1" lid="N.00009186.0001001.035">Due to temporary low-pressure
conditions, the <ecam-data ecamimportance="A" type="alert"><ecamsys>VENT</ecamsys><ecamtitle>BLOWER FAULT</ecamtitle></ecam-data> alert may appear when the <tech-label type="pb-sw">EXTRACT</tech-label> is not set to the
OVRD position.</para><para layer="1" lid="N.00009186.0001001.036">The flight crew should
disregard the associated <abb>ECAM</abb> procedure.</para><para layer="1" lid="N.00009186.0001001.037">The <ecam-data ecamimportance="A" type="alert"><ecamsys>VENT</ecamsys><ecamtitle>BLOWER FAULT</ecamtitle></ecam-data> alert disappears when the <tech-label type="pb-sw">EXTRACT</tech-label> is set to the OVRD position.</para></note></procdesc><procbody lid="N.00009186.0001001.020"><action layer="1" lid="N.00009186.0001001.021" memory="false"><cr-action code="00009186.0001001.008"><challenge><tech-label type="pb-sw">EXTRACT</tech-label></challenge><response>OVRD</response></cr-action></action></procbody></procitem></opsproc>