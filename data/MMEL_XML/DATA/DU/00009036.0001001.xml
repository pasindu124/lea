<opsproc code="00009036.0001001" revdate="2020-05-13T11:32:38"><title>NDU 1</title><procitem layer="1" lid="N.00009036.0001001.012"><title>Flight preparation/Limitations</title><procbody lid="N.00009036.0001001.013"><limit layer="1" lid="N.00009036.0001001.016"><lit-limit lid="N.00009036.0001001.017">For aircraft with the <abb>RNP</abb> <abb>AR</abb> capability, <abb>RNP</abb> <abb>AR</abb> operations are not permitted.</lit-limit></limit><condition at-any-time="false" code="00009036.0001001.018" direct="false" layer="1" lid="N.00009036.0001001.040" subtitle="false" type="cond"><intro>If the <abb>PM</abb> side is affected:</intro><procbody lid="N.00009036.0001001.041"><action layer="1" lid="N.00009036.0001001.042" memory="false"><command code="00009036.0001001.019"><para layer="1" lid="N.00009036.0001001.043">To perform <abb>RNP
APCH</abb>, <abb>RNAV</abb> 10, <abb>RNAV</abb> 5, <abb>RNAV</abb> 1 / <abb>RNAV</abb> 2, <abb>RNP</abb> 4, <abb>RNP</abb> 2 and <abb>RNP</abb> 1 operations, use the <tech-label type="pb">PFD/ND XFR</tech-label> to temporary
display <abb>ND</abb> information on the operative <abb>DU</abb>.</para></command></action></procbody></condition><condition at-any-time="false" code="00009036.0001001.006" direct="false" layer="1" lid="N.00009036.0001001.018" subtitle="false" type="cond"><intro>If the <abb>PF</abb> side is affected:</intro><procbody lid="N.00009036.0001001.019"><limit layer="1" lid="N.00009036.0001001.020"><lit-limit lid="N.00009036.0001001.021"><abb>RNP</abb> <abb>APCH</abb> operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00009036.0001001.027"><lit-limit lid="N.00009036.0001001.028"><abb>RNAV</abb> 10 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00009036.0001001.029"><lit-limit lid="N.00009036.0001001.030"><abb>RNAV</abb> 5 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00009036.0001001.036"><lit-limit lid="N.00009036.0001001.037"><abb>RNAV</abb> 1 / <abb>RNAV</abb> 2 operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00009036.0001001.034"><lit-limit lid="N.00009036.0001001.035"><abb>RNP</abb> 4 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00009036.0001001.032"><lit-limit lid="N.00009036.0001001.033"><abb>RNP</abb> 2 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00009036.0001001.038"><lit-limit lid="N.00009036.0001001.039"><abb>RNP</abb> 1 operations
are not permitted.</lit-limit></limit></procbody></condition><limit layer="1" lid="N.00009036.0001001.014"><lit-limit lid="N.00009036.0001001.031">Maximum landing capability is <abb>CAT</abb> 2.</lit-limit></limit></procbody></procitem><procitem layer="1" lid="N.00009036.0001001.009"><title>On ground or in flight</title><procbody lid="N.00009036.0001001.010"><action layer="1" lid="N.00009036.0001001.011" memory="false"><cr-action code="00009036.0001001.003"><challenge><tech-label type="knob">NDU 1</tech-label></challenge><response>OFF</response></cr-action></action></procbody></procitem></opsproc>