<opsproc code="00008857.0001001" revdate="2025-11-19T14:56:16"><title>Avionics Skin Air Inlet Valve (Air conditioning inlet valve
secured in the open position)</title><procitem layer="1" lid="N.00008857.0001001.004"><title>During cockpit preparation</title><procbody lid="N.00008857.0001001.005"><action-block lid="N.00008857.0001001.008"><action layer="1" lid="N.00008857.0001001.031" memory="false"><command code="00008857.0001001.014"><para layer="1" lid="N.00008857.0001001.032">Supply the aircraft electrical
network.</para></command></action><action layer="1" lid="N.00008857.0001001.009" memory="false"><command code="00008857.0001001.003"><para layer="1" lid="N.00008857.0001001.010">Check that the air conditioning
is operating with one or two air conditioning packs set to on.</para></command></action><action layer="1" lid="N.00008857.0001001.011" memory="false"><cr-action code="00008857.0001001.004"><challenge><tech-label type="pb-sw">EXTRACT</tech-label></challenge><response>OVRD</response></cr-action></action></action-block><condition at-any-time="false" code="00008857.0001001.009" direct="false" layer="1" lid="N.00008857.0001001.020" subtitle="false" type="cond"><intro>After application of the maintenance procedure:</intro><procbody lid="N.00008857.0001001.021"><action layer="1" lid="N.00008857.0001001.022" memory="false"><command code="00008857.0001001.010"><para layer="1" lid="N.00008857.0001001.023">Clear the <ecam-data ecamimportance="A" type="alert"><ecamsys>VENT</ecamsys><ecamtitle>AVNCS SYS FAULT</ecamtitle></ecam-data> alert displayed on the <abb>EWD</abb> using the <tech-label type="pb">CLR</tech-label>.</para></command><comment code="00008857.0001001.011"><para layer="1" lid="N.00008857.0001001.024">The <ecam-data ecamimportance="A" type="alert"><ecamsys>VENT</ecamsys><ecamtitle>AVNCS SYS FAULT</ecamtitle></ecam-data> alert will be displayed after
landing.</para></comment></action></procbody></condition><inform layer="1" lid="N.00008857.0001001.016"><noteproc code="00008857.0001001.007" layer="1" lid="N.00008857.0001001.017"><limit layer="1" lid="N.00008857.0001001.018"><lit-limit lid="N.00008857.0001001.019">With only one air conditioning pack operative,
operating time on ground is limited to <measure category="Time" show-unit="true" system="SI and derived" unit="h">1</measure>.</lit-limit></limit></noteproc></inform></procbody></procitem><procitem layer="1" lid="N.00008857.0001001.025"><title>After takeoff</title><procbody lid="N.00008857.0001001.026"><action layer="1" lid="N.00008857.0001001.027" memory="false"><cr-action code="00008857.0001001.012"><challenge><tech-label type="pb-sw">EXTRACT</tech-label></challenge><response>AUTO</response></cr-action></action></procbody></procitem><procitem layer="1" lid="N.00008857.0001001.028"><title>After landing</title><procdesc code="00008857.0001001.029" lid="N.00008857.0001001.037"><note code="00008857.0001001.016" layer="1" lid="N.00008857.0001001.033"><para layer="1" lid="N.00008857.0001001.034">Due to temporary low-pressure
conditions, the <ecam-data ecamimportance="A" type="alert"><ecamsys>VENT</ecamsys><ecamtitle>BLOWER FAULT</ecamtitle></ecam-data> alert may appear when the <tech-label type="pb-sw">EXTRACT</tech-label> is not set to the
OVRD position.</para><para layer="1" lid="N.00008857.0001001.035">The flight crew should
disregard the associated <abb>ECAM</abb> procedure. The <ecam-data ecamimportance="A" type="alert"><ecamsys>VENT</ecamsys><ecamtitle>BLOWER FAULT</ecamtitle></ecam-data> alert disappears when the <tech-label type="pb-sw">EXTRACT</tech-label> is set to the OVRD position.</para></note></procdesc><procbody lid="N.00008857.0001001.029"><action layer="1" lid="N.00008857.0001001.030" memory="false"><cr-action code="00008857.0001001.013"><challenge><tech-label type="pb-sw">EXTRACT</tech-label></challenge><response>OVRD</response></cr-action></action></procbody></procitem></opsproc>