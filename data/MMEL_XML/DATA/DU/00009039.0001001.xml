<opsproc code="00009039.0001001" revdate="2010-03-11T15:37:21"><title><tech-label type="pb">PFD/ND XFR</tech-label> on the Lateral Instrument Panel</title><procitem layer="1" lid="N.00009039.0001001.004"><title>During cockpit preparation</title><procbody lid="N.00009039.0001001.005"><condition at-any-time="false" code="00009039.0001001.002" direct="false" layer="1" lid="N.00009039.0001001.006" subtitle="false" type="cond"><intro>On the side where the <tech-label type="pb">PFD/ND XFR</tech-label> is inoperative:</intro><procbody lid="N.00009039.0001001.007"><action-block lid="N.00009039.0001001.008"><action layer="1" lid="N.00009039.0001001.009" memory="false"><cr-action code="00009039.0001001.003"><challenge><tech-label type="knob">PFD brightness control</tech-label></challenge><response>OFF</response></cr-action></action><action layer="1" lid="N.00009039.0001001.010" memory="false"><command code="00009039.0001001.004"><para layer="1" lid="N.00009039.0001001.011">Check that the <abb>PFD</abb> image is automatically displayed on the <abb>NDU</abb>.</para></command></action><action layer="1" lid="N.00009039.0001001.013" memory="false"><cr-action code="00009039.0001001.005"><challenge><tech-label type="knob">PFD brightness control</tech-label></challenge><response>On</response></cr-action></action></action-block><condition at-any-time="false" code="00009039.0001001.007" direct="false" layer="1" lid="N.00009039.0001001.015" subtitle="false" type="cond"><intro>If the <abb>PFD</abb> image is not automatically
displayed on the <abb>NDU</abb>:</intro><procbody lid="N.00009039.0001001.018"><inform layer="1" lid="N.00009039.0001001.016"><para code="00009039.0001001.008" layer="1" lid="N.00009039.0001001.017">The affected side cannot be used by the Pilot Flying.</para></inform></procbody></condition></procbody></condition><condition at-any-time="false" code="00009039.0001001.009" direct="false" layer="1" lid="N.00009039.0001001.019" subtitle="false" type="cond"><intro>On the side where the <abb>PFD</abb> to <abb>ND</abb> automatic switching is inoperative: </intro><procbody lid="N.00009039.0001001.020"><action-block lid="N.00009039.0001001.021"><action layer="1" lid="N.00009039.0001001.022" memory="false"><cr-action code="00009039.0001001.010"><challenge><tech-label type="knob">PFD brightness control</tech-label></challenge><response>OFF</response></cr-action></action><action layer="1" lid="N.00009039.0001001.023" memory="false"><cr-action code="00009039.0001001.011"><challenge><tech-label type="sel">EIS DMC SWITCHING</tech-label> (Affected side)</challenge><response>CAPT 3 (F/O 3)</response></cr-action></action><action layer="1" lid="N.00009039.0001001.024" memory="false"><command code="00009039.0001001.012"><para layer="1" lid="N.00009039.0001001.025">Check that the <abb>PFD</abb> image is displayed on the associated <abb>NDU</abb>.</para></command></action><action layer="1" lid="N.00009039.0001001.026" memory="false"><cr-action code="00009039.0001001.013"><challenge><tech-label type="knob">PFD brightness control</tech-label></challenge><response>On</response></cr-action></action><action layer="1" lid="N.00009039.0001001.027" memory="false"><cr-action code="00009039.0001001.014"><challenge><tech-label type="knob">EIS DMC SWITCHING</tech-label> (Affected side)</challenge><response>NORM</response></cr-action></action></action-block></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00009039.0001001.028"><title>In flight</title><procbody lid="N.00009039.0001001.029"><condition at-any-time="false" code="00009039.0001001.015" direct="false" layer="1" lid="N.00009039.0001001.030" subtitle="false" type="cond"><intro>If a <abb>PFDU</abb> fails with no automatic transfer to the
associated <abb>NDU</abb>:</intro><procbody lid="N.00009039.0001001.031"><action-block lid="N.00009039.0001001.032"><action layer="1" lid="N.00009039.0001001.033" memory="false"><cr-action code="00009039.0001001.016"><challenge><tech-label type="knob">PFD brightness control</tech-label></challenge><response>OFF</response></cr-action></action><action layer="1" lid="N.00009039.0001001.034" memory="false"><cr-action code="00009039.0001001.017"><challenge><tech-label type="sel">EIS DMC SWITCHING</tech-label> (Affected side)</challenge><response>CAPT 3 (F/O 3)</response></cr-action></action><action layer="1" lid="N.00009039.0001001.035" memory="false"><command code="00009039.0001001.018"><para layer="1" lid="N.00009039.0001001.036">Check that the <abb>PFD</abb> image is displayed on the associated <abb>NDU</abb>.</para></command></action></action-block></procbody></condition></procbody></procitem></opsproc>