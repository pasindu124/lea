<opsproc code="00023743.0004001" revdate="2019-11-19T16:04:07"><title><if-installed>Global Positioning System (<abb>GPS</abb>)</if-installed> (ADS-B OUT function DO260 or DO260B compliant)</title><procitem layer="1" lid="N.00023743.0004001.001"><title>FLIGHT PREPARATION/LIMITATIONS</title><procbody lid="N.00023743.0004001.002"><condition at-any-time="false" code="00023743.0004001.001" direct="false" layer="1" lid="N.00023743.0004001.003" subtitle="false" type="cond"><intro>If one <abb>GPS</abb> is inoperative:</intro><procbody lid="N.00023743.0004001.004"><limit layer="1" lid="N.00023743.0004001.005"><lit-limit lid="N.00023743.0004001.006">For aircraft
