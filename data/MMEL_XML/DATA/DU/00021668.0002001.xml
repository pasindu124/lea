<opsproc code="00021668.0002001" revdate="2017-05-03T18:14:12"><title>Flight Management System (FMS) (Flight within radio navaids)</title><procitem layer="1" lid="N.00021668.0002001.001"><title>Flight Preparation/Limitations</title><procbody lid="N.00021668.0002001.002"><limit layer="1" lid="N.00021668.0002001.003"><lit-limit lid="N.00021668.0002001.004">For aircraft with the <abb>RNP</abb> <abb>AR</abb> capability, <abb>RNP</abb> <abb>AR</abb> operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00021668.0002001.005"><lit-limit lid="N.00021668.0002001.006">Maximum landing capability is CAT 3 SINGLE.</lit-limit></limit><condition at-any-time="false" code="00021668.0002001.006" direct="false" layer="1" lid="N.00021668.0002001.013" subtitle="false" type="cond"><intro>If the <abb>NAV</abb> BACK/UP function is inoperative:</intro><procbody lid="N.00021668.0002001.014"><limit layer="1" lid="N.00021668.0002001.015"><lit-limit lid="N.00021668.0002001.016"><abb>RNAV</abb> 10 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00021668.0002001.017"><lit-limit lid="N.00021668.0002001.018"><abb>RNP</abb> 4 operations
are not permitted.</lit-limit></limit><limit layer="1" lid="N.00021668.0002001.019"><lit-limit lid="N.00021668.0002001.020"><abb>RNP</abb> 2 operations
in oceanic and remote continental area are not permitted.</lit-limit></limit></procbody></condition></procbody></procitem></opsproc>