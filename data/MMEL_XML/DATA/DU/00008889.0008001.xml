<opsproc code="00008889.0008001" revdate="2026-05-20T16:54:58"><title>Air Conditioning Pack (One Air Conditioning Pack Inoperative)</title><procitem layer="1" lid="N.00008889.0008001.015"><title>FLIGHT PREPARATION/LIMITATIONS</title><procbody lid="N.00008889.0008001.016"><condition at-any-time="false" code="00008889.0008001.005" direct="false" layer="1" lid="N.00008889.0008001.017" subtitle="false" type="cond"><intro>If Pack 1 is inoperative:</intro><procbody lid="N.00008889.0008001.018"><inform layer="1" lid="N.00008889.0008001.019"><para code="00008889.0008001.006" layer="1" lid="N.00008889.0008001.020">One engine taxi is not permitted.</para></inform></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00008889.0008001.021"><title>During preliminary cockpit preparation</title><procbody lid="N.00008889.0008001.022"><action-block lid="N.00008889.0008001.023"><title>Check of the trim air check valve on the affected side:</title><action layer="1" lid="N.00008889.0008001.024" memory="false"><command code="00008889.0008001.007"><para layer="1" lid="N.00008889.0008001.025">Ensure that the not affected
pack is supplied by the <abb>HP</abb> ground air unit or by the <abb>APU</abb> bleed.</para></command></action><action layer="1" lid="N.00008889.0008001.026" memory="false"><cr-action code="00008889.0008001.008"><challenge><tech-label type="s-page">BLEED</tech-label></challenge><response>SELECT</response></cr-action></action><action layer="1" lid="N.00008889.0008001.027" memory="false"><cr-action code="00008889.0008001.009"><challenge>PACK (NOT AFFECTED)</challenge><response>CHECK ON</response></cr-action></action><action layer="1" lid="N.00008889.0008001.028" memory="false"><command code="00008889.0008001.010"><para layer="1" lid="N.00008889.0008001.029">Check that the affected outlet
temperature is displayed.</para></command></action><action layer="1" lid="N.00008889.0008001.030" memory="false"><cr-action code="00008889.0008001.011"><challenge>PACK OUTLET TEMP (AFFECTED)</challenge><response>MONITOR FOR <measure category="Time" show-unit="true" system="SI and derived" unit="s">90</measure></response></cr-action><comment code="00008889.0008001.013"><para layer="1" lid="N.00008889.0008001.032">Check that the affected
pack outlet temperature does not increase.</para></comment></action></action-block></procbody></procitem><procitem layer="1" lid="N.00008889.0008001.004"><title>During cockpit preparation</title><procbody lid="N.00008889.0008001.005"><action layer="1" lid="N.00008889.0008001.006" memory="false"><cr-action code="00008889.0008001.002"><challenge><tech-label type="pb-sw">ECON FLOW</tech-label></challenge><response>OFF</response></cr-action></action></procbody></procitem><procitem layer="1" lid="N.00008889.0008001.007"><title>In flight</title><procbody lid="N.00008889.0008001.008"><condition at-any-time="false" code="00008889.0008001.003" direct="false" layer="1" lid="N.00008889.0008001.009" subtitle="false" type="cond"><intro>If <tech-label type="pb-sw">BLOWER</tech-label> and <tech-label type="pb-sw">EXTRACT</tech-label> are set
to OVRD:</intro><procbody lid="N.00008889.0008001.010"><inform layer="1" lid="N.00008889.0008001.011"><unlist bulltype="NDASH" code="00008889.0008001.004" layer="1" lid="N.00008889.0008001.012"><item layer="1"><para layer="1" lid="N.00008889.0008001.013">The cabin altitude
may reach about <measure category="Length" show-unit="true" system="US" unit="ft">9700</measure>, and</para></item><item layer="1"><para layer="1" lid="N.00008889.0008001.014">The <ecam-data ecamimportance="R" type="alert"><ecamsys>CAB PR</ecamsys><ecamtitle>EXCESS CAB ALT</ecamtitle></ecam-data> alert may be displayed on
the <abb>EWD</abb>.</para></item></unlist></inform></procbody></condition></procbody></procitem></opsproc>