<dispatchitem code="00007667.0009001" func-code="33-51-01" item-list-nbr="01" revdate="2018-04-05T00:00:00"><title>Exit Marking Sign</title><ditembody nb-installed="8"><dispcond code="00007667.0009001.001" dispcond-id="D10459" dispcond-label="A" lid="N.00007667.0009001.001"><title>A maximum of three non-adjacent <abb>LED</abb>s/bulbs inoperative</title><normal-dispcond nb-required="8" rectification-interval="C"><remark><requirement lid="N.00007667.0009001.002" req-id="R10460"><para code="00007667.0009001.002" layer="1" lid="N.00007667.0009001.003">A maximum of three non-adjacent <abb>LED</abb>s/bulbs may be inoperative
in one or more signs.</para></requirement></remark></normal-dispcond></dispcond><dispcond code="00007667.0009001.003" dispcond-id="D10461" dispcond-label="B" lid="N.00007667.0009001.004"><title>Associated exit considered inoperative</title><normal-dispcond nb-required="7" rectification-interval="A"><remark><requirement lid="N.00007667.0009001.005" req-id="R10462"><para code="00007667.0009001.004" layer="1" lid="N.00007667.0009001.006">One may be inoperative for 5 flights provided that the associated
