<opsproc code="00009054.0003001" revdate="2018-04-05T16:27:52"><title>Angle of Attack (AOA) Probes Heating (F/O inoperative)</title><procitem layer="1" lid="N.00009054.0003001.001"><title>Flight preparation/limitations</title><procbody lid="N.00009054.0003001.002"><condition at-any-time="false" code="00009054.0003001.001" direct="false" layer="1" lid="N.00009054.0003001.003" subtitle="false" type="cond"><intro>If icing conditions are encountered during the flight:</intro><procbody lid="N.00009054.0003001.004"><limit layer="1" lid="N.00009054.0003001.005"><lit-limit lid="N.00009054.0003001.006">Maximum
landing capability may be downgraded to CAT 3 SINGLE.</lit-limit></limit></procbody></condition></procbody></procitem><procitem layer="1" lid="N.00009054.0003001.007"><title>During cockpit preparation</title><procbody lid="N.00009054.0003001.008"><action layer="1" lid="N.00009054.0003001.009" memory="false"><cr-action code="00009054.0003001.003"><challenge><tech-label type="sel">AIR DATA</tech-label></challenge><response>F/O 3</response></cr-action></action></procbody></procitem><procitem layer="1" lid="N.00009054.0003001.010"><title>IN FLIGHT</title><procbody lid="N.00009054.0003001.011"><ex-conditions lid="N.00009054.0003001.027"><condition at-any-time="false" code="00009054.0003001.008" direct="false" layer="1" lid="N.00009054.0003001.019" subtitle="false" type="cond"><intro>In the case of failure of the <abb>CAPT</abb> alpha probe heater:</intro><procbody lid="N.00009054.0003001.020"><action layer="1" lid="N.00009054.0003001.021" memory="false"><command code="00009054.0003001.009"><para layer="1" lid="N.00009054.0003001.022">Apply <ecam-data ecamimportance="A" type="alert"><ecamsys>ANTI ICE</ecamsys><ecamtitle>CAPT+F/O AOA</ecamtitle></ecam-data> <abb>ECAM</abb> procedure.</para></command></action></procbody></condition><condition at-any-time="false" code="00009054.0003001.010" direct="false" layer="1" lid="N.00009054.0003001.023" subtitle="false" type="cond"><intro>In the case of failure of the <abb>STBY</abb> alpha probe heater:</intro><procbody lid="N.00009054.0003001.024"><action layer="1" lid="N.00009054.0003001.025" memory="false"><command code="00009054.0003001.011"><para layer="1" lid="N.00009054.0003001.026">Apply <ecam-data ecamimportance="A" type="alert"><ecamsys>ANTI ICE</ecamsys><ecamtitle>F/O+STBY AOA</ecamtitle></ecam-data> <abb>ECAM</abb> procedure.</para></command></action></procbody></condition></ex-conditions></procbody></procitem></opsproc>