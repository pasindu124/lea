<opsproc code="00021668.0001001" revdate="2017-05-03T18:14:14"><title>Flight Management System (FMS) (Flight within radio navaids)</title><procitem layer="1" lid="N.00021668.0001001.001"><title>Flight Preparation/Limitations</title><procbody lid="N.00021668.0001001.002"><limit layer="1" lid="N.00021668.0001001.003"><lit-limit lid="N.00021668.0001001.004">For aircraft with the <abb>RNP</abb> <abb>AR</abb> capability, <abb>RNP</abb> <abb>AR</abb> operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00021668.0001001.005"><lit-limit lid="N.00021668.0001001.006">Maximum landing capability is CAT 3 SINGLE.</lit-limit></limit><limit layer="1" lid="N.00021668.0001001.007"><lit-limit lid="N.00021668.0001001.008"><abb>RNAV</abb> 10 operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00021668.0001001.009"><lit-limit lid="N.00021668.0001001.010"><abb>RNP</abb> 4 operations are not permitted.</lit-limit></limit><limit layer="1" lid="N.00021668.0001001.011"><lit-limit lid="N.00021668.0001001.012"><abb>RNP</abb> 2 operations in oceanic and remote continental area
are not permitted.</lit-limit></limit></procbody></procitem></opsproc>