er="1" lid="N.00024450.0008001.007"><title>Before Engine Start</title><procbody lid="N.00024450.0008001.008"><action layer="1" lid="N.00024450.0008001.009" memory="false"><cr-action code="00024450.0008001.005"><challenge><tech-label type="sel">X BLEED</tech-label></challenge><response>OPEN</response></cr-action></action><action layer="1" lid="N.00024450.0008001.010" memory="false"><cr-action code="00024450.0008001.006"><challenge><tech-label type="pb-sw">APU BLEED</tech-label></challenge><response>AS RQRD</response></cr-action><comment code="00024450.0008001.007"><note code="00024450.0008001.008" layer="1" lid="N.00024450.0008001.011"><para layer="1" lid="N.00024450.0008001.012">The use of the <abb>APU</abb> bleed air supply system is permitted for Main Engine Start.</para></note></comment></action></procbody></procitem><procitem layer="1" lid="N.00024450.0008001.013"><title>After Engine Start</title><procbody lid="N.00024450.0008001.014"><action layer="1" lid="N.00024450.0008001.015" memory="false"><cr-action code="00024450.0008001.009"><challenge><tech-label type="sel">X BLEED</tech-label></challenge><response>SHUT</response></cr-action></action><action layer="1" lid="N.00024450.0008001.016" memory="false"><cr-action code="00024450.0008001.010"><challenge><tech-label type="pb-sw">APU BLEED</tech-label></challenge><response>Off</response></cr-action></action></procbody></procitem><procitem layer="1" lid="N.00024450.0008001.017"><title>In flight</title><procbody lid="N.00024450.0008001.018"><condition at-any-time="false" code="00024450.0008001.011" direct="false" layer="1" lid="N.00024450.0008001.019" subtitle="false" type="cond"><intro>In the case of failure of the remaining engine bleed air supply
