<!-- ============================================================= -->
<!-- ENTITIES                                                      -->
<!-- ============================================================= -->

<!ENTITY % extensionContent.Grp "">
<!ENTITY % ftnoteType "">
<!ENTITY % ops-exch SYSTEM "ops-exch.dtd">
%ops-exch;
<!ENTITY % entryType '(para|unlist|numlist|warning|caution|note|graphref|launcher|equal|desc-cond|ex-desc-cond|row-header|measure)*'>

<!ENTITY % procbody.Grp "((action | action-block | limit | inform | condition | ex-conditions | relevant-sub-proc)+)">

<!ENTITY % actionType "((cr-action | command), comment?)">
<!ENTITY % extensionCondition.Grp "">
<!ENTITY % proc-exch SYSTEM "proc-exch.dtd">
%proc-exch;
<!ENTITY % sl-exch SYSTEM "sl-exch.dtd">
%sl-exch;
<!ENTITY % func-code.GlobalAttr "
	func-code	CDATA	#REQUIRED ">
	
<!-- ============================================================= -->
<!-- ELEMENTS                                                      -->
<!-- ============================================================= -->

<!ELEMENT entry (%entryType;)>

<!ELEMENT procbody ((%procbody.Grp;)+)>
<!ATTLIST procbody
	%linktargetid.AttGrp; 
>
<!ELEMENT relevant-sub-proc (title?,(%procbody.Grp;)+)>
<!ATTLIST relevant-sub-proc
	%linktargetid.AttGrp; 
>

<!ELEMENT opsproc (reason?, title, procdesc?, (procbody | procitem), procitem*)>
<!ATTLIST opsproc
	%duIdent.AttGrp; 
	%context.AttGrp; 
	%opStand.AttGrp;
>
<!ELEMENT procitem (title, procdesc?, (procbody | procitem), procitem*)>
<!ATTLIST procitem
	%layer.AttGrp; 
	%context.AttGrp; 
	%linktargetid.AttGrp;
	%opStand.AttGrp;
>

<!ATTLIST action
	%action.AttGrp; 
	%layer.AttGrp; 
	%linktargetid.AttGrp;
	%opStand.AttGrp;
>