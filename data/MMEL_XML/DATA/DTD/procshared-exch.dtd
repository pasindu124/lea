<!ENTITY % descbodyType '(%fullBasicStructType;|desc-cond|ex-desc-cond|whatif)+'>

<!ENTITY % action-exch SYSTEM "action-exch.dtd">
%action-exch;

<!ENTITY % itemType '(%fullBasicStructType;)'>

<!ENTITY % row.att        '%linktargetid.AttGrp;'>

<!ENTITY % procdescType '(%fullBasicStructType;|whatif)*'>  

<!-- ============================================================= -->
<!-- ELEMENTS                                                      -->
<!-- ============================================================= -->

<!ELEMENT condbody   (%descbodyType;) >

<!ELEMENT command   (%fullBasicStructType;) >
<!ATTLIST command
	%do.AttGrp;
>

<!ELEMENT item   (%itemType;)>
<!ATTLIST item
	%layer.AttGrp; 
	%opStand.AttGrp;
>

<!ENTITY % supplementaryProc.AttGrp "
    supproc-layout (true | false) #IMPLIED">
