<!-- ============================================================= -->
<!-- ENTITIES                                                      -->
<!-- ============================================================= -->

<!ENTITY % revisions-elem-type 'type (product| psl | group | du-inv | du-sol | anchor) #REQUIRED'>

<!ENTITY % revisionsType '(highlights?, rev-marks)'>

<!-- ============================================================= -->
<!-- ELEMENTS                                                      -->
<!-- ============================================================= -->

<!ELEMENT hl-ref EMPTY>
<!ATTLIST hl-ref
	ref IDREF #REQUIRED
>
<!ELEMENT rev (hl-ref*)>
<!ATTLIST rev
	chg (R | N | M | H | E | ER | MR) #REQUIRED
	path CDATA #REQUIRED
	origin (airbus | operator) "operator"
	anchor (true | false) #REQUIRED
>
<!ELEMENT elemid (#PCDATA)>
<!ATTLIST elemid
	%revisions-elem-type;
	code CDATA #IMPLIED
>
<!ELEMENT revdate (#PCDATA)>
<!ELEMENT idfrom (#PCDATA)>
<!ATTLIST idfrom
	%revisions-elem-type; 
>
<!ELEMENT idto (#PCDATA)>
<!ATTLIST idto
	%revisions-elem-type; 
>
<!-- definition for 'parahl' element is simplified according the schema 6.0 -->
<!ELEMENT parahl (#PCDATA)>

<!ELEMENT item (parahl+)>
<!ELEMENT unlist (item+)>
<!ELEMENT highlight (automatic | authoring)>
<!ATTLIST highlight
	date CDATA #REQUIRED
	hl-id ID #REQUIRED
	unreferenced (true | false) #IMPLIED
>
<!ELEMENT automatic (hl-del | hl-effect | hl-move | hl-minor | hl-rename | hl-dtd)>
<!ELEMENT authoring (parahl | unlist)+>
<!ATTLIST authoring
	type (major | minor | metadata) #REQUIRED
>

<!ELEMENT hl-rename (elemid)>
<!ATTLIST hl-rename
	oldcode CDATA #IMPLIED
	oldtitle CDATA #IMPLIED
>


<!ELEMENT hl-dtd EMPTY>
<!ELEMENT hl-del ((elemid, revdate?, title?) | attribute+ | content-elem)>
<!ELEMENT attribute (#PCDATA)>
<!ELEMENT content-elem EMPTY>
<!ELEMENT hl-effect (msnadd | msndel | add-del)>
<!ELEMENT msnadd (msn+ | theallvalue)>
<!ELEMENT msndel (msn+ | theallvalue)>
<!ELEMENT msn (#PCDATA)>
<!ELEMENT theallvalue EMPTY>
<!ELEMENT add-del (msnadd, msndel)>
<!ELEMENT hl-move (elemid, idfrom, idto)>
<!ELEMENT hl-minor EMPTY>
<!ELEMENT highlights (highlight+)>
<!ELEMENT rev-marks (rev+)>

<!ELEMENT mdata-revisions (%revisionsType;)>
<!ELEMENT content-revisions (%revisionsType;)>
