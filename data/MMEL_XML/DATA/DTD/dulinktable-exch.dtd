<!-- The following set of declarations may be referred to  using 
     the public entity as follows:
     <!DOCTYPE dulinktable PUBLIC
        "-//AIRBUS OPS//DTD DULINKTABLE_EXCH-VER10.0//EN"   [ ]>    -->


<!-- ============================================================= -->
<!-- ELEMENTS                                                      -->
<!-- ============================================================= -->

<!-- remarks : the regular expressions for attributes are not translated in this DTD -->
<!ELEMENT dulinktable (source*)>
<!ELEMENT source (duref | tduref)+>
<!-- 'inv-id' attribute of 'source' element is required -->
<!ATTLIST source
	solution-code CDATA #REQUIRED
	inv-id CDATA #REQUIRED
	func-code CDATA #IMPLIED
>
<!ELEMENT duref (opsprocref | dispatchitemref | milopsitemref)?>
<!ATTLIST duref
	product CDATA #REQUIRED
	targetinvid CDATA #REQUIRED
	invtitle CDATA #IMPLIED
	found (true | false) "true"
	ps-path CDATA #IMPLIED
>
<!ELEMENT tduref EMPTY>
<!ATTLIST tduref
	targetinvid CDATA #REQUIRED
	invtitle CDATA #IMPLIED
	found (true | false) "true"
>
<!ELEMENT opsprocref EMPTY>
<!ATTLIST opsprocref
	dispcond-id CDATA #IMPLIED
	dispcond-label CDATA #IMPLIED
	milopscond-label CDATA #IMPLIED
	impactedmilops-label CDATA #IMPLIED
>
<!ELEMENT dispatchitemref EMPTY>
<!ATTLIST dispatchitemref
	func-code CDATA #IMPLIED
>
<!ELEMENT milopsitemref EMPTY>
