<!-- ============================================================= -->
<!-- ENTITIES                                                      -->
<!-- ============================================================= -->

<!ENTITY % extensionContent.Grp "">
<!ENTITY % ftnoteType "">
<!ENTITY % ops-exch SYSTEM "ops-exch.dtd">
%ops-exch;
<!ENTITY % itemType "%fullBasicStructType;">

<!ENTITY % descbodyType "((%fullBasicStructType; | desc-cond | ex-desc-cond | whatif)+)">

<!ENTITY % ecam-exch SYSTEM "ecam-exch.dtd">
%ecam-exch;
<!ENTITY % xtitle-exch SYSTEM "xtitle-exch.dtd">
%xtitle-exch;

<!ENTITY % entryType '(para|unlist|numlist|warning|caution|note|graphref|launcher|equal|desc-cond|ex-desc-cond|row-header|measure)*'>

<!ENTITY % row.att '%linktargetid.AttGrp;'>

<!-- ============================================================= -->
<!-- ELEMENTS                                                      -->
<!-- ============================================================= -->

<!ELEMENT item (%itemType;)>
<!ATTLIST item
	%layer.AttGrp; 
>
<!ELEMENT routing (actual | false | cond-routing)>
<!ATTLIST routing
	%do.AttGrp; 
	%linktargetid.AttGrp; 
>
<!ELEMENT false EMPTY>
<!ELEMENT actual EMPTY>
<!ELEMENT dispatch-assessment (not-applicable | no-dispatch | dispatchitemref | complementary-actions | dablock)>
<!ATTLIST dispatch-assessment
	%do.AttGrp; 
	%linktargetid.AttGrp; 
>
<!ELEMENT not-applicable (comment?)>
<!ELEMENT no-dispatch (comment?)>
<!ELEMENT ext-action (duref)>
<!ELEMENT affectedsystem (context-link?)>
<!ELEMENT dispatchitemref (duref, comment?)>
<!ELEMENT dablock ((dispatchitemref | complementary-actions)+)>
<!ATTLIST dablock
	operator (AND | OR) #REQUIRED
>

<!ELEMENT condbody (%descbodyType;)>

<!ELEMENT malfunctionitem (title, malfunctionbody)>
<!ATTLIST malfunctionitem
	%do.AttGrp;
	%layer.AttGrp;
	%context.AttGrp;
	%linktargetid.AttGrp;
	%opStand.AttGrp;
>

<!ELEMENT malfunctionbody %fullBasicStructType;>
<!ATTLIST malfunctionbody
	%do.AttGrp;
	%linktargetid.AttGrp;
>

<!ELEMENT malfunctionassessment (reason?, xtitle, comment?, malfunctionitem?, assessment+, malfunctionitem?)>
<!ATTLIST malfunctionassessment
	type (ecamwarning | ecamcaution | crewobservation | localwarning | efisflag | dispatchmessage) #REQUIRED
	fault-code CDATA #IMPLIED
	%duIdent.AttGrp; 
	%context.AttGrp; 
>
<!ELEMENT assessment (routing?, dispatch-assessment)>
<!ATTLIST assessment
	%context.AttGrp; 
	%linktargetid.AttGrp; 
>
<!ELEMENT cond-routing (intro, complementary-actions?)>
<!ATTLIST cond-routing
	%context.AttGrp; 
>
<!ELEMENT complementary-actions ((ext-action | para | command | affectedsystem)+, comment?)>
<!ELEMENT command %fullBasicStructType;>
<!ATTLIST command
	%do.AttGrp; 
>

<!ELEMENT entry (%entryType;)>

<!ATTLIST title
	%ecam.AttGrp; 
>
