<!-- ============================================================= -->
<!-- ENTITIES                                                      -->
<!-- ============================================================= -->

<!ENTITY % contententry.Grp "((action | inform | clsynchro | proctitle | condintro| measure)+)">

<!ENTITY % synthesisentry.Grp "((action|inform|proctitle|condintro)*)">

<!-- ============================================================= -->
<!-- ELEMENTS                                                      -->
<!-- ============================================================= -->

<!ELEMENT role EMPTY>
<!ATTLIST role 
	name	CDATA	#REQUIRED	
>

<!ELEMENT clsynchro %contentType;>
<!ATTLIST clsynchro 
	type	(start|end)	#IMPLIED	
	%do.AttGrp;
	%layer.AttGrp;
	%linktargetid.AttGrp;
>

<!ELEMENT condintro %contentType;>
<!ATTLIST condintro 
	%do.AttGrp;
	%layer.AttGrp;
	%linktargetid.AttGrp;
>

<!ELEMENT proctitle %contentType;>
<!ATTLIST proctitle 
	type	(normal|transit)	#IMPLIED	
	%do.AttGrp;
	%layer.AttGrp;
	%linktargetid.AttGrp;
>
