<!-- ELEMENTS                                                      -->
<!-- ============================================================= -->

<!ELEMENT fsn EMPTY>
<!ATTLIST fsn
    fsn CDATA #REQUIRED
    cus-code CDATA #REQUIRED
>

<!ELEMENT aircraft-item	(fsn*)>
<!ATTLIST aircraft-item
    msn CDATA #REQUIRED
    acn CDATA #IMPLIED
    aircraft-model CDATA #REQUIRED	
>

<!ELEMENT aat (aircraft-item+ | all)>