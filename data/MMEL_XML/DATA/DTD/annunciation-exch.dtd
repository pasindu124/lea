<!-- ============================================================= -->
<!-- ELEMENTS                                                      -->
<!-- ============================================================= -->

<!ELEMENT annunciation  (triggering-conditions?,annunciations) >
<!ATTLIST annunciation
	%layer.AttGrp;
	%linktargetid.AttGrp;
>

<!ELEMENT cockpit-announcement %contentAndLinksType;>

<!ATTLIST cockpit-announcement 
	%linktargetid.AttGrp;
>

<!ELEMENT localisation-overview (graphref) >

<!ELEMENT cabin-announcement %contentAndLinksType; >
<!ATTLIST cabin-announcement
	%linktargetid.AttGrp;
>

<!ELEMENT annunciations   (localisation-overview?,auralwarning?,masterlight?,locallights?,systempagecall?,simultaneousdisplay?,flight-phase-inhib?,other-inhib?,cockpit-announcement?,cabin-announcement?) >
<!ATTLIST annunciations
	%do.AttGrp;
	%layer.AttGrp;
	%linktargetid.AttGrp;
>

<!ELEMENT masterlight (symbol) >
<!ATTLIST masterlight
	type (warning|caution|fap-caution) #REQUIRED
	%do.AttGrp;
	%layer.AttGrp;
	%linktargetid.AttGrp;
	%ecam.AttGrp;
>

<!ELEMENT locallights   (locallight+) >

<!ELEMENT systempagecall   (systempage+) >
<!ATTLIST systempagecall
	%do.AttGrp;
	%layer.AttGrp;
	%linktargetid.AttGrp;
	type (fap-page|sd-page) #IMPLIED
>

<!ELEMENT simultaneousdisplay ((%links.Grp; | symbol), para?)>
<!ATTLIST simultaneousdisplay
	%do.AttGrp; 
	%linktargetid.AttGrp;
	%layer.AttGrp;
	type (CargoAlert | CockpitAlert) #IMPLIED
	%ecam.AttGrp; 
>

<!ELEMENT flight-phase-inhib   (flight-phase*,graphref) >
<!ATTLIST flight-phase-inhib
	%do.AttGrp;
	%linktargetid.AttGrp;
>

<!ELEMENT other-inhib   (para | unlist)+ >
<!ATTLIST other-inhib
	%do.AttGrp;
	%linktargetid.AttGrp;
>

<!ELEMENT flight-phase   EMPTY >
<!ATTLIST flight-phase
	pof CDATA #REQUIRED
	%ecam.AttGrp;
>

