<!-- ============================================================= -->
<!-- ENTITIES                                                      -->
<!-- ============================================================= -->

<!ENTITY % action.AttGrp "
type (normal|transit) #IMPLIED
memory (true|false)   'false'
crm-fc CDATA #IMPLIED
crm-cc CDATA #IMPLIED
%ecam.AttGrp;">

<!-- ============================================================= -->
<!-- ELEMENTS                                                      -->
<!-- ============================================================= -->

<!ELEMENT action (%actionType;)>

<!ELEMENT cr-action (challenge, response)>
<!ATTLIST cr-action
	%do.AttGrp;
>

<!ELEMENT field EMPTY>

<!ELEMENT challenge %contentType;>

<!ELEMENT response (#PCDATA|%baseContentAndLinksType;|extobject|
    %extapplication.Grp;|field)*>
