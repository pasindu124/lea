<!-- ============================================================= -->
<!-- ENTITIES                                                      -->
<!-- ============================================================= -->

<!ENTITY % ecam-exch SYSTEM "ecam-exch.dtd">
%ecam-exch;
<!ENTITY % procshared-exch SYSTEM "procshared-exch.dtd">
%procshared-exch;

<!ENTITY % wcnProc.Grp '(warningproc|cautionproc|noteproc)'>

<!ENTITY % wcnprocType '((%interBasicStructType;|desc-cond)+|%procbody.Grp;)'>

<!ENTITY % noteprocType '((%interBasicStructType;|graphref|desc-cond)+|%procbody.Grp;)'>

<!ENTITY % descbodyType '(%fullBasicStructType;|desc-cond|ex-desc-cond|whatif)+'>

<!-- ============================================================= -->
<!-- ELEMENTS                                                      -->
<!-- ============================================================= -->

<!ELEMENT procdesc   (%procdescType;) >
<!ATTLIST procdesc
	%do.AttGrp;
	%linktargetid.AttGrp;
>

<!ELEMENT warningproc %wcnprocType; >

<!ATTLIST warningproc
	%layer.AttGrp;
	%do.AttGrp;
	%linktargetid.AttGrp;
>

<!ELEMENT cautionproc %wcnprocType; >

<!ATTLIST cautionproc
	%layer.AttGrp;
	%do.AttGrp;
	%linktargetid.AttGrp;
>

<!ELEMENT noteproc %noteprocType; >

<!ATTLIST noteproc
	%layer.AttGrp;
	%do.AttGrp;
	%linktargetid.AttGrp;
>

<!ELEMENT ecam-info (para+, comment?)>
<!ATTLIST ecam-info
	%do.AttGrp;
	%layer.AttGrp;
	%ecam.AttGrp;
	%linktargetid.AttGrp;
	%opStand.AttGrp;	
>

<!ELEMENT inform   (%interBasicStructType;|table|graphref|launcher|whatif|%wcnProc.Grp;)+ >
<!ATTLIST inform
	%layer.AttGrp;
	%linktargetid.AttGrp;
	%opStand.AttGrp;
>

<!ELEMENT endofproc EMPTY >

<!ELEMENT condition   ((intro|introblock),procdesc?,procbody %extensionCondition.Grp;,endofproc?) >
<!ATTLIST condition
	type (cond|phase|alinfo|cond-phase) "cond" 
	%do.AttGrp;
	%layer.AttGrp;
	subtitle (true|false) "false" 
	%linktargetid.AttGrp;
	%ecam.AttGrp; 
	%context.AttGrp;
	direct  (true|false) "false" 
	at-any-time (true|false) "false"
	%opStand.AttGrp;
>

<!ELEMENT introblock   (intro,intro+) >
<!ATTLIST introblock
	operator (AND|OR) #REQUIRED >

<!ELEMENT ex-conditions   (condition,condition+) >
<!ATTLIST ex-conditions
	%ecam.AttGrp; 
	%linktargetid.AttGrp; 
	%opStand.AttGrp; 
>

<!ELEMENT action-block   (title?, inform?, (action,action+)) >
<!ATTLIST action-block
	%linktargetid.AttGrp;
	%context.AttGrp;
	%opStand.AttGrp;
>

<!ELEMENT limit ((lit-limit|perf-value),comment?) >
<!ATTLIST limit
	%ecam.AttGrp;
	%layer.AttGrp;
	%linktargetid.AttGrp;
	impact (perfo|other) #IMPLIED
	%opStand.AttGrp;
>

<!ELEMENT lit-limit %contentAndLinksType;>
<!ATTLIST lit-limit
	%ecam.AttGrp;
	%linktargetid.AttGrp;
>

<!ELEMENT perf-value (perf,value) >
<!ATTLIST perf-value
	%doopt.AttGrp;
>

<!ELEMENT starting-point EMPTY>
