<!-- ============================================================= -->
<!-- ENTITIES                                                      -->
<!-- ============================================================= -->

<!ENTITY % acranges-exch SYSTEM "acranges-exch.dtd">
%acranges-exch;

<!ENTITY  % critFull.AttGrp '
	crit-id CDATA #REQUIRED
	crit-type CDATA #REQUIRED
	crit-rev CDATA #IMPLIED
	crit-origin (true | false) #IMPLIED'
>

<!ENTITY  % critBase.AttGrp '
	crit-id CDATA #REQUIRED
	crit-type CDATA #REQUIRED'
>

<!-- ============================================================= -->
<!-- ELEMENTS                                                      -->
<!-- ============================================================= -->

<!ELEMENT  pre-crit (aircraft-range) >

<!ELEMENT  post-crit (%acrangeType;) >

<!ELEMENT  single-appli (post-crit?) >
<!ATTLIST single-appli 
	%critFull.AttGrp;
>

<!ELEMENT  crit-emb (%acrangeType;) >

<!ELEMENT  crit-sch (aircraft-range) >

<!ELEMENT  post-crit-es (crit-emb?, crit-sch?) >

<!ELEMENT  dual-appli (pre-crit?, post-crit-es?) >
<!ATTLIST dual-appli 
	%critFull.AttGrp; 
>

<!ELEMENT crit-list ((dual-appli*), (single-appli*)) >

<!ELEMENT para (#PCDATA)>

<!ELEMENT text-formula (para+) >

<!ELEMENT crit EMPTY >
<!ATTLIST crit 
	%critFull.AttGrp; 
>

<!ELEMENT cond EMPTY >
<!ATTLIST cond 
	%critBase.AttGrp; 
>

<!ELEMENT grp (operator) >
<!ATTLIST grp 
	type (abstract|techcontext|techcond|grplv1|grplv2|valid|regulation|client|dismiss|military|operational) #IMPLIED 
>

<!ELEMENT operator (grp*, (crit+ | cond+)?) >
<!ATTLIST operator 
	type (and|or|andnot) #REQUIRED 
>

<!ELEMENT struct-formula (operator) >

<!ELEMENT formula (text-formula?, struct-formula?) >
<!ATTLIST formula 
	type (CCM|ECM|OPE) #REQUIRED 
>

<!ELEMENT techcond (formula?, crit-list) >

<!ELEMENT opecond (formula) >

<!ELEMENT effect   (aircraft-ranges?, techcond, opecond?) >
<!ATTLIST effect
	type (MSN) #REQUIRED
	len NMTOKEN #REQUIRED
>
