<!-- The following set of declarations may be referred to  using 
     the public entity as follows:
     <!DOCTYPE productmdata PUBLIC
        "-//AIRBUS OPS//DTD PRODUCTMDATA_EXCH-VER10.0//EN"   [ ]>   -->

<!-- ============================================================= -->
<!-- ENTITIES                                                      -->
<!-- ============================================================= -->

<!ENTITY % lom-exch SYSTEM "lom-exch.dtd">
%lom-exch;

<!ENTITY % aat-exch SYSTEM "aat-exch.dtd">
%aat-exch;

<!ENTITY % hlType.AttGrp '
	type (major|minor|metadata|effect|move|del|fleetchanged) #REQUIRED'>

<!ENTITY % revision-exch SYSTEM "revision-exch.dtd">
%revision-exch;

<!-- ============================================================= -->
<!-- ELEMENTS                                                      -->
<!-- ============================================================= -->

<!ELEMENT title (#PCDATA)>

<!ELEMENT revisions (mdata-revisions?, content-revisions?)>

<!ELEMENT du-inv-trigger EMPTY>
<!ATTLIST du-inv-trigger
	du-inv-code	CDATA	#REQUIRED
	product CDATA #REQUIRED
>

<!ELEMENT triggered-du-inv (du-inv-trigger+)>
<!ATTLIST triggered-du-inv
	du-inv-code	CDATA	#REQUIRED
>

<!ELEMENT triggered-du-invs (triggered-du-inv+)>

<!ELEMENT productmdata (incremental?, trl-comment?, lom?, aat?, revisions?, triggered-du-invs?, publication-data?)>
<!ATTLIST productmdata
	code	CDATA	#REQUIRED
	revdate	CDATA	#REQUIRED
	prev-revdate CDATA	#IMPLIED
	must-be-approved (true|false) #REQUIRED
	major-event (true|false) #IMPLIED
	doc-usage CDATA #IMPLIED
>

<!ELEMENT publication-data (publication-info+)>

<!ELEMENT publication-info EMPTY>
<!ATTLIST publication-info
	sectname CDATA	#REQUIRED
	path CDATA	#IMPLIED
	revdate CDATA	#REQUIRED
>

<!ELEMENT trl-comment (#PCDATA)>

<!ELEMENT incremental (deleted-files?)>
<!ELEMENT deleted-files (file+)>
<!ELEMENT file (#PCDATA)>
<!ATTLIST file
	type (illustration|extobj) #REQUIRED
>
