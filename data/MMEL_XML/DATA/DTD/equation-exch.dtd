<!-- ============================================================= -->
<!-- ENTITIES                                                      -->
<!-- ============================================================= -->

<!ENTITY % MATHML.prefixed 'INCLUDE'>
<!ENTITY % MATHML.prefix 'm'>
<!ENTITY % mathml-dtd SYSTEM "mathml2.dtd">
%mathml-dtd;

<!ENTITY % equation.content '(m:math,equation-image?)+'>
<!ENTITY % inlineequation.content '(m:math,equation-image?)'>

<!-- ============================================================= -->
<!-- ELEMENTS                                                      -->
<!-- ============================================================= -->

<!ELEMENT equation (%equation.content;)> 

<!ATTLIST equation
	frame (true|false) #IMPLIED
	%do.AttGrp;
	%layer.AttGrp;
	%linktargetid.AttGrp;
	%opStand.AttGrp;	
>

<!ELEMENT inline-equation (%inlineequation.content;)> 
<!ATTLIST inline-equation 
	%linktargetid.AttGrp;
>

<!ELEMENT equation-image (fileref) > 
<!ATTLIST equation-image
	mime-type CDATA #REQUIRED
	height CDATA #REQUIRED
	width CDATA #REQUIRED
>
