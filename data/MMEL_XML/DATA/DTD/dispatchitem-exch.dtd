<!-- The following set of declarations may be referred to  using 
     the public entity as follows:
     <!DOCTYPE dispatchitem PUBLIC
        "-//AIRBUS OPS//DTD DISPATCHITEM_EXCH-VER10.0//EN"   [ ]>   -->
<!-- ============================================================= -->
<!-- ENTITIES                                                      -->
<!-- ============================================================= -->

<!ENTITY % extensionContent.Grp "">
<!ENTITY % ftnoteType "">
<!ENTITY % ops-exch SYSTEM "ops-exch.dtd">
%ops-exch;
<!ENTITY % itemType "%fullBasicStructType;">
<!ELEMENT item (%itemType;)>
<!ATTLIST item
	%layer.AttGrp; 
>
<!ENTITY % sl-exch SYSTEM "sl-exch.dtd">
%sl-exch;

<!ENTITY % descbodyType "((%fullBasicStructType; | desc-cond | ex-desc-cond | whatif)+)">

<!ENTITY % func-code.GlobalAttr "
	func-code	CDATA	#REQUIRED ">

<!ENTITY % entryType '(para|unlist|numlist|warning|caution|note|graphref|launcher|equal|desc-cond|ex-desc-cond|row-header|measure)*'>
<!ENTITY % row.att '%linktargetid.AttGrp;'>

<!-- ============================================================= -->
<!-- ELEMENTS                                                      -->
<!-- ============================================================= -->

<!ELEMENT functional-notes (note+)>
<!ELEMENT ditembody (navigation-acces?, (dispcond+ | no-go))>
<!ATTLIST ditembody
	nb-installed CDATA #REQUIRED
>
<!ELEMENT navigation-acces ((duref | context-link)+)>
<!ATTLIST navigation-acces
	%linktargetid.AttGrp; 
>
<!ELEMENT dispcond (title?, (as-required-by-regulation | dispatch-redirection | normal-dispcond))>
<!ATTLIST dispcond
	dispcond-id CDATA #REQUIRED
	dispcond-label CDATA #REQUIRED
	%do.AttGrp; 
	%linktargetid.AttGrp; 
>
<!ELEMENT as-required-by-regulation (opsproc-ref?, maintenance-ref?, note*)>
<!ATTLIST as-required-by-regulation
	rectification-interval (A | B | C | D | -) #IMPLIED
>
<!ELEMENT dispatch-redirection ((duref, note?)+)>
<!ATTLIST dispatch-redirection
	operator (AND | OR) #IMPLIED
>
<!ELEMENT no-go (para?, note*)>
<!ATTLIST no-go
	%do.AttGrp;
>
<!ELEMENT airlineproc-ref (symbol?, (duref | external-ref | launcher)?)>
<!ATTLIST airlineproc-ref
	caption CDATA #REQUIRED
	emph (yes | no) #IMPLIED
	color (White | Yellow | Green | Cyan | Magenta | Amber | Light-Gray | Medium-Gray | Dark-Gray | Black | Orange | Blue | Red | Violet | Purple | Light-Brown | Brown | Light-Yellow | Light-Green | Light-Red) #IMPLIED
>
<!ELEMENT external-ref (#PCDATA)>
<!ELEMENT normal-dispcond (placard?, airlineproc-ref*, (no-remark | remark))>
<!ATTLIST normal-dispcond
	nb-required CDATA #REQUIRED
	rectification-interval (A | B | C | D | -) #REQUIRED
>

<!ELEMENT no-remark (para?, note?)>
<!ELEMENT requirementblock (requirement, addrequ+)>
<!ELEMENT addrequ (requirement)>
<!ATTLIST addrequ
	%linktargetid.AttGrp; 
>
<!ELEMENT placard (duref?)>
<!ELEMENT maintenance-ref (application-interval?, (taskref+ | duref | external-ref))>
<!ELEMENT taskref EMPTY>
<!ATTLIST taskref
	product CDATA #REQUIRED
	chap-nbr CDATA #IMPLIED
	sect-nbr CDATA #IMPLIED
	subj-nbr CDATA #IMPLIED
	func CDATA #IMPLIED
	seq CDATA #IMPLIED
	dm-ident CDATA #IMPLIED
>
<!ELEMENT application-interval EMPTY>
<!ATTLIST application-interval
	nbr CDATA #IMPLIED
	unit (day | flight | flight-hour | flight-day | hour) #IMPLIED
>

<!ELEMENT condbody (%descbodyType;)>
<!ELEMENT opsproc-ref (duref)>

<!ELEMENT dispatchitem (reason?, title, functional-notes?, note?, ditembody?)>
<!ATTLIST dispatchitem
	%duIdent.AttGrp; 
	%func-code.GlobalAttr; 
	item-list-nbr CDATA #REQUIRED
	%context.AttGrp; 
>
<!ELEMENT remark ((requirement | requirementblock), note*)>
<!ELEMENT requirement (opsproc-ref?, maintenance-ref?, qualifiers?, para, (para | unlist | note)*)>
<!ATTLIST requirement
	req-id CDATA #REQUIRED
	%linktargetid.AttGrp; 
>

<!ELEMENT entry (%entryType;)>