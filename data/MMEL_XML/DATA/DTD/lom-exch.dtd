<!ENTITY % acranges-exch SYSTEM "acranges-exch.dtd">
%acranges-exch;

<!-- ============================================================= -->
<!-- ELEMENTS                                                      -->
<!-- ============================================================= -->

<!ELEMENT lom (lom-item*)>

<!ELEMENT mpm EMPTY>
<!ATTLIST mpm 
      crit-id CDATA #REQUIRED
>

<!ELEMENT lom-item  ((mod|(mp,linked-sb?,linked-mod?)|(mpm,linked-sb?)|sb), title, aircraft-ranges?) >
<!ATTLIST   lom-item
      incorporation-date  CDATA #REQUIRED>

<!ELEMENT mod   EMPTY>
<!ATTLIST mod
    crit-id CDATA #REQUIRED
>

<!ELEMENT mp   EMPTY>
<!ATTLIST mp
      crit-id CDATA #REQUIRED
>

<!ELEMENT sb EMPTY>
<!ATTLIST sb
      crit-id CDATA #REQUIRED
      crit-rev CDATA #REQUIRED
>

<!ELEMENT linked-sb (sb+)>

<!ELEMENT linked-mod (mod+)>