<!-- The following set of declarations may be referred to  using 
     the public entity as follows:
     <!DOCTYPE approbation PUBLIC
        "-//AIRBUS OPS//DTD APPROBATION_EXCH-VER10.0//EN"   [ ]>    -->
        
<!-- ============================================================= -->
<!-- ENTITIES                                                      -->
<!-- ============================================================= -->

<!ENTITY % extensionContent.Grp "">
<!ENTITY % ftnoteType "">
<!ENTITY % ops-exch SYSTEM "ops-exch.dtd">
%ops-exch;
<!ENTITY % entryType '(para|unlist|numlist|measure)*'>

<!ENTITY % descbodyType 'EMPTY'>

<!ENTITY % entryType "">
<!ENTITY % itemType '(para|unlist|numlist)+'>

<!ENTITY % row.att ''>

<!-- ============================================================= -->
<!-- ELEMENTS                                                      -->
<!-- ============================================================= -->

<!ELEMENT entry (%entryType;)>
<!ELEMENT approbation-authority (#PCDATA)>
<!ELEMENT subject %contentAndLinksType;>
<!ELEMENT norm (#PCDATA)>
<!ELEMENT reason-for-issue (para | unlist | numlist)+>
<!ATTLIST reason-for-issue
	%linktargetid.AttGrp; 
>
<!ELEMENT reason-for-revision (para | unlist | numlist)+>
<!ATTLIST reason-for-revision
	%linktargetid.AttGrp; 
>
<!ELEMENT applicable-to (para | unlist | numlist)+>
<!ATTLIST applicable-to
	%linktargetid.AttGrp; 
>
<!ELEMENT information (para+)>
<!ATTLIST information
	%linktargetid.AttGrp; 
>
<!ELEMENT approbation-frame (para+)>
<!ELEMENT ac-set-value (#PCDATA)>
<!ATTLIST ac-set-value
	ac-set-type (TF | MODEL | STANDARD | TA | SERIE) #REQUIRED
>
<!ELEMENT documentation-type (#PCDATA)>
<!ELEMENT env-data (ac-set-value, norm?, documentation-type?)>
<!ATTLIST env-data
	rev-num CDATA #REQUIRED
>
<!ELEMENT manual-title (#PCDATA)>
<!ELEMENT regulatory-directive (para+)>
<!ELEMENT supplier (para+)>
<!ELEMENT ref-ai (#PCDATA)>
<!ELEMENT heading-data ((manual-title, norm, ac-set-value, regulatory-directive, supplier, ref-ai) | heading-image)>
<!ELEMENT bul-cancelled-by (para | unlist | numlist)+>
<!ELEMENT bulletin-data (reason-for-revision?,reason-for-issue, applicable-to?, bul-cancelled-by?)>

<!ELEMENT condbody %descbodyType;>
<!ELEMENT approval-date (#PCDATA)>
<!ELEMENT approval-reference (#PCDATA)>
<!ELEMENT name (#PCDATA)>
<!ELEMENT job-title (#PCDATA)>
<!ELEMENT approval-comment (#PCDATA)>
<!ELEMENT approved-by (name?, job-title?, approval-comment?)>
<!ELEMENT approbation-area (approbation-authority?, approval-date, approval-reference, approved-by?)>
<!ELEMENT cancelled-by (#PCDATA)>
<!ELEMENT tr-data (subject?, norm?, reason-for-revision?, reason-for-issue, applicable-to?, information?, cancelled-by?)>
<!ELEMENT approbation (reason?, title, (tr-data | env-data | heading-data | bulletin-data), approbation-frame?, approbation-area?)>
<!ATTLIST approbation
	code CDATA #REQUIRED
	revdate CDATA #REQUIRED
	%context.AttGrp; 
>
<!ELEMENT heading-image (fileref)>
<!ATTLIST heading-image
	mime-type CDATA #REQUIRED
	insert-date CDATA #IMPLIED
>
<!ELEMENT item (%itemType;)>
