# Copy this file to ".env" in the same folder and fill it in. Never share or commit the real .env file.

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://lea:lea@localhost:5432/lea

# AI is optional. Leave empty and everything except the AI buttons still works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional settings
# AS_OF_DATE=2026-11-20        # pretend "today" is this date (default: the newest record in the data)
# ENGINEERS=Engineer 1,Engineer 2,Engineer 3
# AIRCRAFT_PER_SHIFT=10
# DATA_DIR=./data
